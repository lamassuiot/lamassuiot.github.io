---
import { localeOptions, sharedTranslations } from '../lib/i18n';

interface Props {
  activeNav?: 'home' | 'arch' | 'docs' | '';
}

const { activeNav = '' } = Astro.props;
const t = sharedTranslations.es;
---

<header class="site-shell-header">
  <a href="/" class="site-shell-brand" aria-label={t.header.homeAria} data-i18n-attr-aria-label="header.homeAria">
    <img class="site-shell-logo-full logo-dark" src="/lamassu_full_white.svg" alt="" />
    <img class="site-shell-logo-full logo-light" src="/lamassu_full_blue.svg" alt="" />
  </a>

  <nav class="site-shell-nav" aria-label={t.header.navAria} data-i18n-attr-aria-label="header.navAria">
    <a class={activeNav === 'home' ? 'is-active' : ''} href="/#platform" data-i18n="header.nav.platform">{t.header.nav.platform}</a>
    <a href="/#pqc" data-i18n="header.nav.pqc">{t.header.nav.pqc}</a>
    <a href="/#automation" data-i18n="header.nav.automation">{t.header.nav.automation}</a>
    <a href="/#deployment" data-i18n="header.nav.deployment">{t.header.nav.deployment}</a>
    <a href="/#cases" data-i18n="header.nav.cases">{t.header.nav.cases}</a>
    <a class={activeNav === 'docs' ? 'is-active' : ''} href="/docs/" data-i18n="header.nav.docs">{t.header.nav.docs}</a>
    <a class={activeNav === 'arch' ? 'is-active' : ''} href="/arch/" data-i18n="header.nav.arch">{t.header.nav.arch}</a>
    <a
      class="github-link"
      href="https://github.com/lamassuiot"
      target="_blank"
      rel="noopener"
      aria-label={t.header.githubAria}
      data-i18n-attr-aria-label="header.githubAria"
    >
      <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <path d="M8 0C3.58 0 0 3.67 0 8.2C0 11.82 2.29 14.89 5.47 15.97C5.87 16.05 6.02 15.79 6.02 15.56C6.02 15.35 6.01 14.63 6.01 13.86C4 14.24 3.48 13.36 3.32 12.9C3.23 12.67 2.84 11.95 2.5 11.76C2.22 11.6 1.83 11.2 2.49 11.19C3.11 11.18 3.55 11.78 3.7 12.02C4.41 13.24 5.55 12.9 6.03 12.7C6.1 12.17 6.31 11.81 6.54 11.61C4.76 11.4 2.9 10.7 2.9 7.58C2.9 6.69 3.21 5.97 3.73 5.41C3.65 5.21 3.37 4.39 3.81 3.29C3.81 3.29 4.48 3.07 6.01 4.13C6.65 3.95 7.33 3.86 8.01 3.86C8.69 3.86 9.37 3.95 10.01 4.13C11.54 3.06 12.21 3.29 12.21 3.29C12.65 4.39 12.37 5.21 12.29 5.41C12.81 5.97 13.12 6.68 13.12 7.58C13.12 10.71 11.25 11.4 9.47 11.61C9.76 11.87 10.01 12.37 10.01 13.15C10.01 14.27 10 15.18 10 15.56C10 15.79 10.15 16.06 10.55 15.97C13.72 14.89 16 11.81 16 8.2C16 3.67 12.42 0 8 0Z" />
      </svg>
    </a>
  </nav>

  <div class="site-shell-cta-group">
    <div class="locale-switcher" aria-label={t.header.localeAria} data-i18n-attr-aria-label="header.localeAria">
      {localeOptions.map((locale) => (
        <button
          type="button"
          class:list={['locale-switcher-btn', locale.code === 'es' && 'is-active']}
          data-locale-option={locale.code}
          aria-pressed={locale.code === 'es' ? 'true' : 'false'}
        >
          {locale.label}
        </button>
      ))}
    </div>
    <button
      class="theme-toggle"
      id="theme-toggle"
      aria-label={t.header.themeToggleAria}
      data-i18n-attr-aria-label="header.themeToggleAria"
    >
      <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="4"/>
        <line x1="12" y1="2" x2="12" y2="4"/>
        <line x1="12" y1="20" x2="12" y2="22"/>
        <line x1="2" y1="12" x2="4" y2="12"/>
        <line x1="20" y1="12" x2="22" y2="12"/>
        <line x1="4.93" y1="4.93" x2="6.34" y2="6.34"/>
        <line x1="17.66" y1="17.66" x2="19.07" y2="19.07"/>
        <line x1="4.93" y1="19.07" x2="6.34" y2="17.66"/>
        <line x1="17.66" y1="6.34" x2="19.07" y2="4.93"/>
      </svg>
      <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
      </svg>
    </button>
    <a href="/#contact" class="site-shell-cta site-shell-cta-talk" data-i18n="header.ctaTalk">{t.header.ctaTalk}</a>
    <a href="https://lab.lamassu.io" class="site-shell-cta site-shell-cta-login" data-i18n="header.ctaLogin">{t.header.ctaLogin}</a>

    <button
      class="site-shell-menu-btn"
      id="menu-toggle"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Open navigation"
    >
      <svg class="menu-icon-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
      <svg class="menu-icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>
</header>

<!-- Mobile nav panel — rendered outside header so it can overlay full width -->
<div class="site-shell-mobile-nav" id="mobile-nav" aria-hidden="true">
  <nav class="mobile-nav-links" aria-label={t.header.navAria}>
    <a href="/#platform" data-i18n="header.nav.platform">{t.header.nav.platform}</a>
    <a href="/#pqc" data-i18n="header.nav.pqc">{t.header.nav.pqc}</a>
    <a href="/#automation" data-i18n="header.nav.automation">{t.header.nav.automation}</a>
    <a href="/#deployment" data-i18n="header.nav.deployment">{t.header.nav.deployment}</a>
    <a href="/#cases" data-i18n="header.nav.cases">{t.header.nav.cases}</a>
    <a href="/docs/" data-i18n="header.nav.docs">{t.header.nav.docs}</a>
    <a href="/arch/" data-i18n="header.nav.arch">{t.header.nav.arch}</a>
    <a href="https://github.com/lamassuiot" target="_blank" rel="noopener">GitHub</a>
  </nav>
  <div class="mobile-nav-actions">
    <a href="/#contact" class="site-shell-cta mobile-nav-cta-talk" data-i18n="header.ctaTalk">{t.header.ctaTalk}</a>
    <a href="https://lab.lamassu.io" class="site-shell-cta site-shell-cta-login mobile-nav-cta-login" data-i18n="header.ctaLogin">{t.header.ctaLogin}</a>
  </div>
</div>

<script>
  // Theme toggle
  const themeBtn = document.getElementById('theme-toggle');
  if (themeBtn) {
    themeBtn.addEventListener('click', () => {
      const isLight = document.documentElement.getAttribute('data-theme') === 'light';
      if (isLight) {
        document.documentElement.removeAttribute('data-theme');
        localStorage.setItem('ls-theme', 'dark');
      } else {
        document.documentElement.setAttribute('data-theme', 'light');
        localStorage.setItem('ls-theme', 'light');
      }
    });
  }

  // Mobile nav toggle
  const menuBtn = document.getElementById('menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');

  function openMenu() {
    // The header is sticky on small screens, so anchor the panel to wherever it currently sits.
    const header = document.querySelector('.site-shell-header');
    if (mobileNav && header) {
      mobileNav.style.top = `${Math.round(header.getBoundingClientRect().bottom)}px`;
    }
    mobileNav?.classList.add('is-open');
    menuBtn?.setAttribute('aria-expanded', 'true');
    mobileNav?.removeAttribute('aria-hidden');
    document.body.classList.add('mobile-nav-open');
  }

  function closeMenu() {
    mobileNav?.classList.remove('is-open');
    menuBtn?.setAttribute('aria-expanded', 'false');
    mobileNav?.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('mobile-nav-open');
  }

  menuBtn?.addEventListener('click', () => {
    const isOpen = mobileNav?.classList.contains('is-open');
    isOpen ? closeMenu() : openMenu();
  });

  // Close on nav link click
  mobileNav?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', closeMenu);
  });

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });
</script>
