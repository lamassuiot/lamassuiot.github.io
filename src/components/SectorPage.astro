---
interface KPI {
  label: string;
  value: string;
}

interface Block {
  title: string;
  body: string;
}

interface Props {
  sector: string;
  heroTitle: string;
  heroLead: string;
  heroImageSrc?: string;
  heroImageAlt?: string;
  hideHeroActions?: boolean;
  justifyHeroLead?: boolean;
  heroFullWidthText?: boolean;
  whiteTextOnly?: boolean;
  whiteTitle?: string;
  whiteParagraphs?: string[];
  whiteImageSrc?: string;
  whiteImageAlt?: string;
  kpis: KPI[];
  challenges: string[];
  solutionBlocks: Block[];
  architectureSteps: string[];
  outcomes: string[];
  ctaTitle?: string;
  ctaLead?: string;
}

const {
  sector,
  heroTitle,
  heroLead,
  heroImageSrc,
  heroImageAlt = '',
  hideHeroActions = false,
  justifyHeroLead = false,
  heroFullWidthText = false,
  whiteTextOnly = false,
  whiteTitle = '',
  whiteParagraphs = [],
  whiteImageSrc,
  whiteImageAlt = '',
  kpis,
  challenges,
  solutionBlocks,
  architectureSteps,
  outcomes,
  ctaTitle = 'Diseñamos contigo la arquitectura para este vertical',
  ctaLead = 'Alineamos seguridad, operación y escalabilidad con un roadmap realista de despliegue.',
} = Astro.props;
---

<main class="sector-page">
  <section class:list={['hero-section', heroImageSrc && 'hero-has-image']}>
    <div class="hero-pattern" aria-hidden="true"></div>
    <div class="hero-inner">
      <div class="hero-meta">
        <span class="sector-badge">{sector}</span>
        <a class="crumb-link" href="/#cases">← Casos de uso</a>
      </div>

      <div class:list={['hero-body', heroImageSrc && 'hero-body-split']}>
        <div class="hero-text">
          <h1>{heroTitle}</h1>
          <p class:list={['lead', justifyHeroLead && 'lead-justify']}>{heroLead}</p>

          {
            kpis && kpis.length > 0 && (
              <div class="hero-kpi-row">
                {kpis.map((kpi) => (
                  <div class="hero-kpi">
                    <span class="hkpi-value">{kpi.value}</span>
                    <span class="hkpi-label">{kpi.label}</span>
                  </div>
                ))}
              </div>
            )
          }

          {
            !hideHeroActions && (
              <div class="hero-actions">
                <a class="btn btn-primary" href="/#contact">Solicitar sesión técnica</a>
                <a class="btn btn-ghost" href="/#cases">Volver a casos</a>
              </div>
            )
          }
        </div>

        {
          heroImageSrc && (
            <div class="hero-media">
              <img
                class="hero-image"
                src={heroImageSrc}
                alt={heroImageAlt}
                loading="eager"
                decoding="async"
              />
            </div>
          )
        }
      </div>
    </div>
  </section>

  <section class="content-cut">
    <div class="content-inner">
      {
        whiteTextOnly ? (
          <section class="white-text-only">
            <div class="white-copy">
              {whiteTitle && <h2>{whiteTitle}</h2>}
              {whiteParagraphs.map((paragraph) => <p>{paragraph}</p>)}
            </div>
            {
              whiteImageSrc && (
                <div class="white-media">
                  <img
                    class="white-image"
                    src={whiteImageSrc}
                    alt={whiteImageAlt}
                    loading="eager"
                    decoding="async"
                  />
                </div>
              )
            }
          </section>
        ) : (
          <Fragment>
            <section class="section-grid">
              <article class="section-card">
                <h2>Retos del sector</h2>
                <ul>
                  {challenges.map((item) => <li>{item}</li>)}
                </ul>
              </article>

              <article class="section-card">
                <h2>Solución Lamassu</h2>
                <div class="solution-grid">
                  {
                    solutionBlocks.map((block) => (
                      <div class="solution">
                        <h3>{block.title}</h3>
                        <p>{block.body}</p>
                      </div>
                    ))
                  }
                </div>
              </article>
            </section>

            <section class="section-card blueprint">
              <h2>Blueprint operativo</h2>
              <ol>
                {architectureSteps.map((step) => <li>{step}</li>)}
              </ol>
            </section>

            <section class="section-card impact">
              <h2>Impacto esperado</h2>
              <div class="impact-grid">
                {outcomes.map((item) => <p>{item}</p>)}
              </div>
            </section>

            <section class="cta">
              <div>
                <h2>{ctaTitle}</h2>
                <p>{ctaLead}</p>
              </div>
              <a class="btn btn-primary" href="/#contact">Hablar con especialistas</a>
            </section>
          </Fragment>
        )
      }
    </div>
  </section>
</main>

<style>
  /* ─── Theme tokens (dark = default, light = opt-in) ── */
  .sector-page {
    width: 100%;

    /* dark mode defaults */
    --sp-cut-bg:      #0a1525;
    --sp-diag-bg:     #0a1525;   /* diagonal triangle matches cut-bg */
    --sp-card-bg:     #0e1c34;
    --sp-card-alt:    #0b1829;
    --sp-card-border: rgba(50, 76, 136, 0.45);
    --sp-inner-border:rgba(42, 64, 116, 0.38);
    --sp-h2:          #d4e3ff;
    --sp-h3:          #b8ceee;
    --sp-body:        #7a98c4;
    --sp-li:          #8aa4cc;
    --sp-muted:       #4a6080;
    --sp-wh2:         #d4e3ff;
    --sp-wp:          #7a98c4;
  }

  [data-theme='light'] .sector-page {
    --sp-cut-bg:      #eef2fa;   /* tray: light blue-gray so white cards pop */
    --sp-diag-bg:     #eef2fa;
    --sp-card-bg:     #ffffff;
    --sp-card-alt:    #f4f7fd;
    --sp-card-border: #d7e1f4;
    --sp-inner-border:#dce6f5;
    --sp-h2:          #12203d;
    --sp-h3:          #1a2e52;
    --sp-body:        #2b3e63;
    --sp-li:          #24314f;
    --sp-muted:       #3a4869;
    --sp-wh2:         #12203d;
    --sp-wp:          #2b3e63;
  }

  /* ─── Hero ──────────────────────────────────────── */
  .hero-section {
    position: relative;
    background:
      radial-gradient(ellipse 70% 55% at 95% 0%, rgba(47, 232, 255, 0.09) 0%, transparent 65%),
      radial-gradient(ellipse 50% 40% at 5% 100%, rgba(47, 116, 255, 0.07) 0%, transparent 60%),
      linear-gradient(160deg, #06162c 0%, #0b1d40 52%, #07152e 100%);
    margin-top: 28px;
    padding: 64px 0 80px;
    overflow: hidden;
  }

  /* Dot-grid texture */
  .hero-pattern {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, rgba(255, 255, 255, 0.038) 1px, transparent 1px);
    background-size: 30px 30px;
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    width: min(1240px, calc(100% - 48px));
    margin: 0 auto;
  }

  /* Sector badge + breadcrumb row */
  .hero-meta {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-bottom: 26px;
  }

  .sector-badge {
    font-family: "IBM Plex Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    font-weight: 700;
    color: #06172f;
    background: #2fe8ff;
    padding: 5px 14px;
    border-radius: 999px;
    white-space: nowrap;
  }

  .crumb-link {
    font-size: 13px;
    color: rgba(169, 183, 221, 0.55);
    text-decoration: none;
    letter-spacing: 0.01em;
    transition: color 0.15s;
  }

  .crumb-link:hover {
    color: #a9b7dd;
  }

  /* Hero body: full-width or split */
  .hero-body {
    display: flex;
    flex-direction: column;
  }

  .hero-body-split {
    display: grid;
    grid-template-columns: minmax(0, 60%) minmax(0, 40%);
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
  }

  .hero-text {
    max-width: 880px;
  }

  h1 {
    color: #eef5ff;
    font-size: clamp(30px, 4.8vw, 60px);
    line-height: 1.04;
    letter-spacing: -0.03em;
    margin: 0;
  }

  .lead {
    margin-top: 18px;
    color: #8fa8d3;
    font-size: clamp(15px, 1.3vw, 18px);
    line-height: 1.6;
    max-width: 72ch;
  }

  .lead-justify {
    text-align: justify;
  }

  /* KPI chips inside the hero */
  .hero-kpi-row {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .hero-kpi {
    display: flex;
    flex-direction: column;
    gap: 4px;
    border: 1px solid rgba(72, 94, 164, 0.45);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.04);
    padding: 12px 18px;
    min-width: 120px;
  }

  .hkpi-value {
    color: #2fe8ff;
    font-size: clamp(18px, 2vw, 24px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .hkpi-label {
    font-family: "IBM Plex Mono", monospace;
    font-size: 10px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: #576080;
    margin-top: 2px;
  }

  /* Hero action buttons */
  .hero-actions {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  /* Hero image (split layout) */
  .hero-media {
    width: 100%;
    display: flex;
    justify-content: flex-end;
  }

  .hero-image {
    width: 100%;
    height: clamp(260px, 30vw, 440px);
    border-radius: 16px;
    border: 1px solid rgba(143, 175, 232, 0.22);
    object-fit: cover;
    object-position: center;
    box-shadow: 0 28px 52px rgba(4, 12, 32, 0.56);
  }

  /* ─── Buttons ───────────────────────────────────── */
  .btn {
    text-decoration: none;
    border-radius: 999px;
    padding: 12px 20px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.01em;
    transition: 0.2s ease;
    display: inline-block;
  }

  .btn-primary {
    background: #2fe8ff;
    color: #06172f;
    box-shadow: 0 14px 40px rgba(47, 232, 255, 0.22);
  }

  .btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 18px 44px rgba(47, 232, 255, 0.32);
  }

  .btn-ghost {
    border: 1px solid #344988;
    color: #cfd8ff;
    background: rgba(255, 255, 255, 0.02);
  }

  .btn-ghost:hover {
    border-color: #4f77a7;
    color: #f7fbff;
    transform: translateY(-1px);
  }

  /* ─── Diagonal transition ───────────────────────── */
  /*
   * A triangle overlaps the hero's bottom using --sp-diag-bg,
   * creating a diagonal divider. In light mode this is white
   * cutting into the dark hero. In dark mode both are dark so
   * the transition is seamless.
   */
  .content-cut {
    background: var(--sp-cut-bg);
    padding: 40px 0 60px;
    position: relative;
  }

  .content-cut::before {
    content: '';
    position: absolute;
    top: -64px;
    left: 0;
    right: 0;
    height: 64px;
    background: var(--sp-diag-bg);
    clip-path: polygon(100% 0, 0 100%, 100% 100%);
    pointer-events: none;
  }

  /* ─── White content area ────────────────────────── */
  .content-inner {
    width: min(1240px, calc(100% - 48px));
    margin: 0 auto;
    display: grid;
    gap: 16px;
  }

  /* White-text-only variant (e.g. ferroviario) */
  .white-text-only {
    display: grid;
    grid-template-columns: minmax(0, 60%) minmax(0, 40%);
    gap: clamp(20px, 3vw, 48px);
    align-items: center;
  }

  .white-copy h2 {
    color: var(--sp-wh2);
    font-size: clamp(26px, 3.6vw, 42px);
    letter-spacing: -0.02em;
  }

  .white-copy p {
    margin-top: 14px;
    color: var(--sp-wp);
    font-size: clamp(16px, 1.4vw, 20px);
    line-height: 1.68;
    max-width: 74ch;
    text-align: justify;
  }

  .white-media {
    width: 100%;
    display: flex;
    justify-content: flex-end;
    align-items: center;
  }

  .white-image {
    width: 100%;
    height: clamp(360px, 36vw, 560px);
    border-radius: 24px;
    border: 1px solid var(--sp-card-border);
    object-fit: cover;
    object-position: 70% center;
    box-shadow: 0 20px 36px rgba(18, 32, 61, 0.16);
  }

  /* ─── Section cards ─────────────────────────────── */
  .section-card,
  .cta {
    border: 1px solid var(--sp-card-border);
    border-radius: 18px;
    background: var(--sp-card-bg);
  }

  .section-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .section-card {
    padding: 24px;
  }

  h2 {
    color: var(--sp-h2);
    font-size: clamp(22px, 3vw, 34px);
    letter-spacing: -0.02em;
    margin: 0;
  }

  h3 {
    color: var(--sp-h3);
    font-size: 18px;
    letter-spacing: -0.02em;
    margin: 0;
  }

  ul,
  ol {
    display: grid;
    gap: 10px;
  }

  li {
    color: var(--sp-li);
    line-height: 1.56;
    font-size: 16px;
  }

  .section-card > ul,
  .section-card > ol {
    margin-top: 14px;
    padding: 14px 14px 14px 34px;
    border-radius: 12px;
    border: 1px solid var(--sp-inner-border);
    background: var(--sp-card-alt);
  }

  .solution-grid {
    margin-top: 14px;
    padding: 10px;
    border-radius: 12px;
    border: 1px solid var(--sp-inner-border);
    background: var(--sp-card-alt);
    display: grid;
    gap: 10px;
  }

  .solution {
    border: 1px solid var(--sp-card-border);
    border-radius: 12px;
    background: var(--sp-card-bg);
    padding: 14px;
  }

  .solution p {
    margin-top: 8px;
    color: var(--sp-body);
    line-height: 1.56;
    font-size: 15px;
  }

  .impact-grid {
    margin-top: 14px;
    padding: 10px;
    border-radius: 12px;
    border: 1px solid var(--sp-inner-border);
    background: var(--sp-card-alt);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .impact-grid p {
    border: 1px solid var(--sp-card-border);
    border-radius: 12px;
    background: var(--sp-card-bg);
    padding: 12px;
    color: var(--sp-li);
    line-height: 1.5;
    font-size: 15px;
    margin: 0;
  }

  .cta {
    padding: 28px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .cta h2 {
    font-size: clamp(20px, 2.5vw, 30px);
  }

  .cta p {
    margin-top: 8px;
    color: var(--sp-body);
    font-size: 16px;
    line-height: 1.5;
    max-width: 760px;
  }

  /* ─── Responsive ─────────────────────────────────── */
  @media (max-width: 980px) {
    .hero-body-split {
      grid-template-columns: 1fr;
    }

    .hero-image {
      max-width: 680px;
      height: clamp(220px, 50vw, 360px);
    }

    .white-text-only {
      grid-template-columns: 1fr;
    }

    .white-image {
      max-width: 680px;
      height: clamp(220px, 54vw, 360px);
    }

    .section-grid,
    .impact-grid {
      grid-template-columns: 1fr;
    }

    .hero-kpi-row {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .hero-section {
      padding: 48px 0 64px;
    }

    .hero-inner,
    .content-inner {
      width: calc(100% - 24px);
    }

    h1 {
      font-size: clamp(26px, 8vw, 36px);
    }

    .hero-kpi-row {
      grid-template-columns: repeat(2, 1fr);
    }

    .hero-kpi {
      min-width: unset;
    }

    .content-cut {
      padding: 28px 0 40px;
    }

    .content-cut::before {
      top: -48px;
      height: 48px;
      background: var(--sp-diag-bg);
    }

    .section-card,
    .cta {
      padding: 18px;
    }

    .btn {
      width: 100%;
      text-align: center;
    }
  }
</style>
