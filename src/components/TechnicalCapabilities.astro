---
import type { landingTranslations } from '../lib/landing-content';
import '../styles/technical-capabilities.css';

interface Props { home: typeof landingTranslations.es.home }
const { home } = Astro.props;
const ui = home.technical;
const products = [
  { id: 'pki', key: 'pki', data: home.pki, doc: home.docs.pki, docKey: 'pki' },
  { id: 'automation', key: 'devices', data: home.devices, doc: home.docs.enrollment, docKey: 'enrollment' },
  { id: 'keys', key: 'keys', data: home.keys, doc: home.docs.keys, docKey: 'keys' },
];
// Sample console data, never live telemetry. The CA table recreates the real console's
// /certificate-authorities view (lab.lamassu.io), so its labels stay in the product's own language.
const authorities = [
  { name: 'Lamassu Root CA', status: 'active', type: 'Managed', engine: 'go1.27.3', subs: 2, depth: 0, key: 'RSA (4096 bit)', expires: '07/11/2036 17:14', relative: 'in almost 10 years' },
  { name: 'Factory Issuing CA', status: 'active', type: 'Managed', engine: 'go1.27.3', subs: 1, depth: 1, key: 'ECDSA (384 bit)', expires: '09/11/2031 17:14', relative: 'in almost 5 years', span: '5 years before parent' },
  { name: 'Line 3 Devices CA', status: 'active', type: 'Managed', engine: 'go1.27.3', subs: 0, depth: 2, key: 'ECDSA (256 bit)', expires: '09/11/2028 17:14', relative: 'in almost 2 years', span: '3 years before parent' },
  { name: 'Pilot Line CA', status: 'expired', type: 'Managed', engine: 'go1.27.3', subs: 0, depth: 1, key: 'ECDSA (256 bit)', expires: '02/09/2026 09:30', relative: '2 months ago', span: '10 years before parent' },
  { name: 'Legacy OT CA', status: 'revoked', type: 'Imported', engine: 'Imported', subs: 0, depth: 0, key: 'RSA (2048 bit)', expires: '14/05/2030 12:00', relative: 'in almost 4 years' },
] as const;
const subject = (name: string) => `CN=${name}, OU=Factory Floor, O=LamassuIoT, L=Arrasate, ST=Gipuzkoa, C=ES`;
const events = [
  { time: '10:42:07', operation: '/simpleenroll', device: 'plc-line3-0042', status: 'issued' },
  { time: '10:41:55', operation: '/simplereenroll', device: 'gw-north-17', status: 'renewed' },
  { time: '10:40:12', operation: '/cacerts', device: 'hmi-panel-08', status: 'served' },
  { time: '10:38:40', operation: 'revoke', device: 'lock-b2-883', status: 'revoked' },
  { time: '10:37:02', operation: '/simpleenroll', device: 'bms-rack-12', status: 'issued' },
  { time: '10:35:19', operation: '/serverkeygen', device: 'meter-ft-2207', status: 'issued' },
] as const;
const engines = [
  { name: 'PKCS#11 HSM', id: 'pkcs11-hsm-01', connection: 'PKCS#11', custody: 'hardware' },
  { name: 'AWS KMS', id: 'aws-kms-eu-west-1', connection: 'AWS API', custody: 'cloud' },
  { name: 'Azure Key Vault Keys', id: 'azure-kv-prod', connection: 'Azure API', custody: 'cloud' },
  { name: 'HashiCorp Vault', id: 'vault-kv-plant', connection: 'KV v2', custody: 'software' },
  { name: 'File system', id: 'fs-dev', connection: 'local', custody: 'software' },
] as const;
const icons = [
  ['M12 3v6M5 15v-4h14v4M12 11v4M9 3h6v5H9zM2 16h6v5H2zM9 16h6v5H9zM16 16h6v5h-6z', 'M14 3H5v18h14V8zM14 3v6h5M8 13h8M8 17h6', 'M12 3l8 3v6c0 4-3 7-8 9-5-2-8-5-8-9V6z'],
  ['M14 4h6v16h-6M3 12h12M10 7l5 5-5 5', 'M20 7a9 9 0 1 0 1 7M20 3v5h-5', 'M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z'],
  ['M7 7h10v10H7zM9 3v4M15 3v4M9 17v4M15 17v4M3 9h4M3 15h4M17 9h4M17 15h4', 'M4 4h16v16H4zM4 9h16M8 6h1M12 13v4M10 15h4', 'M12 3v12M7 10l5 5 5-5M4 16v5h16v-5'],
];
---

<nav class="lp-tech-nav" aria-label={ui.navigation} data-i18n-attr-aria-label="home.technical.navigation">
  {products.map((product, i) => <a href={`#${product.id}`} data-i18n={`home.redesign.productTabs.${i}`}>{home.redesign.productTabs[i]}</a>)}
</nav>

{products.map((product, index) => (
  <section class:list={['lp-technical', index === 0 && 'lp-technical--wide']} id={product.id} aria-labelledby={`${product.id}-title`}>
    <header class="lp-technical-heading" data-reveal>
      <div>
        <h3 id={`${product.id}-title`} data-i18n={`home.${product.key}.title`}>{product.data.title}</h3>
        <p data-i18n={`home.${product.key}.lead`}>{product.data.lead}</p>
        {index === 1 && <ul class="lp-tech-protocols">{home.devices.protocols.map((protocol, i) => <li data-i18n={`home.devices.protocols.${i}`}>{protocol}</li>)}</ul>}
      </div>
      <a class="lp-btn lp-btn--primary" href={product.doc} data-i18n-attr-href={`home.docs.${product.docKey}`} data-i18n={`home.${product.key}.cta`}>{product.data.cta}</a>
    </header>

    <div class="lp-technical-body" data-reveal>
      <ul class="lp-tech-features">
        {product.data.features.map((feature, i) => (
          <li>
            <svg class="lp-icon" viewBox="0 0 24 24" aria-hidden="true"><path d={icons[index][i]} /></svg>
            <div>
              <h4 data-i18n={`home.${product.key}.features.${i}.tag`}>{feature.tag}</h4>
              <p data-i18n={`home.${product.key}.features.${i}.body`}>{feature.body}</p>
              {'href' in feature && <a class="lp-link" href={feature.href} data-i18n-attr-href={`home.${product.key}.features.${i}.href`} data-i18n={`home.${product.key}.features.${i}.link`}>{feature.link}</a>}
            </div>
          </li>
        ))}
      </ul>

      <figure class="lp-console-example" data-ui>
        <div class="lp-console-head">
          <div>
            <p class="lp-console-title" data-i18n={`home.technical.${['authorities', 'events', 'engines'][index]}`}>{[ui.authorities, ui.events, ui.engines][index]}</p>
            {index !== 0 && <p class="lp-console-subtitle" {...(index === 2 ? { 'data-i18n': 'home.technical.connectedEngines' } : {})}>{index === 1 ? 'DMS · factory-line-3 · /.well-known/est' : ui.connectedEngines}</p>}
          </div>
          <a class="lp-console-open" href={index === 0 ? 'https://lab.lamassu.io/certificate-authorities' : 'https://lab.lamassu.io'} target="_blank" rel="noopener"><span data-i18n="home.technical.openConsole">{ui.openConsole}</span><span aria-hidden="true">↗</span></a>
        </div>

        {index !== 0 && <span class="lp-console-scroll-hint" id={`${product.id}-scroll-hint`} data-i18n="home.technical.scrollTable">{ui.scrollTable}</span>}
        <div class={index === 0 ? undefined : 'lp-console-scroll'} {...(index === 0 ? {} : { tabindex: 0, role: 'region', 'aria-labelledby': `${product.id}-title`, 'aria-describedby': `${product.id}-scroll-hint` })}>
          {index === 0 && <table class="lp-console-table lp-ca-table">
            <thead><tr>
              <th scope="col">Certification Authority <svg class="lp-ca-sort lp-ca-sort--active" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 13V3M2.5 5.5 5 3l2.5 2.5M11 3v10M8.5 10.5 11 13l2.5-2.5" /></svg></th>
              <th scope="col">Status</th><th scope="col" class="lp-ca-c-origin">Origin</th><th scope="col">Key</th>
              <th scope="col">Expires <svg class="lp-ca-sort" viewBox="0 0 16 16" aria-hidden="true"><path d="m5 6.5 3-3 3 3M5 9.5l3 3 3-3" /></svg></th>
              <th scope="col" class="lp-ca-c-span">Expires vs. parent</th>
            </tr></thead>
            <tbody>{authorities.map(ca => <tr data-ca-depth={ca.depth}>
              <th scope="row"><div class="lp-ca-name" style={`padding-left:${ca.depth * 16}px`}>
                {ca.subs > 0 ? <button class="lp-ca-toggle" type="button" data-ca-toggle hidden aria-expanded="true" aria-label={`${ca.name}: ${ui.toggleHierarchy}`}><svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4" /></svg></button> : ca.depth > 0 ? <span class="lp-ca-branch" aria-hidden="true">↳</span> : <span class="lp-ca-branch-space" aria-hidden="true"></span>}
                <span class="lp-ca-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><circle cx="12" cy="12" r="1.6" /><path d="M13.4 13.4 16 16M15 15l1.2-1.2" /></svg></span>
                <div>
                  <div class="lp-ca-title"><span>{ca.name}</span>{ca.subs > 0 && <span class="lp-ca-count">{ca.subs} sub-{ca.subs === 1 ? 'CA' : 'CAs'}</span>}</div>
                  <div class="lp-ca-subject" title={subject(ca.name)}>{subject(ca.name)}</div>
                </div>
              </div></th>
              <td><span class={`lp-console-status lp-console-status--${ca.status}`}>{ca.status.toUpperCase()}</span></td>
              <td class="lp-ca-c-origin"><span class="lp-ca-type">{ca.type === 'Managed' ? <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 4.5h10M6 4.5V3h4v1.5M4.5 4.5l.6 8.5h5.8l.6-8.5M7 7v3.5M9 7v3.5" /></svg> : <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2.5v7M5.2 6.8 8 9.6l2.8-2.8M3 10.5v2h10v-2" /></svg>}{ca.type}</span></td>
              <td class="lp-ca-c-key"><div class="lp-ca-strong">{ca.key}</div><div class="lp-ca-sub">{ca.engine}</div></td>
              <td><div class="lp-ca-strong">{ca.expires}</div><div class="lp-ca-sub">{ca.relative}</div></td>
              <td class="lp-ca-c-span">{'span' in ca ? <div class="lp-ca-span"><div class="lp-ca-span-tags"><span class="lp-ca-tag lp-ca-tag--this">this CA</span><span class="lp-ca-tag">parent CA</span></div><div class="lp-ca-bar" aria-hidden="true"></div><div class="lp-ca-sub">{ca.span}</div></div> : <span class="lp-ca-sub">Self-signed · Root</span>}</td>
            </tr>)}</tbody>
          </table>}

          {index === 1 && <table class="lp-console-table lp-events-table">
            <thead><tr>{['time', 'operation', 'device', 'status'].map(key => <th scope="col" data-i18n={`home.technical.${key}`}>{ui[key as keyof typeof ui]}</th>)}</tr></thead>
            <tbody>{events.map(event => <tr><td>{event.time}</td><td><code>{event.operation}</code></td><th scope="row">{event.device}</th><td><span class={`lp-console-status lp-console-status--${event.status}`} data-i18n={`home.technical.${event.status}`}>{ui[event.status]}</span></td></tr>)}</tbody>
          </table>}

          {index === 2 && <table class="lp-console-table lp-engines-table">
            <thead><tr>{['engine', 'connection', 'custody'].map(key => <th scope="col" data-i18n={`home.technical.${key}`}>{ui[key as keyof typeof ui]}</th>)}</tr></thead>
            <tbody>{engines.map(engine => <tr><th scope="row">{engine.name}<span class="lp-engine-identifier">{engine.id}</span></th><td {...(engine.connection === 'local' ? { 'data-i18n': 'home.technical.local' } : {})}>{engine.connection === 'local' ? ui.local : engine.connection}</td><td data-i18n={`home.technical.${engine.custody}`}>{ui[engine.custody]}</td></tr>)}</tbody>
          </table>}
        </div>
        {index !== 0 && <figcaption data-i18n="home.technical.example">{ui.example}</figcaption>}
      </figure>
    </div>
  </section>
))}

<script>
  // Each parent CA collapses its descendants; a row is visible only while every ancestor is expanded.
  const rows = [...document.querySelectorAll<HTMLTableRowElement>('.lp-ca-table tbody tr')];
  const sync = () => {
    const open: boolean[] = [];
    rows.forEach(row => {
      const depth = Number(row.dataset.caDepth);
      row.hidden = !open.slice(0, depth).every(Boolean);
      const toggle = row.querySelector<HTMLButtonElement>('[data-ca-toggle]');
      open[depth] = toggle ? toggle.getAttribute('aria-expanded') === 'true' : true;
    });
  };
  rows.forEach(row => {
    const toggle = row.querySelector<HTMLButtonElement>('[data-ca-toggle]');
    if (!toggle) return;
    toggle.hidden = false;
    toggle.addEventListener('click', () => {
      toggle.setAttribute('aria-expanded', String(toggle.getAttribute('aria-expanded') !== 'true'));
      sync();
    });
  });
</script>
