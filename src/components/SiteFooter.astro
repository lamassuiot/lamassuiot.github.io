---
import { sharedTranslations } from '../lib/i18n';

const footer = sharedTranslations.es.footer;
---

<footer class="site-footer" aria-label={footer.aria} data-i18n-attr-aria-label="footer.aria">
  <div class="site-footer-inner">
    <div class="site-footer-main">
      <div class="site-footer-brand">
        <a href="/" class="site-footer-logo" aria-label={sharedTranslations.es.header.homeAria} data-i18n-attr-aria-label="header.homeAria">
          <img src="/lamassu_full_white.svg" width="216" height="44" alt="Lamassu IoT" loading="lazy" />
        </a>
        <p class="site-footer-tagline" data-i18n="footer.tagline">{footer.tagline}</p>
        <p class="site-footer-principle" data-i18n="footer.principle">{footer.principle}</p>
      </div>

      <nav class="site-footer-nav" aria-label={footer.navigationAria} data-i18n-attr-aria-label="footer.navigationAria">
        {footer.navigation.map((group, groupIndex) => (
          <section class="site-footer-group" aria-labelledby={`footer-group-${groupIndex}`}>
            <h2 id={`footer-group-${groupIndex}`} data-i18n={`footer.navigation.${groupIndex}.title`}>{group.title}</h2>
            <ul>
              {group.links.map((link, linkIndex) => (
                <li>
                  <a
                    href={link.href}
                    data-i18n-attr-href={`footer.navigation.${groupIndex}.links.${linkIndex}.href`}
                    data-i18n={`footer.navigation.${groupIndex}.links.${linkIndex}.label`}
                  >{link.label}</a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </nav>
    </div>

    <div class="site-footer-bottom">
      <p data-i18n="footer.copyright">{footer.copyright}</p>
      <a class="site-footer-top" href="#page-top">
        <span data-i18n="footer.backToTop">{footer.backToTop}</span>
        <span aria-hidden="true">↑</span>
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 56px;
    background: #060914;
    color: #a4adbe;
  }

  .site-footer *,
  .site-footer *::before,
  .site-footer *::after {
    box-sizing: border-box;
  }

  .site-footer-inner {
    width: min(1280px, calc(100% - 64px));
    margin-inline: auto;
    padding-top: 72px;
  }

  .site-footer-main {
    display: grid;
    grid-template-columns: minmax(220px, 1.25fr) minmax(0, 4fr);
    gap: 64px;
    align-items: start;
  }

  .site-footer-logo {
    display: inline-block;
    width: fit-content;
  }

  .site-footer-logo img {
    display: block;
    width: 216px;
    height: 44px;
    max-width: 100%;
    object-fit: contain;
    object-position: left center;
  }

  .site-footer-tagline {
    max-width: 26ch;
    margin: 24px 0 0;
    color: #e2e6ef;
    font-size: 18px;
    font-weight: 400;
    line-height: 1.55;
    text-wrap: pretty;
  }

  .site-footer-principle {
    max-width: 28ch;
    margin: 18px 0 0;
    font-size: 13px;
    line-height: 1.6;
  }

  .site-footer-nav {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 28px;
  }

  .site-footer-group h2 {
    margin: 5px 0 22px;
    color: #e2e6ef;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.5;
  }

  .site-footer-group ul {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer-group a {
    display: inline-block;
    max-width: 100%;
    color: inherit;
    font-size: 14px;
    line-height: 1.6;
    text-decoration: none;
    text-underline-offset: 4px;
    overflow-wrap: anywhere;
    transition: color 150ms ease;
  }

  .site-footer-group a:hover,
  .site-footer-top:hover {
    color: #ffffff;
    text-decoration: underline;
  }

  .site-footer a:focus-visible {
    outline: 2px solid #7e9cff;
    outline-offset: 6px;
    border-radius: 2px;
    color: #ffffff;
  }

  .site-footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 64px;
    padding-block: 26px;
    border-top: 1px solid #223250;
    font-size: 13px;
    line-height: 1.5;
  }

  .site-footer-bottom p {
    margin: 0;
  }

  .site-footer-top {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    min-height: 32px;
    color: inherit;
    text-decoration: none;
    text-underline-offset: 4px;
  }

  .site-footer-top > span:last-child {
    color: #e2e6ef;
    font-size: 20px;
  }

  @media (max-width: 1100px) {
    .site-footer-main {
      grid-template-columns: minmax(0, 1fr);
      gap: 44px;
    }

    .site-footer-brand {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 12px 48px;
      align-items: center;
    }

    .site-footer-tagline {
      grid-column: 2;
      grid-row: 1 / span 2;
      margin: 0;
      max-width: 32ch;
    }

    .site-footer-principle {
      margin: 0;
      max-width: none;
    }
  }

  @media (max-width: 700px) {
    .site-footer-inner {
      width: calc(100% - 48px);
      padding-top: 48px;
    }

    .site-footer-brand {
      display: block;
    }

    .site-footer-logo img {
      width: 200px;
      height: 40px;
    }

    .site-footer-tagline {
      margin-top: 20px;
      max-width: 28ch;
    }

    .site-footer-principle {
      margin-top: 12px;
    }

    .site-footer-nav {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 36px 24px;
    }

    .site-footer-group h2 {
      margin: 0 0 16px;
      font-size: 15px;
    }

    .site-footer-group ul {
      gap: 8px;
    }

    .site-footer-group a {
      padding-block: 4px;
    }

    .site-footer-bottom {
      align-items: start;
      gap: 18px;
      margin-top: 44px;
      padding-block: 24px;
      font-size: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-footer-group a {
      transition: none;
    }
  }
</style>
