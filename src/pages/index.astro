  </main>

  <script is:inline>
    (function () {
      var root = document.documentElement;
      if (!root.classList.contains('lp-motion')) return;
      var targets = document.querySelectorAll('[data-reveal]');
      if (!('IntersectionObserver' in window)) {
        targets.forEach(function (element) { element.classList.add('is-visible'); });
        return;
      }
      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
      targets.forEach(function (element) {
        observer.observe(element);
      });
    })();
  </script>
  <script is:inline>
    (function () {
      document.querySelectorAll('.lp-scroll').forEach(function (scroller) {
        var items = scroller.children;
        if (items.length < 2) return;
        var dots = document.createElement('div');
        dots.className = 'lp-dots';
        dots.setAttribute('aria-hidden', 'true');
        for (var i = 0; i < items.length; i++) dots.appendChild(document.createElement('span'));
        scroller.insertAdjacentElement('afterend', dots);

        function update() {
          var step = items[1].offsetLeft - items[0].offsetLeft || 1;
          var atEnd = scroller.scrollLeft + scroller.clientWidth >= scroller.scrollWidth - 4;
          var index = atEnd ? items.length - 1 : Math.round(scroller.scrollLeft / step);
          Array.prototype.forEach.call(dots.children, function (dot, dotIndex) {
            dot.classList.toggle('is-active', dotIndex === index);
          });
        }

        scroller.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update);
        update();
      });
    })();
  </script>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)}></script>
