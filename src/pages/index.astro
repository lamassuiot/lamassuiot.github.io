---
import SiteLayout from '../layouts/SiteLayout.astro';
import { homeTranslations } from '../lib/i18n';
import '../styles/landing-tokens.css';
import '../styles/landing.css';

const home = homeTranslations.es.home;

// erreka.png is currently a copy of the CAF logo — add Erreka back once the real file is in place.
const customerLogos = [
  { name: 'CAF', src: '/company/caf.png' },
  { name: 'Cegasa', src: '/company/cegasa.svg' },
  { name: 'GH Cranes & Components', src: '/company/gh.png' },
  { name: 'Fagor Professional', src: '/company/fagor_professional.svg' },
];

const referenceLinks = [
  '/ferroviario/',
  '/hosteleria-conectada/',
  '/energia-baterias/',
  '/gruas/',
  '/puertas-de-acceso-conectadas/',
];

// Stroke icons (24×24, drawn with currentColor).
const icons = {
  ca: '<path d="M12 3l8 3v6c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V6l8-3z"/><path d="M9 12l2 2 4-4"/>',
  key: '<circle cx="8" cy="15" r="4"/><path d="M10.8 12.2L20 3M17 6l3 3M14.5 8.5l2 2"/>',
  profile: '<path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6M8 13h8M8 17h5"/>',
  device: '<rect x="7" y="7" width="10" height="10" rx="1.5"/><path d="M10 3v4M14 3v4M10 17v4M14 17v4M3 10h4M3 14h4M17 10h4M17 14h4"/>',
  revoke: '<circle cx="12" cy="12" r="9"/><path d="M5.6 5.6l12.8 12.8"/>',
  tree: '<rect x="9" y="3" width="6" height="5" rx="1"/><rect x="3" y="16" width="6" height="5" rx="1"/><rect x="15" y="16" width="6" height="5" rx="1"/><path d="M12 8v4M6 16v-4h12v4"/>',
  enrol: '<path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M15 12H3"/>',
  renew: '<path d="M21 12a9 9 0 1 1-2.6-6.4"/><path d="M21 4v5h-5"/>',
  grid: '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>',
  chip: '<rect x="5" y="5" width="14" height="14" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M9 2v3M15 2v3M9 19v3M15 19v3M2 9h3M2 15h3M19 9h3M19 15h3"/>',
  cloud: '<path d="M17.5 19H8a5 5 0 1 1 .9-9.9A6 6 0 0 1 20 11.5 3.8 3.8 0 0 1 17.5 19z"/>',
  vault: '<rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="12" cy="12" r="3.5"/><path d="M12 8.5V7M15.5 12H17M12 15.5V17M8.5 12H7"/>',
  import: '<path d="M12 3v12M7 10l5 5 5-5"/><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/>',
  file: '<path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6"/>',
  lock: '<rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>',
  code: '<path d="M8 6l-6 6 6 6M16 6l6 6-6 6M14 4l-4 16"/>',
  users: '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><path d="M16 4.5a3.5 3.5 0 0 1 0 7M18 14.5a6.5 6.5 0 0 1 3.5 5.5"/>',
  link: '<path d="M10 14a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1"/><path d="M14 10a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"/>',
  console: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M7 13l2 2-2 2M12 17h4"/>',
};
const platformIcons = ['ca', 'device', 'key'];
const pkiIcons = ['tree', 'profile', 'revoke'];
const devicesIcons = ['enrol', 'renew', 'grid'];
const keysIcons = ['chip', 'vault', 'import'];
const toastIcons = ['enrol', 'revoke'];

// Product mocks. They imitate the console, whose UI is in English.
const caRows = [
  { tree: '', name: 'Lamassu Root CA', algo: 'RSA 4096', engine: 'PKCS#11 HSM', status: ['ok', 'Active'] },
  { tree: '└─', name: 'Factory Issuing CA', algo: 'ECDSA P-384', engine: 'AWS KMS', status: ['ok', 'Active'] },
  { tree: '   └─', name: 'Line 3 Devices CA', algo: 'ECDSA P-256', engine: 'AWS KMS', status: ['ok', 'Active'] },
  { tree: '└─', name: 'Field Gateways CA', algo: 'ECDSA P-256', engine: 'Azure Key Vault', status: ['warn', 'Expiring'] },
  { tree: '', name: 'Legacy OT CA', algo: 'RSA 2048', engine: 'Imported', status: ['bad', 'Revoked'] },
];
const deviceEvents = [
  { time: '10:42:07', op: '/simpleenroll', device: 'plc-line3-0042', status: ['ok', 'Issued'] },
  { time: '10:41:55', op: '/simplereenroll', device: 'gw-north-17', status: ['info', 'Renewed'] },
  { time: '10:40:12', op: '/cacerts', device: 'hmi-panel-08', status: ['info', 'Served'] },
  { time: '10:38:40', op: 'revoke', device: 'lock-b2-883', status: ['bad', 'Revoked'] },
  { time: '10:37:02', op: '/simpleenroll', device: 'bms-rack-12', status: ['ok', 'Issued'] },
  { time: '10:35:19', op: '/serverkeygen', device: 'meter-ft-2207', status: ['ok', 'Issued'] },
];
const engines = [
  { icon: 'chip', name: 'PKCS#11 HSM', id: 'pkcs11-hsm-01', level: 'Level 2' },
  { icon: 'cloud', name: 'AWS KMS', id: 'aws-kms-eu-west-1', level: 'Level 2' },
  { icon: 'cloud', name: 'Azure Key Vault Keys', id: 'azure-kv-prod', level: 'Level 2' },
  { icon: 'vault', name: 'HashiCorp Vault', id: 'vault-kv-plant', level: 'Level 1' },
  { icon: 'file', name: 'File system', id: 'fs-dev', level: 'Level 0' },
];
const auditEvents = [
  ['ca.create', 'admin@acme'],
  ['certificate.revoke', 'secops'],
  ['dms.update', 'ops-bot'],
];

// The page renders in Spanish first; the FAQ structured data follows that default.
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: home.faq.items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<SiteLayout
  title={homeTranslations.es.meta.title}
  lang="es"
  activeNav="home"
  pageTranslations={homeTranslations}
>
  <Fragment slot="head">
    <script is:inline>
      // Light is the landing's default; a choice made with the theme toggle still wins.
      (function () {
        try {
          if (!localStorage.getItem('ls-theme')) document.documentElement.setAttribute('data-theme', 'light');
        } catch (e) {}
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.classList.add('lp-motion');
        }
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </Fragment>

  <main class="lp">

    <!-- ═══ Hero — gradient panel ═══ -->
    <section class="lp-hero" id="home">
      <div class="lp-hero-inner">
        <a class="lp-announce" href="#pqc">
          <span class="lp-announce-tag" data-i18n="home.hero.announceTag">{home.hero.announceTag}</span>
          <span class="lp-announce-text" data-i18n="home.hero.announce">{home.hero.announce}</span>
          <span class="lp-announce-arrow" aria-hidden="true">&gt;</span>
        </a>
        <h1>
          <span data-i18n="home.hero.title">{home.hero.title}</span>
          <span class="lp-mark" data-i18n="home.hero.titleMark">{home.hero.titleMark}</span>
        </h1>
        <p class="lp-hero-lead" data-i18n="home.hero.lead">{home.hero.lead}</p>
        <div class="lp-actions">
          <a class="lp-btn lp-btn--white" href="#contact" data-i18n="home.hero.ctaPrimary">{home.hero.ctaPrimary}</a>
          <a class="lp-btn lp-btn--outline-white" href="#deployment" data-i18n="home.hero.ctaSecondary">{home.hero.ctaSecondary}</a>
        </div>
        <ul class="lp-proof" aria-label={home.hero.proofAria} data-i18n-attr-aria-label="home.hero.proofAria">
          {home.hero.proof.map((item, index) => (
            <li data-i18n={`home.hero.proof.${index}`}>{item}</li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ═══ Logos ═══════════════════════════════════════════════ -->
    <section class="lp-wrap lp-logos" aria-label={home.logos.aria} data-i18n-attr-aria-label="home.logos.aria">
      <p class="lp-logos-title" data-i18n="home.logos.title">{home.logos.title}</p>
      <ul>
        {customerLogos.map((logo) => (
          <li><img src={logo.src} alt={logo.name} loading="lazy" /></li>
        ))}
      </ul>
    </section>

    <!-- ═══ Platform — framed statement + three cells ═══════════ -->
    <section class="lp-section" id="platform">
      <div class="lp-wrap">
        <header class="lp-framed lp-head lp-head--center" data-reveal>
          <p class="lp-label" data-i18n="home.platform.label">{home.platform.label}</p>
          <h2>
            <span data-i18n="home.platform.title">{home.platform.title}</span>
            <span class="lp-mark" data-i18n="home.platform.titleMark">{home.platform.titleMark}</span>
            <span data-i18n="home.platform.titleEnd">{home.platform.titleEnd}</span>
          </h2>
          <p class="lp-lead" data-i18n="home.platform.lead">{home.platform.lead}</p>
        </header>

        <div class="lp-cells" data-reveal>
          {home.platform.items.map((item, index) => (
            <article class="lp-cell">
              <svg class="lp-icon" viewBox="0 0 24 24" aria-hidden="true" set:html={icons[platformIcons[index]]} />
              <h3 data-i18n={`home.platform.items.${index}.title`}>{item.title}</h3>
              <p class="lp-body" data-i18n={`home.platform.items.${index}.body`}>{item.body}</p>
              <a class="lp-link" href={item.href} data-i18n={`home.platform.items.${index}.link`}>{item.link}</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══ Product: certificate authorities ════════════════════ -->
    <section class="lp-section lp-product" id="pki">
      <div class="lp-wrap">
        <div class="lp-product-head" data-reveal>
          <header class="lp-head">
            <p class="lp-label" data-i18n="home.pki.label">{home.pki.label}</p>
            <h2><span class="lp-mark" data-i18n="home.pki.title">{home.pki.title}</span></h2>
            <p class="lp-lead" data-i18n="home.pki.lead">{home.pki.lead}</p>
          </header>
          <a class="lp-btn lp-btn--secondary" href={home.docs.pki} data-i18n-attr-href="home.docs.pki" data-i18n="home.pki.cta">{home.pki.cta}</a>
        </div>

        <div class="lp-product-frame" data-reveal>
          <ul class="lp-features">
            {home.pki.features.map((feature, index) => (
              <li class="lp-feature">
                <p class="lp-feature-tag">
                  <svg class="lp-icon" viewBox="0 0 24 24" aria-hidden="true" set:html={icons[pkiIcons[index]]} />
                  <span data-i18n={`home.pki.features.${index}.tag`}>{feature.tag}</span>
                </p>
                <p data-i18n={`home.pki.features.${index}.body`}>{feature.body}</p>
                <a class="lp-link" href={feature.href} data-i18n-attr-href={`home.pki.features.${index}.href`} data-i18n={`home.pki.features.${index}.link`}>{feature.link}</a>
              </li>
            ))}
          </ul>
          <div class="lp-visual" aria-hidden="true">
            <div class="lp-window">
              <div class="lp-window-bar">
                <div>
                  <p class="lp-window-title">Certification Authorities</p>
                  <p class="lp-window-sub">Hierarchy · 5 CAs · 3 crypto engines</p>
                </div>
                <span class="lp-window-btn">+ Create CA</span>
              </div>
              <table class="lp-table">
                <thead>
                  <tr><th>Name</th><th>Key</th><th>Engine</th><th>Status</th></tr>
                </thead>
                <tbody>
                  {caRows.map((row) => (
                    <tr>
                      <td>{row.tree && <span class="lp-tree">{row.tree}</span>}{row.name}</td>
                      <td class="lp-mono">{row.algo}</td>
                      <td>{row.engine}</td>
                      <td><span class={`lp-status lp-status--${row.status[0]}`}>{row.status[1]}</span></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ Product: device identity (EST / CMP) ════════════════ -->
    <section class="lp-section lp-product lp-product--flip" id="automation">
      <div class="lp-wrap">
        <div class="lp-product-head" data-reveal>
          <header class="lp-head">
            <p class="lp-label" data-i18n="home.devices.label">{home.devices.label}</p>
            <h2><span class="lp-mark" data-i18n="home.devices.title">{home.devices.title}</span></h2>
            <p class="lp-lead" data-i18n="home.devices.lead">{home.devices.lead}</p>
            <div class="lp-chips">
              {home.devices.protocols.map((protocol, index) => (
                <span class="lp-chip" data-i18n={`home.devices.protocols.${index}`}>{protocol}</span>
              ))}
            </div>
          </header>
          <a class="lp-btn lp-btn--secondary" href={home.docs.enrollment} data-i18n-attr-href="home.docs.enrollment" data-i18n="home.devices.cta">{home.devices.cta}</a>
        </div>

        <div class="lp-product-frame" data-reveal>
          <ul class="lp-features">
            {home.devices.features.map((feature, index) => (
              <li class="lp-feature">
                <p class="lp-feature-tag">
                  <svg class="lp-icon" viewBox="0 0 24 24" aria-hidden="true" set:html={icons[devicesIcons[index]]} />
                  <span data-i18n={`home.devices.features.${index}.tag`}>{feature.tag}</span>
                </p>
                <p data-i18n={`home.devices.features.${index}.body`}>{feature.body}</p>
                <a class="lp-link" href={feature.href} data-i18n-attr-href={`home.devices.features.${index}.href`} data-i18n={`home.devices.features.${index}.link`}>{feature.link}</a>
              </li>
            ))}
          </ul>
          <div class="lp-visual" aria-hidden="true">
            <div class="lp-window">
              <div class="lp-window-bar">
                <div>
                  <p class="lp-window-title">Device events</p>
                  <p class="lp-window-sub">DMS · factory-line-3 · /.well-known/est</p>
                </div>
                <span class="lp-status lp-status--ok">Live</span>
              </div>
              <ul class="lp-log">
                {deviceEvents.map((event) => (
                  <li>
                    <span class="lp-log-time">{event.time}</span>
                    <span class="lp-log-op">{event.op}</span>
                    <span>{event.device}</span>
                    <span class={`lp-status lp-status--${event.status[0]}`}>{event.status[1]}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ Product: key custody ════════════════════════════════ -->
    <section class="lp-section lp-product" id="keys">
      <div class="lp-wrap">
        <div class="lp-product-head" data-reveal>
          <header class="lp-head">
            <p class="lp-label" data-i18n="home.keys.label">{home.keys.label}</p>
            <h2><span class="lp-mark" data-i18n="home.keys.title">{home.keys.title}</span></h2>
            <p class="lp-lead" data-i18n="home.keys.lead">{home.keys.lead}</p>
          </header>
          <a class="lp-btn lp-btn--secondary" href={home.docs.keys} data-i18n-attr-href="home.docs.keys" data-i18n="home.keys.cta">{home.keys.cta}</a>
        </div>

        <div class="lp-product-frame" data-reveal>
          <ul class="lp-features">
            {home.keys.features.map((feature, index) => (
              <li class="lp-feature">
                <p class="lp-feature-tag">
                  <svg class="lp-icon" viewBox="0 0 24 24" aria-hidden="true" set:html={icons[keysIcons[index]]} />
                  <span data-i18n={`home.keys.features.${index}.tag`}>{feature.tag}</span>
                </p>
                <p data-i18n={`home.keys.features.${index}.body`}>{feature.body}</p>
              </li>
            ))}
          </ul>
          <div class="lp-visual" aria-hidden="true">
            <div class="lp-window">
              <div class="lp-window-bar">
                <div>
                  <p class="lp-window-title">Crypto Engines</p>
                  <p class="lp-window-sub">KMS · 5 engines connected</p>
                </div>
                <span class="lp-window-btn">+ Add engine</span>
              </div>
              <div class="lp-engines">
                {engines.map((engine) => (
                  <div class="lp-engine">
                    <span class="lp-engine-icon"><svg class="lp-icon" viewBox="0 0 24 24" set:html={icons[engine.icon]} /></span>
                    <span>
                      <span class="lp-engine-name">{engine.name}</span><br />
                      <span class="lp-engine-id">{engine.id}</span>
                    </span>
                    <span class="lp-status lp-status--info">{engine.level}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ Post-quantum — inverted band ════════════════════════ -->
    <section class="lp-band" id="pqc">
      <div class="lp-wrap">
        <div class="lp-band-head" data-reveal>
          <header class="lp-head">
            <p class="lp-badge" data-i18n="home.pqc.badge">{home.pqc.badge}</p>
            <h2>
              <span data-i18n="home.pqc.title">{home.pqc.title}</span>
              <span data-i18n="home.pqc.titleMuted">{home.pqc.titleMuted}</span>
            </h2>
            <p class="lp-lead" data-i18n="home.pqc.lead">{home.pqc.lead}</p>
          </header>
          <div class="lp-actions">
            <a class="lp-btn lp-btn--primary" href="#contact" data-i18n="home.pqc.ctaPrimary">{home.pqc.ctaPrimary}</a>
          </div>
        </div>

        <ol class="lp-certs" data-reveal>
          {home.pqc.certs.map((cert, index) => (
            <li class:list={['lp-cert', index === 1 && 'lp-cert--hl']}>
              <p class="lp-cert-step" data-i18n={`home.pqc.certs.${index}.tag`}>{cert.tag}</p>
              <h3 data-i18n={`home.pqc.certs.${index}.name`}>{cert.name}</h3>
              <div class="lp-chips">
                {index < 2 && <span class="lp-sig">RSA · ECDSA</span>}
                {index > 0 && <span class="lp-sig lp-sig--pq">ML-DSA</span>}
              </div>
              <p class="lp-body" data-i18n={`home.pqc.certs.${index}.body`}>{cert.body}</p>
            </li>
          ))}
        </ol>

        <div class="lp-points" data-reveal>
          {home.pqc.points.map((point, index) => (
            <div class="lp-point">
              <h3 data-i18n={`home.pqc.points.${index}.title`}>{point.title}</h3>
              <p class="lp-body" data-i18n={`home.pqc.points.${index}.body`}>{point.body}</p>
            </div>
          ))}
        </div>

        <p class="lp-note" data-i18n="home.pqc.note">{home.pqc.note}</p>
      </div>
    </section>

    <!-- ═══ Why now — three big numbers ═════════════════════════ -->
    <section class="lp-section lp-section--bare" id="why-now">
      <div class="lp-wrap">
        <header class="lp-head lp-head--center" data-reveal>
          <p class="lp-label" data-i18n="home.whyNow.label">{home.whyNow.label}</p>
          <h2 data-i18n="home.whyNow.title">{home.whyNow.title}</h2>
          <p class="lp-lead" data-i18n="home.whyNow.lead">{home.whyNow.lead}</p>
        </header>
        <div class="lp-stats" data-reveal>
          {home.whyNow.items.map((item, index) => (
            <article class="lp-stat">
              <p class="lp-stat-value" data-i18n={`home.whyNow.items.${index}.value`}>{item.value}</p>
              <h3 data-i18n={`home.whyNow.items.${index}.label`}>{item.label}</h3>
              <p class="lp-body" data-i18n={`home.whyNow.items.${index}.body`}>{item.body}</p>
              <p class="lp-source" data-i18n={`home.whyNow.items.${index}.source`}>{item.source}</p>
            </article>
          ))}
        </div>
        <p class="lp-statement" data-reveal data-i18n="home.whyNow.closing">{home.whyNow.closing}</p>
      </div>
    </section>

    <!-- ═══ Operations bento ════════════════════════════════════ -->
    <section class="lp-section" id="operations">
      <div class="lp-wrap">
        <header class="lp-head lp-head--center" data-reveal>
          <p class="lp-label" data-i18n="home.ops.label">{home.ops.label}</p>
          <h2 data-i18n="home.ops.title">{home.ops.title}</h2>
          <p class="lp-lead" data-i18n="home.ops.lead">{home.ops.lead}</p>
        </header>

        <div class="lp-bento" data-reveal>
          <article class="lp-tile lp-tile--wide lp-tile--shot">
            <div class="lp-tile-text">
              <svg class="lp-icon" viewBox="0 0 24 24" aria-hidden="true" set:html={icons.console} />
              <h3 data-i18n="home.ops.tiles.0.title">{home.ops.tiles[0].title}</h3>
              <p class="lp-body" data-i18n="home.ops.tiles.0.body">{home.ops.tiles[0].body}</p>
            </div>
            <div class="lp-tile-shot" aria-hidden="true"></div>
          </article>

          <article class="lp-tile lp-tile--solid">
            <svg class="lp-icon" viewBox="0 0 24 24" aria-hidden="true" set:html={icons.code} />
            <div class="lp-tile-text">
