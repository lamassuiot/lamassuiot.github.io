            data-i18n-attr-aria-label="home.cta.right.inputPlaceholder"
          />
          <button type="submit" class="lp-btn lp-btn--primary" data-i18n="home.cta.right.submitLabel">{home.cta.right.submitLabel}</button>
        </form>
