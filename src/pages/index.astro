---
import SiteLayout from '../layouts/SiteLayout.astro';

const companyLogos = [
  { src: '/company/caf.png', alt: 'CAF' },
  { src: '/company/cegasa.svg', alt: 'Cegasa' },
  { src: '/company/erreka.png', alt: 'Erreka' },
  { src: '/company/fagor_professional.svg', alt: 'Fagor Professional' },
  { src: '/company/gh.png', alt: 'GH' },
  { src: '/company/ikerlan.png', alt: 'Ikerlan' },
  { src: '/company/lks.png', alt: 'LKS' },
];
---

<SiteLayout title="Lamassu IoT | Industrial PKI Homepage" lang="en" activeNav="home">
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <style is:global>
      :root {
        --home-bg: #09111f;
        --home-surface: #10192c;
        --home-surface-soft: #15233a;
        --home-border: #243550;
        --home-title: #edf3ff;
        --home-text: #bcc9df;
        --home-muted: #8fa1c3;
        --home-accent: #7e9cff;
        --home-accent-text: #08101e;
      }

      [data-theme='light'] {
        --home-bg: #f4f6fa;
        --home-surface: #ffffff;
        --home-surface-soft: #f6f8fd;
        --home-border: #d8deeb;
        --home-title: #0f1728;
        --home-text: #36455f;
        --home-muted: #5f6e8c;
        --home-accent: #405fff;
        --home-accent-text: #ffffff;
      }

      body {
        font-family: 'Manrope', sans-serif;
      }

      .home-page {
        width: min(1360px, calc(100% - 48px));
        margin: 0 auto;
        position: relative;
      }

      .home-page::before {
        content: '';
        position: absolute;
        top: 0;
        bottom: 0;
        left: 50%;
        width: 100vw;
        transform: translateX(-50%);
        pointer-events: none;
        background-image: radial-gradient(circle, rgba(143, 165, 228, 0.38) 1px, transparent 1px);
        background-size: 16px 16px;
        opacity: 0.3;
        mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.72) 0%, rgba(0, 0, 0, 0.24) 48%, transparent 84%);
        z-index: 0;
      }

      [data-theme='light'] .home-page::before {
        background-image: radial-gradient(circle, rgba(37, 55, 95, 0.34) 1px, transparent 1px);
        opacity: 0.31;
      }

      .home-page > * {
        position: relative;
        z-index: 1;
      }

      .home-hero {
        padding: 72px 0 56px;
        display: grid;
        gap: 16px;
      }

      .home-kicker {
        margin: 0;
        font-family: 'JetBrains Mono', monospace;
        font-size: 12px;
        letter-spacing: 0.06em;
        color: var(--home-muted);
      }

      .home-hero h1 {
        margin: 0;
        color: var(--home-title);
        font-size: clamp(38px, 7vw, 72px);
        line-height: 1.02;
        letter-spacing: -0.03em;
      }

      .home-lead {
        margin: 0;
        color: var(--home-text);
        font-size: clamp(17px, 2.2vw, 21px);
        line-height: 1.5;
      }

      .home-actions {
        margin-top: 8px;
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
      }

      .home-btn {
        text-decoration: none;
        border: 1px solid var(--home-border);
        background: var(--home-surface);
        color: var(--home-title);
        border-radius: 8px;
        padding: 10px 14px;
        font-size: 14px;
        font-weight: 600;
        transition: border-color 0.15s ease, background-color 0.15s ease;
      }

      .home-btn:hover {
        border-color: var(--home-muted);
      }

      .home-btn-primary {
        background: var(--home-accent);
        border-color: transparent;
        color: var(--home-accent-text);
      }

      .home-btn-primary:hover {
        background: #95adff;
      }

      [data-theme='light'] .home-btn-primary:hover {
        background: #334ffc;
      }

      .home-stack {
        margin-top: 14px;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }

      .home-stack span {
        border: 1px solid var(--home-border);
        border-radius: 6px;
        padding: 6px 8px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        color: var(--home-muted);
        background: var(--home-surface);
      }

      .home-mesh-band {
        margin-top: 14px;
        height: 170px;
        border: 1px solid rgba(98, 132, 235, 0.56);
        border-radius: 12px;
        background: linear-gradient(90deg, #5a1ff0 0%, #4d41f6 40%, #3d78f6 70%, #4ac2f5 100%);
        position: relative;
        overflow: hidden;
      }

      .home-mesh-band::before {
        content: '';
        position: absolute;
        inset: 0;
        background:
          linear-gradient(0deg, rgba(255, 255, 255, 0.12) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255, 255, 255, 0.11) 1px, transparent 1px);
        background-size: 100% 34px, 88px 100%;
        opacity: 0.28;
      }

      .home-mesh-shot-line {
        position: absolute;
        left: 6%;
        right: calc(8% + 300px);
        top: 50%;
        height: 18px;
        transform: translateY(-50%);
        overflow: visible;
        pointer-events: none;
      }

      .home-mesh-projectile {
        --mesh-shot-size: 10px;
        position: absolute;
        top: 50%;
        left: 0;
        width: var(--mesh-shot-size);
        height: var(--mesh-shot-size);
        border-radius: 50%;
        transform: translateY(-50%);
        background: #effcff;
        box-shadow:
          0 0 0 4px rgba(170, 244, 255, 0.18),
          0 0 18px rgba(170, 244, 255, 0.95);
        animation: homeMeshProjectile 3.4s linear infinite;
      }

      .home-mesh-projectile::before {
        content: '';
        position: absolute;
        top: 50%;
        right: 4px;
        width: 120px;
        height: 2px;
        transform: translateY(-50%);
        background: linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(188, 244, 255, 0.4) 42%, rgba(239, 252, 255, 0.9) 100%);
        filter: blur(1px);
      }

      .home-mesh-projectile::after {
        content: '';
        position: absolute;
        top: 50%;
        right: 0;
        width: 56px;
        height: 1px;
        transform: translateY(-50%);
        background: linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(239, 252, 255, 0.92));
      }

      .home-mesh-sweep {
        position: absolute;
        width: 62%;
        height: 240%;
        left: -18%;
        top: -72%;
        background: radial-gradient(circle, rgba(131, 255, 255, 0.36) 0%, rgba(131, 255, 255, 0.06) 34%, rgba(131, 255, 255, 0) 70%);
        transform-origin: 80% 72%;
        animation: homeMeshSweep 7s linear infinite;
        pointer-events: none;
      }

      .home-mesh-label {
        margin: 0;
        color: rgba(230, 246, 255, 0.74);
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        letter-spacing: 0.08em;
        text-align: center;
      }

      .home-mesh-numbers {
        position: absolute;
        top: 14px;
        right: 18px;
        margin: 0;
        color: rgba(230, 246, 255, 0.58);
        font-family: 'JetBrains Mono', monospace;
        font-size: 22px;
        letter-spacing: 0.06em;
      }

      .home-mesh-hud {
        position: absolute;
        right: 8%;
        top: 50%;
        transform: translateY(-50%);
        width: 300px;
        height: 300px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        border: 2px solid rgba(119, 240, 255, 0.52);
        box-shadow:
          0 0 0 34px rgba(26, 227, 255, 0.12),
          0 0 0 70px rgba(23, 188, 255, 0.09);
        background: radial-gradient(circle, rgba(36, 221, 255, 0.24) 0%, rgba(37, 145, 255, 0.08) 52%, rgba(37, 145, 255, 0) 72%);
        overflow: visible;
      }

      .home-mesh-hud::before,
      .home-mesh-hud::after {
        content: '';
        position: absolute;
        border-radius: 50%;
        inset: -4px;
        border: 4px solid rgba(196, 250, 255, 0.68);
        opacity: 0;
      }

      .home-mesh-hud::before {
        animation: homeMeshImpactRing 3.4s cubic-bezier(0.2, 0.8, 0.2, 1) infinite;
      }

      .home-mesh-hud::after {
        animation: homeMeshImpactGlow 3.4s ease-out infinite;
      }

      .home-mesh-hud-content {
        display: grid;
        justify-items: center;
        gap: 16px;
      }

      .home-mesh-hud-core {
        width: 108px;
        height: 108px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        background: transparent;
      }

      .home-mesh-logo {
        width: 68px;
        height: auto;
        display: block;
      }

      .home-section {
        padding-top: 108px;
      }

      .home-section + .home-section {
        padding-top: 156px;
      }

      .home-section#outcomes {
        padding-top: 20px;
      }

      .home-section h2 {
        margin: 0;
        color: var(--home-title);
        font-size: clamp(28px, 5vw, 48px);
        line-height: 1.08;
        letter-spacing: -0.03em;
      }

      .home-section > p {
        margin: 12px 0 0;
        color: var(--home-text);
        font-size: 17px;
        line-height: 1.56;
      }

      .home-company-carousel {
        margin: 0 0 26px;
        position: relative;
        left: 50%;
        width: 100vw;
        transform: translateX(-50%);
        overflow: hidden;
        border-top: 1px solid rgba(143, 172, 246, 0.16);
        border-bottom: 1px solid rgba(143, 172, 246, 0.16);
        background:
          linear-gradient(180deg, rgba(10, 16, 31, 0.4), rgba(10, 16, 31, 0.18)),
          rgba(8, 12, 24, 0.44);
      }

      [data-theme='light'] .home-company-carousel {
        background:
          linear-gradient(180deg, rgba(255, 255, 255, 0.86), rgba(246, 248, 253, 0.94)),
          rgba(255, 255, 255, 0.9);
      }

      .home-company-carousel::before,
      .home-company-carousel::after {
        content: '';
        position: absolute;
        top: 0;
        bottom: 0;
        width: clamp(48px, 9vw, 160px);
        pointer-events: none;
        z-index: 2;
      }

      .home-company-carousel::before {
        left: 0;
        background: linear-gradient(90deg, var(--home-bg) 0%, rgba(9, 17, 31, 0) 100%);
      }

      .home-company-carousel::after {
        right: 0;
        background: linear-gradient(270deg, var(--home-bg) 0%, rgba(9, 17, 31, 0) 100%);
      }

      .home-company-carousel-track {
        display: flex;
        align-items: center;
        width: max-content;
        animation: homeCompanyMarquee 32s linear infinite;
      }

      .home-company-carousel-group {
        display: flex;
        align-items: center;
        gap: clamp(28px, 4vw, 52px);
        padding: 18px clamp(18px, 4vw, 36px);
        flex-shrink: 0;
      }

      .home-company-logo {
        width: clamp(110px, 12vw, 170px);
        height: 56px;
        padding: 8px 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-sizing: border-box;
        filter: grayscale(1) brightness(1.2);
        opacity: 0.76;
        transition: opacity 0.2s ease, filter 0.2s ease;
      }

      [data-theme='light'] .home-company-logo {
        filter: grayscale(1) contrast(1.02);
        opacity: 0.8;
      }

      .home-company-logo:hover {
        opacity: 1;
        filter: grayscale(0) brightness(1);
      }

      .home-company-logo img {
        max-width: 100%;
        max-height: 100%;
        width: auto;
        height: auto;
        object-fit: contain;
        display: block;
      }

      .home-overview-showcase {
        margin-top: 22px;
        display: grid;
        grid-template-columns: minmax(0, 1.7fr) minmax(260px, 0.9fr);
        gap: 20px;
        align-items: stretch;
      }

      .home-overview-figure {
        margin: 0;
      }

      .home-overview-figure img {
        display: block;
        width: 100%;
        height: auto;
        border-radius: 12px;
      }

      .home-overview-meta {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: clamp(32px, 4vh, 56px);
        height: 100%;
      }

      .home-overview-block {
        display: grid;
        gap: 10px;
        border-left: 1px solid var(--home-border);
        padding-left: 16px;
      }

      .home-overview-meta p {
        margin: 0;
        color: var(--home-text);
        line-height: 1.58;
        font-size: 14px;
      }

      .home-overview-meta-title {
        color: var(--home-title) !important;
        font-size: 16px !important;
        font-weight: 700;
      }

      .why-list {
        margin-top: 10px;
      }

      .why-row {
        display: grid;
        grid-template-columns: minmax(360px, 1.15fr) minmax(280px, 0.85fr);
        gap: clamp(32px, 4vw, 56px);
        align-items: center;
        padding: 64px 0;
        border-bottom: 1px solid var(--home-border);
      }

      .why-row:first-child {
        padding: 20px 0 60px 0;
      }

      .why-row:nth-child(even) {
        grid-template-columns: minmax(280px, 0.85fr) minmax(360px, 1.15fr);
      }

      .why-visual {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 320px;
        padding: 20px 8px;
        background-image: radial-gradient(circle, rgba(143, 161, 195, 0.24) 0.8px, transparent 0.8px);
        background-size: 18px 18px;
        background-position: center;
      }

      .why-visual img {
        display: block;
        width: 100%;
        max-width: 520px;
        height: auto;
      }

      .why-row:nth-child(even) .why-copy {
        order: 2;
      }

      .why-row:nth-child(even) .why-visual {
        order: 1;
      }

      .why-copy {
        display: grid;
        gap: 16px;
        align-content: center;
        width: 100%;
        max-width: none;
      }

      .why-copy h3 {
        margin: 0;
        color: var(--home-title);
        font-size: clamp(24px, 3.1vw, 34px);
        line-height: 1.08;
        letter-spacing: -0.03em;
      }

      .why-body {
        margin: 0;
        color: var(--home-text);
        font-size: 18px;
        line-height: 1.72;
        max-width: none;
      }

      .feature-plain-list {
        margin: 22px 0 0;
        padding: 0;
        list-style: none;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        column-gap: 28px;
        row-gap: 14px;
      }

      .feature-plain-list li {
        color: var(--home-text);
        font-size: 15px;
        line-height: 1.55;
      }

      .feature-plain-list strong {
        color: var(--home-title);
      }

      .stack-subheadline {
        margin-top: 12px;
        color: var(--home-muted) !important;
      }

      .stack-rows {
        margin-top: 20px;
        border-top: 1px solid var(--home-border);
      }

      .stack-row {
        display: grid;
        grid-template-columns: minmax(280px, 0.85fr) 1.4fr;
        gap: 22px;
        align-items: start;
        padding: 16px 0;
        border-bottom: 1px solid var(--home-border);
      }

      .stack-title {
        margin: 0;
        display: flex;
        align-items: flex-start;
        gap: 10px;
        color: var(--home-title);
        font-size: 18px;
        line-height: 1.35;
      }

      .stack-icon {
        width: 16px;
        height: 16px;
        margin-top: 4px;
        border: 1.5px solid var(--home-muted);
        border-radius: 4px;
        flex: 0 0 16px;
        position: relative;
      }

      .stack-icon::after {
        content: '';
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--home-accent);
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
      }

      .stack-row p {
        margin: 0;
        color: var(--home-text);
        font-size: 15px;
        line-height: 1.55;
      }

      @keyframes homeMeshSweep {
        from {
          transform: rotate(0deg);
        }
        to {
          transform: rotate(360deg);
        }
      }

      @keyframes homeMeshProjectile {
        0% {
          left: 0;
          transform: translateY(-50%) scale(0.85);
          opacity: 0;
        }
        6% {
          opacity: 1;
        }
        38% {
          left: calc(100% - var(--mesh-shot-size));
          transform: translateY(-50%) scale(1);
          opacity: 1;
        }
        46% {
          left: calc(100% - var(--mesh-shot-size));
          transform: translateY(-50%) scale(0.9);
          opacity: 0;
        }
        100% {
          left: calc(100% - var(--mesh-shot-size));
          transform: translateY(-50%) scale(0.9);
          opacity: 0;
        }
      }

      @keyframes homeMeshImpactRing {
        0%,
        38% {
          transform: scale(0.94);
          opacity: 0;
        }
        46% {
          opacity: 0.82;
        }
        78% {
          transform: scale(1.2);
          opacity: 0;
        }
        100% {
          transform: scale(1.2);
          opacity: 0;
        }
      }

      @keyframes homeMeshImpactGlow {
        0%,
        38% {
          box-shadow: 0 0 0 0 rgba(186, 248, 255, 0);
          opacity: 0;
        }
        46% {
          opacity: 0.72;
        }
        76% {
          box-shadow: 0 0 0 24px rgba(186, 248, 255, 0);
          opacity: 0;
        }
        100% {
          box-shadow: 0 0 0 24px rgba(186, 248, 255, 0);
          opacity: 0;
        }
      }

      @keyframes homeCompanyMarquee {
        from {
          transform: translateX(0);
        }
        to {
          transform: translateX(-50%);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .home-company-carousel-track {
          animation: none;
        }
      }

      @media (max-width: 1100px) {
        .home-page {
          width: min(1360px, calc(100% - 28px));
        }

        .feature-plain-list {
          grid-template-columns: 1fr;
          row-gap: 10px;
        }

        .home-mesh-numbers {
          display: none;
        }
      }

      @media (max-width: 860px) {
        .home-overview-showcase,
        .why-row,
        .stack-row {
          grid-template-columns: 1fr;
          gap: 22px;
        }

        .home-overview-meta {
          display: grid;
          justify-content: initial;
          border-top: 1px solid var(--home-border);
          gap: 20px;
          height: auto;
          padding-top: 14px;
        }

        .home-overview-block {
          padding-left: 14px;
        }

        .home-mesh-band {
          height: 128px;
        }

        .home-mesh-shot-line {
          right: calc(2% + 170px);
        }

        .home-mesh-projectile {
          --mesh-shot-size: 8px;
        }

        .home-mesh-projectile::before {
          width: 78px;
        }

        .home-mesh-projectile::after {
          width: 34px;
        }

        .home-mesh-hud {
          width: 170px;
          height: 170px;
          right: 2%;
          box-shadow:
            0 0 0 18px rgba(26, 227, 255, 0.1),
            0 0 0 38px rgba(23, 188, 255, 0.08);
        }

        .home-mesh-hud-content {
          gap: 10px;
        }

        .home-mesh-hud-core {
          width: 72px;
          height: 72px;
        }

        .home-mesh-logo {
          width: 42px;
        }

        .home-mesh-label {
          font-size: 8px;
        }

        .home-hero {
          justify-items: center;
          text-align: center;
        }

        .home-actions,
        .home-stack {
          justify-content: center;
        }

        .why-visual img {
          max-width: 420px;
        }

        .why-copy {
          gap: 12px;
        }

        .why-body {
          max-width: none;
        }

        .home-company-carousel {
          margin-bottom: 22px;
        }

        .home-company-carousel-group {
          gap: 26px;
          padding-top: 14px;
          padding-bottom: 14px;
        }

        .home-company-logo {
          width: 118px;
          height: 48px;
        }

        .why-row:nth-child(even) .why-copy,
        .why-row:nth-child(even) .why-visual {
          order: initial;
        }
      }

      @media (max-width: 640px) {
        .home-page {
          width: calc(100% - 20px);
        }

        .home-hero {
          padding-top: 42px;
          padding-bottom: 40px;
        }

        .home-lead,
        .home-section > p,
        .community-block p {
          font-size: 16px;
        }

        .home-section {
          padding-top: 72px;
        }

        .home-section + .home-section {
          padding-top: 92px;
        }

        .home-section#outcomes {
          padding-top: 20px;
        }

        .home-company-carousel {
          margin-bottom: 18px;
        }

        .home-company-carousel-group {
          gap: 22px;
          padding-left: 14px;
          padding-right: 14px;
        }

        .home-company-logo {
          width: 102px;
          height: 42px;
          padding: 6px 8px;
        }

        .quick-links {
          gap: 8px 14px;
        }

        .quick-links a {
          font-size: 14px;
        }
      }
    </style>
  </Fragment>

  <main class="home-page">
    <section class="home-hero" id="home">
      <p class="home-kicker">Industrial PKI for IoT fleets</p>
      <h1>PKI industrial para gestionar identidades IoT de extremo a extremo</h1>
      <p class="home-lead">
        Centraliza claves, autoridades de certificación, emisión, validación y ciclo de vida de dispositivos en una sola
        plataforma preparada para operación industrial.
      </p>
      <div class="home-actions">
        <a class="home-btn home-btn-primary" href="#capabilities">Ver funcionalidades</a>
        <a class="home-btn" href="#outcomes">Capacidades Core</a>
      </div>
      <div class="home-stack" aria-label="Capacidades de la plataforma">
        <span>PKI</span>
        <span>Device Identity</span>
        <span>Secure Software Updates</span>
        <span>Code Sign</span>
      </div>
    </section>

    <section class="home-mesh-band" aria-hidden="true">
      <div class="home-mesh-shot-line">
        <div class="home-mesh-projectile"></div>
      </div>
