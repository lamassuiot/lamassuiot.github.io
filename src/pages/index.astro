        <div class="lp-faq" data-reveal>
          {home.faq.items.map((item, index) => (
            <details class="lp-faq-item" open={index === 0}>
              <summary data-i18n={`home.faq.items.${index}.q`}>{item.q}</summary>
              <p data-i18n={`home.faq.items.${index}.a`}>{item.a}</p>
