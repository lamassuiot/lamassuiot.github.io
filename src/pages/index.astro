            <div class="lp-tile-text">
              <h3 data-i18n="home.ops.tiles.4.title">{home.ops.tiles[4].title}</h3>
              <p class="lp-body" data-i18n="home.ops.tiles.4.body">{home.ops.tiles[4].body}</p>
