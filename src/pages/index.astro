    <!-- ═══ Closing panel ═══════════════════════════════════════ -->
    <section class="lp-closing" id="contact" data-reveal>
      <div class="lp-closing-main">
        <p class="lp-label" data-i18n="home.cta.left.label">{home.cta.left.label}</p>
        <h2 data-i18n="home.cta.left.heading">{home.cta.left.heading}</h2>
        <div class="lp-actions">
          <a href="mailto:info@lamassu.io" class="lp-btn lp-btn--white" data-i18n="home.cta.left.btn">{home.cta.left.btn}</a>
