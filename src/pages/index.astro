              <h3 data-i18n={`home.deployment.options.${index}.title`}>{option.title}</h3>
              <p class="lp-body" data-i18n={`home.deployment.options.${index}.body`}>{option.body}</p>
              <div class="lp-chips">
                {option.chips.map((chip, chipIndex) => (
                  <span class="lp-chip" data-i18n={`home.deployment.options.${index}.chips.${chipIndex}`}>{chip}</span>
                ))}
