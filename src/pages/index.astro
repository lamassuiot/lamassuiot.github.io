---
import SiteLayout from '../layouts/SiteLayout.astro';
import CryptoEngines from '../components/CryptoEngines.astro';
import TrustHierarchy from '../components/TrustHierarchy.astro';
import TechnicalCapabilities from '../components/TechnicalCapabilities.astro';
import { landingTranslations } from '../lib/landing-content';
import '../styles/landing-tokens.css';
import '../styles/landing.css';

const home = landingTranslations.es.home;
const copy = home.redesign;

const customerLogos = [
  { name: 'Cegasa', src: '/company/cegasa.svg' },
  { name: 'GH Cranes & Components', src: '/company/gh.png' },
  { name: 'Onnera Group', src: '/company/onnera.png' },
  { name: 'Erreka', src: '/company/erreka.png' },
];

const integrationTargets = [
  { name: 'EMQX', light: '/integrations/iot/emqx.png', dark: '/integrations/iot/emqxw.png' },
  { name: 'AWS IoT Core', light: '/integrations/iot/iotcore.png', dark: '/integrations/iot/iotcore.png' },
  { name: 'Azure IoT Hub', light: '/integrations/iot/iot-hub.svg', dark: '/integrations/iot/iot-hub.svg' },
  { name: 'ThingsBoard', light: '/integrations/iot/thingsboard_logo_black%20big.svg', dark: '/integrations/iot/thingsboard_logo_black%20big.svg' },
];
const backerGroups = [
  { kind: 0, variant: 'industry', logos: [
    { name: 'LKS Next', src: '/sponsors/lks-next.png', width: 400, height: 400, variant: 'lks', dark: { src: '/sponsors/lks-next-white.png', width: 247, height: 158 } },
  ] },
  { kind: 1, variant: 'public', logos: [
    { name: 'Eusko Jaurlaritza / Gobierno Vasco · Grupo SPRI', src: '/sponsors/gobierno-vasco-spri.png', width: 1569, height: 391, variant: 'basque', dark: { src: '/sponsors/gobierno-vasco-spri-white.png', width: 1600, height: 484 } },
    { name: 'Gobierno de España · Ministerio de Ciencia, Innovación y Universidades · CDTI Innovación', src: '/sponsors/ministerio-cdti.png', width: 1600, height: 281, variant: 'spain', dark: { src: '/sponsors/ministerio-cdti-white.png', width: 1600, height: 283 } },
  ] },
];
const pillarLinks = ['#pki', '#automation', '#deployment'];
const faqJsonLd = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: home.faq.items.map((item) => ({
    '@type': 'Question', name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<SiteLayout title={landingTranslations.es.meta.title} lang="es" activeNav="home" pageTranslations={landingTranslations}>
  <Fragment slot="head">
    <script is:inline>
      // Light is the landing's default; a choice made with the theme toggle still wins.
      (function () {
        try {
          if (!localStorage.getItem('ls-theme')) document.documentElement.setAttribute('data-theme', 'light');
        } catch (e) {}
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.classList.add('lp-motion');
        }
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </Fragment>

  <main class="lp">
    <!-- ═══ Hero — gradient panel ═══ -->
    <section class="lp-hero" id="home">
      <div class="lp-hero-inner">
        <a class="lp-announce" href="#pqc">
          <span class="lp-announce-tag" data-i18n="home.hero.announceTag">{home.hero.announceTag}</span>
          <span class="lp-announce-text" data-i18n="home.hero.announce">{home.hero.announce}</span>
          <span class="lp-announce-arrow" aria-hidden="true">&gt;</span>
        </a>
        <h1>
          <span data-i18n="home.hero.title">{home.hero.title}</span>
          <span class="lp-mark" data-i18n="home.hero.titleMark">{home.hero.titleMark}</span>
        </h1>
        <p class="lp-hero-lead" data-i18n="home.hero.lead">{home.hero.lead}</p>
        <div class="lp-actions">
          <a class="lp-btn lp-btn--white" href="#contact" data-i18n="home.hero.ctaPrimary">{home.hero.ctaPrimary}</a>
          <a class="lp-btn lp-btn--outline-white" href="#deployment" data-i18n="home.hero.ctaSecondary">{home.hero.ctaSecondary}</a>
        </div>
        <ul class="lp-proof" aria-label={home.hero.proofAria} data-i18n-attr-aria-label="home.hero.proofAria">
          {home.hero.proof.map((item, index) => (
            <li data-i18n={`home.hero.proof.${index}`}>{item}</li>
          ))}
        </ul>
      </div>
    </section>


    <div class="lp-content">
      <section class="lp-region lp-network" id="platform">
        <header class="lp-section-heading" data-reveal>
          <h2 data-i18n="home.redesign.platformTitle">{copy.platformTitle}</h2>
          <p data-i18n="home.redesign.platformLead">{copy.platformLead}</p>
        </header>
        <div class="lp-network-stage" data-motion-scene data-reveal>
          <TrustHierarchy copy={copy} />
          <button class="lp-motion-control" type="button" data-motion-toggle aria-pressed="false" aria-label={copy.pauseMotion} data-pause-label={copy.pauseMotion} data-resume-label={copy.resumeMotion} data-i18n-attr-data-pause-label="home.redesign.pauseMotion" data-i18n-attr-data-resume-label="home.redesign.resumeMotion">
            <span class="lp-pause-symbol" aria-hidden="true"></span>
          </button>
        </div>
        <div class="lp-platform-points lp-frame">
          {copy.pillars.map((pillar, index) => <article data-reveal><h3><a href={pillarLinks[index]} data-i18n={`home.redesign.pillars.${index}.title`}>{pillar.title}</a></h3><p data-i18n={`home.redesign.pillars.${index}.body`}>{pillar.body}</p><a class="lp-point-arrow" href={pillarLinks[index]} aria-label={pillar.title} data-i18n-attr-aria-label={`home.redesign.pillars.${index}.title`}>↗</a></article>)}
        </div>
      </section>

      <section class="lp-region lp-customers" id="cases">
        <header class="lp-section-heading" data-reveal>
          <h2 data-i18n="home.redesign.trustTitle">{copy.trustTitle}</h2>
          <p data-i18n="home.redesign.trustLead">{copy.trustLead}</p>
        </header>
        <ul class="lp-customer-logos" data-reveal>
          {customerLogos.map((logo) => <li><img src={logo.src} alt={logo.name} loading="lazy" /></li>)}
        </ul>
        <div class="lp-case-browser" data-tabs>
          <div class="lp-tabs lp-tabs--sectors" data-tab-list hidden aria-label={home.references.tabsAria} data-i18n-attr-aria-label="home.references.tabsAria">
            {home.references.cards.map((card, index) => <button type="button" id={`story-tab-${index}`} aria-controls={`story-${index}`} data-tab data-i18n={`home.references.cards.${index}.sector`}>{card.sector}</button>)}
          </div>
          {home.references.cards.map((card, index) => (
            <article class="lp-case" id={`story-${index}`} data-tab-panel aria-labelledby={`story-tab-${index}`}>
              
              <div class:list={['lp-case-monogram', index === 0 && 'lp-case-monogram--rail']}>
                {index === 0 ? <img src="https://cdn.britannica.com/28/233928-050-CC617C2B/high-speed-railway-commuter-train.jpg" alt="" loading="lazy" /> : index === 3 ? <img src="/imgs/crane-port.jpg" alt="" loading="lazy" /> : <canvas data-animation="industry" data-variant={index} aria-hidden="true"></canvas>}
                <div class="lp-case-steps">
                  <h3 data-i18n={`home.references.cards.${index}.title`}>{card.title}</h3>
                  <p class="lp-case-steps-title" data-i18n="home.references.stepsTitle">{home.references.stepsTitle}</p>
                  <div class="lp-case-timeline" data-case-timeline>
                  {[card.body, card.highlight, home.references.details[index]].map((description, step) => (
                    <details open={step === 0}>
                      <summary data-i18n={`home.references.steps.${step}`}>{home.references.steps[step]}</summary>
                      <p data-i18n={step === 0 ? `home.references.cards.${index}.body` : step === 1 ? `home.references.cards.${index}.highlight` : `home.references.details.${index}`}>{description}</p>
                    </details>
                  ))}
                  </div>
                </div>
              </div>
            </article>
          ))}
        </div>

      </section>

      <section class="lp-region lp-backers" id="backers" aria-labelledby="backers-title">
        <div class="lp-backers-grid lp-frame" data-reveal>
          <div class="lp-backers-intro">
            <p class="lp-backers-eyebrow" data-i18n="home.redesign.backersEyebrow">{copy.backersEyebrow}</p>
            <h2 id="backers-title" data-i18n="home.redesign.backersTitle">{copy.backersTitle}</h2>
            <p data-i18n="home.redesign.backersLead">{copy.backersLead}</p>
          </div>
          {backerGroups.map((group) => (
            <figure class={`lp-backer lp-backer--${group.variant}`}>
              <figcaption data-i18n={`home.redesign.backersKinds.${group.kind}`}>{copy.backersKinds[group.kind]}</figcaption>
              <ul class="lp-backer-logos">
                {group.logos.map((logo) => (
                  <li class={`lp-backer-logo--${logo.variant}`}>
                    <img class="lp-backer-img--light" src={logo.src} alt={logo.name} width={logo.width} height={logo.height} loading="lazy" decoding="async" />
                    <img class="lp-backer-img--dark" src={logo.dark.src} alt={logo.name} width={logo.dark.width} height={logo.dark.height} loading="lazy" decoding="async" />
                  </li>
                ))}
              </ul>
            </figure>
          ))}
        </div>
      </section>

      <section class="lp-region" id="compare">
        <header class="lp-section-heading" data-reveal><h2 data-i18n="home.redesign.compareTitle">{copy.compareTitle}</h2><p data-i18n="home.redesign.compareLead">{copy.compareLead}</p></header>
        <div class="lp-comparison lp-frame" data-reveal>
          <article class="lp-comparison-side lp-comparison-side--fragmented">
            <h3 data-i18n="home.redesign.beforeTitle">{copy.beforeTitle}</h3><p data-i18n="home.redesign.beforeLead">{copy.beforeLead}</p>
            <div class="lp-fragment-scene" aria-hidden="true">
              <canvas data-animation="fragmented"></canvas>
              {copy.fragmentLabels.map((label, i) => <span class={`lp-fragment lp-fragment--${i}`} data-i18n={`home.redesign.fragmentLabels.${i}`}>{label}</span>)}
            </div>
          </article>
          <article class="lp-comparison-side lp-comparison-side--unified">
            <h3 data-i18n="home.redesign.afterTitle">{copy.afterTitle}</h3><p data-i18n="home.redesign.afterLead">{copy.afterLead}</p>
            <div class="lp-unified-scene" aria-hidden="true"><canvas data-animation="unified"></canvas><img src="/lamassu_logo_white.svg" alt="" width="76" height="76" loading="lazy" /><span data-i18n="home.redesign.unifiedLabel">{copy.unifiedLabel}</span></div>
          </article>
        </div>
        <details class="lp-compare-details"><summary data-i18n="home.redesign.featureMore">{copy.featureMore}</summary><div class="lp-compare-table"><table><thead><tr>{home.compare.headers.map((label, i) => <th scope="col" data-i18n={`home.compare.headers.${i}`}>{label}</th>)}</tr></thead><tbody>{home.compare.rows.map((row, r) => <tr>{row.map((cell, c) => c === 0 ? <th scope="row" data-i18n={`home.compare.rows.${r}.${c}`}>{cell}</th> : <td data-i18n={`home.compare.rows.${r}.${c}`}>{cell}</td>)}</tr>)}</tbody></table></div></details>
      </section>

      <section class="lp-region lp-catalog" id="capabilities">
        <header class="lp-section-heading" data-reveal><h2 data-i18n="home.redesign.productTitle">{copy.productTitle}</h2><p data-i18n="home.redesign.productLead">{copy.productLead}</p></header>
        <TechnicalCapabilities home={home} />
        <div class="lp-deployment" id="deployment">
          <div class="lp-deployment-intro"><h3 data-i18n="home.redesign.deploymentTitle">{copy.deploymentTitle}</h3><p data-i18n="home.redesign.deploymentLead">{copy.deploymentLead}</p></div>
          <div class="lp-deployment-grid">
            {home.deployment.options.map((option, i) => <article class="lp-deployment-option" data-reveal><p class="lp-deployment-name" data-i18n={`home.redesign.deployNames.${i}`}>{copy.deployNames[i]}</p><h3 data-i18n={`home.deployment.options.${i}.title`}>{option.title}</h3><p data-i18n={`home.deployment.options.${i}.body`}>{option.body}</p><ul>{option.chips.map((chip, c) => <li data-i18n={`home.deployment.options.${i}.chips.${c}`}>{chip}</li>)}</ul><dl><dt data-i18n="home.deployment.operatedByLabel">{home.deployment.operatedByLabel}</dt><dd data-i18n={`home.deployment.options.${i}.operatedBy`}>{option.operatedBy}</dd></dl><a class:list={['lp-btn', i === 0 ? 'lp-btn--primary' : 'lp-btn--secondary']} href={option.href} data-i18n-attr-href={`home.deployment.options.${i}.href`} data-i18n={`home.redesign.deployLinks.${i}`}>{copy.deployLinks[i]}</a></article>)}
          </div>
          <p class="lp-deployment-note" data-i18n="home.deployment.keys">{home.deployment.keys}</p>
        </div>
      </section>

      <CryptoEngines />

      <section class="lp-region lp-integrations" id="integrations">
        <header class="lp-section-heading" data-reveal>
          <h2 data-i18n="home.redesign.integrationsTitle">{copy.integrationsTitle}</h2>
          <p data-i18n="home.redesign.integrationsLead">{copy.integrationsLead}</p>
        </header>
        <div class="lp-integration-demo" data-integration-demo data-event="0">
          <div class="lp-integration-layout">
            <div class="lp-integration-steps" role="group" aria-label={copy.integrationEvents} data-i18n-attr-aria-label="home.redesign.integrationEvents">
              {copy.lifecycle.map((label, index) => (
                <button type="button" data-event-step={index} aria-pressed={index === 0 ? 'true' : 'false'} aria-expanded={index === 0 ? 'true' : 'false'} aria-controls={`integration-description-${index}`}>
                  <span class="lp-integration-step-title" data-i18n={`home.redesign.lifecycle.${index}`}>{label}</span>
                  <span class="lp-integration-step-description" id={`integration-description-${index}`} aria-hidden={index !== 0 ? 'true' : 'false'} data-i18n={`home.redesign.lifecycleDescriptions.${index}`}>{copy.lifecycleDescriptions[index]}</span>
                  <i aria-hidden="true"></i>
                </button>
              ))}
            </div>
            <div class="lp-integration-map" role="img" aria-label={copy.integrationDiagram} data-i18n-attr-aria-label="home.redesign.integrationDiagram">
              <div class="lp-integration-node lp-integration-hub">
                <div class="lp-integration-icon"><img class="lp-integration-light" src="/lamassu_logo_blue.svg" alt="" /><img class="lp-integration-dark" src="/lamassu_logo_white.svg" alt="" /></div>
                <strong>Lamassu PKI</strong>
                <span class="lp-integration-event-label">{copy.lifecycle.map((label, index) => <span data-event-label={index} data-i18n={`home.redesign.lifecycle.${index}`}>{label}</span>)}</span>
              </div>
              <div class="lp-integration-segment lp-integration-segment--source" aria-hidden="true"><div class="lp-integration-wire"><i></i></div></div>
              <div class="lp-integration-node lp-integration-connector">
                <div class="lp-integration-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m10 13 4-4m-6 6-1 1a4.24 4.24 0 0 1-6-6l4-4a4.24 4.24 0 0 1 6 0m2 2 1-1a4.24 4.24 0 0 1 6 6l-4 4a4.24 4.24 0 0 1-6 0" transform="translate(1 1)"/></svg></div>
                <strong data-i18n="home.redesign.integrationConnector">{copy.integrationConnector}</strong>
              </div>
              <div class="lp-integration-segment lp-integration-segment--branch" aria-hidden="true"><div class="lp-integration-wire"><i></i></div></div>
              <div class="lp-integration-branch" aria-hidden="true"></div>
              <div class="lp-integration-targets">
                {integrationTargets.map((integration, index) => (
                  <article class:list={['lp-integration-target', `lp-integration-target--${index}`]}>
                    <div class="lp-integration-wire" aria-hidden="true"><i></i></div>
                    <div class:list={['lp-integration-platform', index === 3 && 'lp-integration-platform--thingsboard']}>
                      <div class="lp-integration-icon">
                        <span class="lp-integration-logo">
                          <img class="lp-integration-light" src={integration.light} alt="" /><img class="lp-integration-dark" src={integration.dark} alt="" />
                        </span>
                        <span class="lp-integration-badge" aria-hidden="true">
                          <svg data-badge="0" viewBox="0 0 16 16"><path d="m4 8.4 2.6 2.6L12 5.4" /></svg>
                          <svg data-badge="1" viewBox="0 0 16 16"><path d="M12.2 6.6A4.4 4.4 0 0 0 4.3 5.5M3.8 9.4a4.4 4.4 0 0 0 7.9 1.1M4 3v2.7h2.7M12 13v-2.7H9.3" /></svg>
                          <svg data-badge="2" viewBox="0 0 16 16"><path d="m5 5 6 6m0-6-6 6" /></svg>
                        </span>
                      </div>
                      <strong>{integration.name}</strong>
                      {index === 2 && <span class="lp-integration-coming-soon" data-i18n="home.redesign.integrationComingSoon">{copy.integrationComingSoon}</span>}
                    </div>
                  </article>
                ))}
              </div>
            </div>
          </div>
          <span class="lp-integration-clock" aria-hidden="true"></span>
        </div>
      </section>

      <section class="lp-region lp-operations" id="operations">
        <header class="lp-section-heading" data-reveal><h2 data-i18n="home.redesign.operationsTitle">{copy.operationsTitle}</h2><p data-i18n="home.redesign.operationsLead">{copy.operationsLead}</p></header>
        <div class="lp-team-grid lp-frame">
          <article class="lp-team-workflow" data-reveal><div class="lp-workflow-scene" aria-hidden="true"><canvas data-animation="workflow"></canvas><div class="lp-workflow-steps">{copy.workflowSteps.map((step, i) => <span data-i18n={`home.redesign.workflowSteps.${i}`}>{step}</span>)}</div></div><div><h3 data-i18n="home.redesign.workflowTitle">{copy.workflowTitle}</h3><p data-i18n="home.redesign.workflowLead">{copy.workflowLead}</p><a class="lp-link" href="https://lab.lamassu.io" data-i18n="home.redesign.consoleLink">{copy.consoleLink}</a></div></article>
          <article class="lp-team-open" data-reveal><span class="lp-code-symbol" aria-hidden="true">&lt;/&gt;</span><h3 data-i18n="home.ops.tiles.1.title">{home.ops.tiles[1].title}</h3><p data-i18n="home.ops.tiles.1.body">{home.ops.tiles[1].body}</p><a class="lp-link" href="https://github.com/lamassuiot" target="_blank" rel="noopener" data-i18n="home.redesign.sourceLink">{copy.sourceLink}</a></article>
          {home.ops.tiles.slice(2).map((tile, i) => <article class:list={['lp-team-feature', `lp-team-feature--${i}`]} data-reveal><div class="lp-feature-scene" aria-hidden="true"><canvas data-animation={['access', 'audit', 'integration'][i]}></canvas></div><div><h3 data-i18n={`home.ops.tiles.${i + 2}.title`}>{tile.title}</h3><p data-i18n={`home.ops.tiles.${i + 2}.body`}>{tile.body}</p></div></article>)}
        </div>
      </section>

      <section class="lp-region lp-quantum" id="pqc">
        <div class="lp-quantum-visual" aria-hidden="true"><img src="/media/lamassu-quantum.webp" width="1672" height="941" alt="" loading="lazy" /><canvas data-animation="quantum"></canvas></div>
        <div class="lp-quantum-intro" data-reveal><p class="lp-experimental" data-i18n="home.pqc.badge">{home.pqc.badge}</p><h2 data-i18n="home.redesign.pqcTitle">{copy.pqcTitle}</h2><p data-i18n="home.redesign.pqcLead">{copy.pqcLead}</p><a class="lp-btn lp-btn--primary" href="#contact" data-i18n="home.pqc.ctaPrimary">{home.pqc.ctaPrimary}</a></div>
        <ol class="lp-quantum-path">{home.pqc.certs.map((cert, i) => <li data-reveal><h3 data-i18n={`home.pqc.certs.${i}.name`}>{cert.name}</h3><p class="lp-quantum-algorithm">{['RSA · ECDSA', 'RSA / ECDSA + ML-DSA', 'ML-DSA · SLH-DSA'][i]}</p><p data-i18n={`home.pqc.certs.${i}.body`}>{cert.body}</p></li>)}</ol>
        <p class="lp-quantum-note" data-i18n="home.pqc.note">{home.pqc.note}</p>
      </section>

      <section class="lp-region lp-faq" id="faq"><div class="lp-faq-intro" data-reveal><h2 data-i18n="home.redesign.faqTitle">{copy.faqTitle}</h2><p data-i18n="home.faq.lead">{home.faq.lead}</p></div><div class="lp-questions">{home.faq.items.map((item, i) => <details><summary data-i18n={`home.faq.items.${i}.q`}>{item.q}</summary><p data-i18n={`home.faq.items.${i}.a`}>{item.a}</p></details>)}</div></section>
    </div>

    <section class="lp-finale" id="contact"><canvas data-animation="closing" aria-hidden="true"></canvas><div class="lp-wrap" data-reveal><h2 data-i18n="home.redesign.closingTitle">{copy.closingTitle}</h2><p data-i18n="home.redesign.closingLead">{copy.closingLead}</p><div class="lp-actions"><a href="mailto:info@lamassu.io" class="lp-btn lp-btn--white" data-i18n="home.cta.left.btn">{home.cta.left.btn}</a><a href={copy.docsHref} data-i18n-attr-href="home.redesign.docsHref" class="lp-btn lp-btn--outline-white" data-i18n="home.redesign.closingDocs">{copy.closingDocs}</a></div><ul>{copy.closingProof.map((proof, i) => <li data-i18n={`home.redesign.closingProof.${i}`}>{proof}</li>)}</ul></div></section>
  </main>
  <script>
    // Every panel is readable without JavaScript. Enhance each group independently.
    document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((group) => {
      const list = group.querySelector<HTMLElement>('[data-tab-list]');
      const tabs = Array.from(group.querySelectorAll<HTMLButtonElement>('[data-tab]'));
      const panels = Array.from(group.querySelectorAll<HTMLElement>('[data-tab-panel]'));
      if (!list || !tabs.length || tabs.length !== panels.length) return;
      group.classList.add('has-tabs');
      list.hidden = false;
      list.setAttribute('role', 'tablist');
      const select = (index: number, focus = false) => {
        tabs.forEach((tab, i) => {
          const active = i === index;
          tab.setAttribute('role', 'tab');
          tab.setAttribute('aria-selected', String(active));
          tab.tabIndex = active ? 0 : -1;
          panels[i].setAttribute('role', 'tabpanel');
          panels[i].tabIndex = 0;
          panels[i].hidden = !active;
        });
        if (focus) tabs[index].focus();
      };
      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => select(index));
        tab.addEventListener('keydown', (event) => {
          let next = index;
          if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
          else if (event.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
          else if (event.key === 'Home') next = 0;
          else if (event.key === 'End') next = tabs.length - 1;
          else return;
          event.preventDefault();
          select(next, true);
        });
      });
      const syncHash = () => {
        const index = panels.findIndex((panel) => '#' + panel.id === window.location.hash);
        if (index < 0) return;
        select(index);
        requestAnimationFrame(() => panels[index].scrollIntoView({ block: 'start' }));
      };
      select(0);
      syncHash();
      window.addEventListener('hashchange', syncHash);
      // A repeated link to the current hash must still reveal its panel.
      document.querySelectorAll<HTMLAnchorElement>('a[href^="#"], a[href^="/#"]').forEach((link) => {
        link.addEventListener('click', () => {
          const index = panels.findIndex((panel) => '#' + panel.id === link.hash);
          if (index >= 0) select(index);
        });
      });
    });

    document.querySelectorAll<HTMLElement>('[data-case-timeline]').forEach((timeline) => {
      const steps = Array.from(timeline.querySelectorAll<HTMLDetailsElement>('details'));
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      let selected = steps.find((step) => step.open) ?? steps[0];
      const animations = new WeakMap<HTMLDetailsElement, Animation>();

      steps.forEach((step) => {
        const summary = step.querySelector('summary');
        const selectStep = () => {
          if (step === selected) return;
          const previous = selected;
          selected = step;
          animations.get(previous)?.cancel();
          animations.get(step)?.cancel();
          steps.forEach((item) => { if (item !== previous && item !== step) item.open = false; });

          if (reducedMotion.matches) {
            previous.open = false;
            step.open = true;
            return;
          }

          const oldText = previous.querySelector('p');
          const newText = step.querySelector('p');
          if (!oldText || !newText) {
            previous.open = false;
            step.open = true;
            return;
          }
          step.open = true;
          const options: KeyframeAnimationOptions = { duration: 320, easing: 'ease-in-out', fill: 'both' };
          const close = previous.animate([{ height: `${previous.offsetHeight}px`, opacity: 1 }, { height: `${previous.querySelector('summary')?.offsetHeight ?? 0}px`, opacity: .7 }], options);
          const open = step.animate([{ height: `${step.querySelector('summary')?.offsetHeight ?? 0}px` }, { height: `${step.offsetHeight}px` }], options);
          newText.animate([{ opacity: 0 }, { opacity: 1 }], options);
          animations.set(previous, close);
          animations.set(step, open);
          close.onfinish = () => { if (selected !== previous) previous.open = false; close.cancel(); };
          open.onfinish = () => open.cancel();
        };
        summary?.addEventListener('click', (event) => { event.preventDefault(); selectStep(); });
        summary?.addEventListener('pointerenter', (event) => { if (event.pointerType === 'mouse') selectStep(); });
        summary?.addEventListener('focus', selectStep);
      });
    });

    import '../scripts/landing-motion';
    import '../scripts/integration-demo';
  </script>
</SiteLayout>
