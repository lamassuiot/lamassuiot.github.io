          <article class="lp-tile">
            <svg class="lp-icon" viewBox="0 0 24 24" aria-hidden="true" set:html={icons.users} />
            <div class="lp-tile-text">
              <h3 data-i18n="home.ops.tiles.2.title">{home.ops.tiles[2].title}</h3>
