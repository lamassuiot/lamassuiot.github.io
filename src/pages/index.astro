---
import SiteLayout from '../layouts/SiteLayout.astro';
import { homeTranslations } from '../lib/i18n';

const home = homeTranslations.es.home;
const referenceLinks = [
  '/ferroviario/',
  '/hosteleria-conectada/',
  '/energia-baterias/',
  '/gruas/',
  '/puertas-de-acceso-conectadas/',
];
---

<SiteLayout
  title={homeTranslations.es.meta.title}
  lang="es"
  activeNav="home"
  pageTranslations={homeTranslations}
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <style is:global>
      :root {
        --home-bg: #09111f;
        --home-surface: #10192c;
        --home-surface-soft: #15233a;
        --home-border: #243550;
        --home-title: #edf3ff;
        --home-text: #bcc9df;
        --home-muted: #8fa1c3;
        --home-accent: #7e9cff;
        --home-accent-text: #08101e;
      }

      [data-theme='light'] {
        --home-bg: #f4f6fa;
        --home-surface: #ffffff;
        --home-surface-soft: #f6f8fd;
        --home-border: #d8deeb;
        --home-title: #0f1728;
        --home-text: #36455f;
        --home-muted: #5f6e8c;
        --home-accent: #405fff;
        --home-accent-text: #ffffff;
      }

      body {
        font-family: 'Manrope', sans-serif;
      }

      .home-page {
        width: min(1360px, calc(100% - 48px));
        margin: 0 auto;
        position: relative;
      }

      .home-page::before {
        content: '';
        position: absolute;
        top: 0;
        bottom: 0;
        left: 50%;
        width: 100vw;
        transform: translateX(-50%);
        pointer-events: none;
        background-image: radial-gradient(circle, rgba(143, 165, 228, 0.38) 1px, transparent 1px);
        background-size: 16px 16px;
        opacity: 0.3;
        mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.72) 0%, rgba(0, 0, 0, 0.24) 48%, transparent 84%);
        z-index: 0;
      }

      [data-theme='light'] .home-page::before {
        background-image: radial-gradient(circle, rgba(37, 55, 95, 0.34) 1px, transparent 1px);
        opacity: 0.31;
      }

      .home-page > * {
        position: relative;
        z-index: 1;
      }

      .home-hero {
        padding: 72px 0 56px;
        display: grid;
        gap: 16px;
      }

      .home-kicker {
        margin: 0;
        font-family: 'JetBrains Mono', monospace;
        font-size: 12px;
        letter-spacing: 0.06em;
        color: var(--home-muted);
      }

      .home-hero h1 {
        margin: 0;
        color: var(--home-title);
        font-size: clamp(38px, 7vw, 72px);
        line-height: 1.02;
        letter-spacing: -0.03em;
      }

      .home-lead {
        margin: 0;
        color: var(--home-text);
        font-size: clamp(17px, 2.2vw, 21px);
        line-height: 1.5;
      }

      .home-actions {
        margin-top: 8px;
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
      }

      .home-btn {
        text-decoration: none;
        border: 1px solid var(--home-border);
        background: var(--home-surface);
        color: var(--home-title);
        border-radius: 8px;
        padding: 10px 14px;
        font-size: 14px;
        font-weight: 600;
        transition: border-color 0.15s ease, background-color 0.15s ease;
      }

      .home-btn:hover {
        border-color: var(--home-muted);
      }

      .home-btn-primary {
        background: var(--home-accent);
        border-color: transparent;
        color: var(--home-accent-text);
      }

      .home-btn-primary:hover {
        background: #95adff;
      }

      [data-theme='light'] .home-btn-primary:hover {
        background: #334ffc;
      }

      .home-stack {
        margin-top: 14px;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }

      .home-stack span {
        border: 1px solid var(--home-border);
        border-radius: 6px;
        padding: 6px 8px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        color: var(--home-muted);
        background: var(--home-surface);
      }

      .home-mesh-band {
        margin-top: 14px;
        height: 170px;
        border: 1px solid rgba(98, 132, 235, 0.56);
        border-radius: 12px;
        background: linear-gradient(90deg, #5a1ff0 0%, #4d41f6 40%, #3d78f6 70%, #4ac2f5 100%);
        position: relative;
        overflow: hidden;
      }

      .home-mesh-band::before {
        content: '';
        position: absolute;
        inset: 0;
        background:
          linear-gradient(0deg, rgba(255, 255, 255, 0.12) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255, 255, 255, 0.11) 1px, transparent 1px);
        background-size: 100% 34px, 88px 100%;
        opacity: 0.28;
      }

      .home-mesh-shot-line {
        position: absolute;
        left: 6%;
        right: calc(8% + 300px);
        top: 50%;
        height: 18px;
        transform: translateY(-50%);
        overflow: visible;
        pointer-events: none;
      }

      .home-mesh-projectile {
        --mesh-shot-size: 10px;
        position: absolute;
        top: 50%;
        left: 0;
        width: var(--mesh-shot-size);
        height: var(--mesh-shot-size);
        border-radius: 50%;
        transform: translateY(-50%);
        background: #effcff;
        box-shadow:
          0 0 0 4px rgba(170, 244, 255, 0.18),
          0 0 18px rgba(170, 244, 255, 0.95);
        animation: homeMeshProjectile 3.4s linear infinite;
      }

      .home-mesh-projectile::before {
        content: '';
        position: absolute;
        top: 50%;
        right: 4px;
        width: 120px;
        height: 2px;
        transform: translateY(-50%);
        background: linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(188, 244, 255, 0.4) 42%, rgba(239, 252, 255, 0.9) 100%);
        filter: blur(1px);
      }

      .home-mesh-projectile::after {
        content: '';
        position: absolute;
        top: 50%;
        right: 0;
        width: 56px;
        height: 1px;
        transform: translateY(-50%);
        background: linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(239, 252, 255, 0.92));
      }

      .home-mesh-sweep {
        position: absolute;
        width: 62%;
        height: 240%;
        left: -18%;
        top: -72%;
        background: radial-gradient(circle, rgba(131, 255, 255, 0.36) 0%, rgba(131, 255, 255, 0.06) 34%, rgba(131, 255, 255, 0) 70%);
        transform-origin: 80% 72%;
        animation: homeMeshSweep 7s linear infinite;
        pointer-events: none;
      }

      .home-mesh-label {
        margin: 0;
        color: rgba(230, 246, 255, 0.74);
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        letter-spacing: 0.08em;
        text-align: center;
      }

      .home-mesh-numbers {
        position: absolute;
        top: 14px;
        right: 18px;
        margin: 0;
        color: rgba(230, 246, 255, 0.58);
        font-family: 'JetBrains Mono', monospace;
        font-size: 22px;
        letter-spacing: 0.06em;
      }

      .home-mesh-hud {
        position: absolute;
        right: 8%;
        top: 50%;
        transform: translateY(-50%);
        width: 300px;
        height: 300px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        border: 2px solid rgba(119, 240, 255, 0.52);
        box-shadow:
          0 0 0 34px rgba(26, 227, 255, 0.12),
          0 0 0 70px rgba(23, 188, 255, 0.09);
        background: radial-gradient(circle, rgba(36, 221, 255, 0.24) 0%, rgba(37, 145, 255, 0.08) 52%, rgba(37, 145, 255, 0) 72%);
        overflow: visible;
      }

      .home-mesh-hud::before,
      .home-mesh-hud::after {
        content: '';
        position: absolute;
        border-radius: 50%;
        inset: -4px;
        border: 4px solid rgba(196, 250, 255, 0.68);
        opacity: 0;
      }

      .home-mesh-hud::before {
        animation: homeMeshImpactRing 3.4s cubic-bezier(0.2, 0.8, 0.2, 1) infinite;
      }

      .home-mesh-hud::after {
        animation: homeMeshImpactGlow 3.4s ease-out infinite;
      }

      .home-mesh-hud-content {
        display: grid;
        justify-items: center;
        gap: 16px;
      }

      .home-mesh-hud-core {
        width: 108px;
        height: 108px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        background: transparent;
      }

      .home-mesh-logo {
        width: 68px;
        height: auto;
        display: block;
      }

      .home-section {
        padding-top: 108px;
      }

      .home-section + .home-section {
        padding-top: 156px;
      }

      .home-section#outcomes {
        padding-top: 56px;
      }

      .home-section h2 {
        margin: 0;
        color: var(--home-title);
        font-size: clamp(28px, 5vw, 48px);
        line-height: 1.08;
        letter-spacing: -0.03em;
      }

      .home-section > p {
        margin: 12px 0 0;
        color: var(--home-text);
        font-size: 17px;
        line-height: 1.56;
      }

      .home-blue-divider {
        border: none;
        height: 3px;
        background: #555efc;
        margin: 0 0 26px;
        border-radius: 2px;
      }

      .home-overview-showcase {
        margin-top: 22px;
        display: grid;
        grid-template-columns: minmax(0, 1.7fr) minmax(260px, 0.9fr);
        gap: 20px;
        align-items: stretch;
      }

      .home-overview-figure {
        margin: 0;
      }

      .home-overview-figure img {
        display: block;
        width: 100%;
        height: auto;
        border-radius: 12px;
      }

      .home-overview-meta {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: clamp(32px, 4vh, 56px);
        height: 100%;
      }

      .home-overview-block {
        display: grid;
        gap: 10px;
        border-left: 1px solid var(--home-border);
        padding-left: 16px;
      }

      .home-overview-meta p {
        margin: 0;
        color: var(--home-text);
        line-height: 1.58;
        font-size: 14px;
      }

      .home-overview-meta-title {
        color: var(--home-title) !important;
        font-size: 16px !important;
        font-weight: 700;
      }

      .home-capabilities-shell {
        margin-top: 24px;
        display: grid;
        gap: 22px;
        align-items: start;
      }

      .home-capabilities-heading {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 24px;
        padding-bottom: 10px;
      }

      .home-capabilities-heading h2 {
        max-width: none;
      }

      .home-capabilities-heading::after {
        content: '';
        width: min(36vw, 320px);
        height: 2px;
        background: linear-gradient(90deg, var(--home-accent) 0%, rgba(126, 156, 255, 0.14) 100%);
        flex: 0 0 auto;
        transform: translateY(-6px);
      }

      .feature-plain-list {
        margin: 0;
        padding: 0;
        list-style: none;
        counter-reset: capabilities;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        column-gap: 36px;
        row-gap: 16px;
      }

      .feature-plain-list li {
        counter-increment: capabilities;
        position: relative;
        padding: 22px 24px 22px 68px;
        background: var(--home-surface-soft);
        border-radius: 10px;
        color: var(--home-text);
        font-size: 15px;
        line-height: 1.62;
      }

      .feature-plain-list li::before {
        content: counter(capabilities, decimal-leading-zero);
        color: var(--home-accent);
        font-family: 'JetBrains Mono', monospace;
        font-size: 12px;
        font-weight: 700;
        line-height: 1;
        letter-spacing: 0.08em;
        position: absolute;
        left: 24px;
        top: 26px;
      }

      .feature-plain-list strong {
        display: block;
        margin-bottom: 8px;
        color: var(--home-title);
        font-size: 17px;
        line-height: 1.3;
      }

      .stack-subheadline {
        margin-top: 12px;
        color: var(--home-muted) !important;
      }

      .stack-rows {
        margin-top: 20px;
        border-top: 1px solid var(--home-border);
      }

      .stack-row {
        display: grid;
        grid-template-columns: minmax(280px, 0.85fr) 1.4fr;
        gap: 22px;
        align-items: start;
        padding: 16px 0;
        border-bottom: 1px solid var(--home-border);
      }

      .stack-title {
        margin: 0;
        display: flex;
        align-items: flex-start;
        gap: 10px;
        color: var(--home-title);
        font-size: 18px;
        line-height: 1.35;
      }

      .stack-icon {
        width: 16px;
        height: 16px;
        margin-top: 4px;
        border: 1.5px solid var(--home-muted);
        border-radius: 4px;
        flex: 0 0 16px;
        position: relative;
      }

      .stack-icon::after {
        content: '';
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--home-accent);
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
      }

      .stack-row p {
        margin: 0;
        color: var(--home-text);
        font-size: 15px;
        line-height: 1.55;
      }

      .home-references-head {
        display: grid;
        gap: 14px;
        max-width: 980px;
      }

      .home-references-subtitle {
        margin: 0;
        color: var(--home-text);
        font-size: clamp(18px, 2.2vw, 22px);
        line-height: 1.6;
      }

      .home-references-panel {
        margin-top: 28px;
        padding-top: 0;
      }

      .home-references-tags {
        margin-top: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 10px 20px;
        padding-bottom: 14px;
        border-bottom: 1px solid var(--home-border);
      }

      .home-reference-tag {
        padding: 0 0 10px;
        color: var(--home-muted);
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        line-height: 1.3;
        border-bottom: 2px solid transparent;
        transition: color 0.16s ease, border-color 0.16s ease;
      }

      .home-reference-tag:hover {
        color: var(--home-title);
        border-bottom-color: var(--home-accent);
      }

      .home-references-grid {
        margin-top: 18px;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
      }

      .home-reference-card {
        min-height: 0;
        padding: 20px;
        display: grid;
        align-content: start;
        gap: 14px;
        border-radius: 10px;
        border: 1px solid var(--home-border);
        background: var(--home-surface);
        text-decoration: none;
        transition: border-color 0.16s ease, background-color 0.16s ease;
      }

      .home-reference-card:hover {
        border-color: rgba(143, 161, 195, 0.5);
        background: var(--home-surface-soft);
      }

      .home-reference-sector {
        margin: 0;
        color: var(--home-muted);
        font-size: 13px;
        font-weight: 600;
        line-height: 1.4;
      }

      .home-reference-title {
        margin: 2px 0 0;
        color: var(--home-title);
        font-size: clamp(24px, 2.7vw, 30px);
        line-height: 1.18;
        letter-spacing: -0.03em;
      }

      .home-reference-highlight {
        margin: 0;
        color: var(--home-title);
        font-size: 16px;
        line-height: 1.5;
        font-weight: 700;
      }

      .home-reference-body {
        margin: 0;
        color: var(--home-text);
        font-size: 16px;
        line-height: 1.6;
      }

      .home-reference-link {
        margin-top: auto;
        display: inline-flex;
        align-items: center;
        width: fit-content;
        color: var(--home-title);
        font-size: 14px;
        font-weight: 600;
        line-height: 1.2;
        text-decoration: underline;
        text-underline-offset: 3px;
      }

      /* Feature Cards */
      .home-features-grid {
        margin-top: 32px;
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 14px;
      }

      .home-feature-card {
        display: flex;
        flex-direction: column;
        gap: 16px;
        padding: 24px;
        border-radius: 14px;
        border: 1px solid var(--home-border);
        background: var(--home-surface);
        min-height: 320px;
      }

      .home-feature-card--featured {
        background: var(--home-accent);
        border-color: transparent;
      }

      .home-feature-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: grid;
        place-items: center;
        border: 1px solid var(--home-border);
        background: var(--home-surface-soft);
        color: var(--home-accent);
        flex-shrink: 0;
      }

      .home-feature-card--featured .home-feature-icon {
        background: rgba(0, 0, 0, 0.18);
        border-color: rgba(0, 0, 0, 0.12);
        color: var(--home-accent-text);
      }

      .home-feature-icon svg {
        width: 20px;
        height: 20px;
      }

      .home-feature-tag {
        margin: 0;
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        letter-spacing: 0.08em;
        color: var(--home-muted);
      }

      .home-feature-card--featured .home-feature-tag {
        color: var(--home-accent-text);
        opacity: 0.65;
      }

      .home-feature-title {
        margin: 0;
        color: var(--home-title);
        font-size: 18px;
        font-weight: 800;
        line-height: 1.2;
        letter-spacing: -0.02em;
        flex: 1;
      }

      .home-feature-card--featured .home-feature-title {
        color: var(--home-accent-text);
        font-size: 20px;
      }

      .home-feature-body {
        margin: 0;
        color: var(--home-text);
        font-size: 13px;
        line-height: 1.6;
      }

      .home-feature-card--featured .home-feature-body {
        color: var(--home-accent-text);
        opacity: 0.8;
      }

      .home-feature-link {
        margin-top: auto;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        width: fit-content;
        padding: 9px 16px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        transition: background 0.15s ease, opacity 0.15s ease;
        background: var(--home-accent-text);
        color: var(--home-accent);
        border: none;
      }

      .home-feature-card--featured .home-feature-link {
        background: var(--home-accent-text);
        color: var(--home-accent);
      }

      .home-feature-card:not(.home-feature-card--featured) .home-feature-link {
        background: var(--home-surface-soft);
        color: var(--home-title);
        border: 1px solid var(--home-border);
      }

      .home-feature-link:hover {
        opacity: 0.85;
      }

      @media (max-width: 1100px) {
        .home-features-grid {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }
      }

      @media (max-width: 680px) {
        .home-features-grid {
          grid-template-columns: repeat(5, 240px);
          overflow-x: auto;
          scroll-snap-type: x mandatory;
          padding-bottom: 8px;
          margin-left: calc(-1 * (100vw - 100%) / 2);
          padding-left: calc((100vw - 100%) / 2);
          width: 100vw;
        }

        .home-feature-card {
          scroll-snap-align: start;
          min-height: 300px;
        }
      }

      /* CTA Section */
      .home-cta-grid {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: 16px;
      }

      .home-cta-card {
        border-radius: 16px;
        padding: clamp(28px, 4vw, 44px);
        display: flex;
        flex-direction: column;
        gap: 18px;
        min-height: 260px;
      }

      .home-cta-card--blue {
        background: linear-gradient(135deg, #3a6abf 0%, #2550a8 52%, #1a3d8f 100%);
        border: 1px solid rgba(80, 130, 220, 0.45);
      }

      .home-cta-card--purple {
        background: radial-gradient(ellipse at 68% 24%, #7a3db8 0%, #5a22a0 48%, #3d1080 100%);
        border: 1px solid rgba(130, 70, 200, 0.45);
      }

      .home-cta-card .home-cta-eyebrow {
        margin: 0;
        color: rgba(200, 220, 255, 0.65);
        font-size: 12px;
        font-family: 'JetBrains Mono', monospace;
        letter-spacing: 0.08em;
      }

      .home-cta-card .home-cta-heading {
        margin: 0;
        color: #edf3ff;
        font-size: clamp(22px, 2.8vw, 32px);
        line-height: 1.14;
        letter-spacing: -0.025em;
        font-weight: 800;
        flex: 1;
      }

      .home-cta-btn-wrap {
        margin-top: auto;
      }

      .home-cta-btn {
        display: inline-flex;
        align-items: center;
        background: rgba(255, 255, 255, 0.14);
        border: 1px solid rgba(255, 255, 255, 0.24);
        color: #edf3ff;
        border-radius: 8px;
        padding: 11px 20px;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        font-family: 'Manrope', sans-serif;
        transition: background 0.15s ease, border-color 0.15s ease;
      }

      .home-cta-btn:hover {
        background: rgba(255, 255, 255, 0.24);
        border-color: rgba(255, 255, 255, 0.4);
      }

      .home-cta-form {
        display: grid;
        gap: 10px;
        margin-top: auto;
      }

      .home-cta-input {
        width: 100%;
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 8px;
        padding: 12px 16px;
        color: #edf3ff;
        font-size: 14px;
        font-family: 'Manrope', sans-serif;
        outline: none;
        box-sizing: border-box;
        transition: border-color 0.15s ease, background 0.15s ease;
      }

      .home-cta-input::placeholder {
        color: rgba(200, 220, 255, 0.45);
      }

      .home-cta-input:focus {
        border-color: rgba(255, 255, 255, 0.4);
        background: rgba(255, 255, 255, 0.16);
      }

      .home-cta-submit {
        width: 100%;
        background: rgba(255, 255, 255, 0.14);
        border: 1px solid rgba(255, 255, 255, 0.22);
        border-radius: 8px;
        padding: 12px 16px;
        color: #edf3ff;
        font-size: 14px;
        font-weight: 700;
        font-family: 'Manrope', sans-serif;
        cursor: pointer;
        transition: background 0.15s ease, border-color 0.15s ease;
      }

      .home-cta-submit:hover {
        background: rgba(255, 255, 255, 0.24);
        border-color: rgba(255, 255, 255, 0.38);
      }

      @keyframes homeMeshSweep {
        from {
          transform: rotate(0deg);
        }
        to {
          transform: rotate(360deg);
        }
      }

      @keyframes homeMeshProjectile {
        0% {
          left: 0;
          transform: translateY(-50%) scale(0.85);
          opacity: 0;
        }
        6% {
          opacity: 1;
        }
        38% {
          left: calc(100% - var(--mesh-shot-size));
          transform: translateY(-50%) scale(1);
          opacity: 1;
        }
        46% {
          left: calc(100% - var(--mesh-shot-size));
          transform: translateY(-50%) scale(0.9);
          opacity: 0;
        }
        100% {
          left: calc(100% - var(--mesh-shot-size));
          transform: translateY(-50%) scale(0.9);
          opacity: 0;
        }
      }

      @keyframes homeMeshImpactRing {
        0%,
        38% {
          transform: scale(0.94);
          opacity: 0;
        }
        46% {
          opacity: 0.82;
        }
        78% {
          transform: scale(1.2);
          opacity: 0;
        }
        100% {
          transform: scale(1.2);
          opacity: 0;
        }
      }

      @keyframes homeMeshImpactGlow {
        0%,
        38% {
          box-shadow: 0 0 0 0 rgba(186, 248, 255, 0);
          opacity: 0;
        }
        46% {
          opacity: 0.72;
        }
        76% {
          box-shadow: 0 0 0 24px rgba(186, 248, 255, 0);
          opacity: 0;
        }
        100% {
          box-shadow: 0 0 0 24px rgba(186, 248, 255, 0);
          opacity: 0;
        }
      }



      @media (max-width: 1100px) {
        .home-page {
          width: min(1360px, calc(100% - 28px));
        }

        .home-capabilities-heading::after {
          width: min(28vw, 220px);
        }

        .feature-plain-list {
          grid-template-columns: 1fr;
          column-gap: 0;
        }

        .home-references-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .home-mesh-numbers {
          display: none;
        }
      }

      @media (max-width: 860px) {
        .home-cta-grid {
          grid-template-columns: 1fr;
        }

        .home-overview-showcase,
        .stack-row,
        .home-references-grid {
          grid-template-columns: 1fr;
          gap: 22px;
        }

        .home-overview-meta {
          display: grid;
          justify-content: initial;
          border-top: 1px solid var(--home-border);
          gap: 20px;
          height: auto;
          padding-top: 14px;
        }

        .home-overview-block {
          padding-left: 14px;
        }

        .home-mesh-band {
          height: 128px;
        }

        .home-mesh-shot-line {
          right: calc(2% + 170px);
        }

        .home-mesh-projectile {
          --mesh-shot-size: 8px;
        }

        .home-mesh-projectile::before {
          width: 78px;
        }

        .home-mesh-projectile::after {
          width: 34px;
        }

        .home-mesh-hud {
          width: 170px;
          height: 170px;
          right: 2%;
          box-shadow:
            0 0 0 18px rgba(26, 227, 255, 0.1),
            0 0 0 38px rgba(23, 188, 255, 0.08);
        }

        .home-mesh-hud-content {
          gap: 10px;
        }

        .home-mesh-hud-core {
          width: 72px;
          height: 72px;
        }

        .home-mesh-logo {
          width: 42px;
        }

        .home-mesh-label {
          font-size: 8px;
        }

        .home-hero {
          justify-items: center;
          text-align: center;
        }

        .home-actions,
        .home-stack {
          justify-content: center;
        }

        .home-reference-card {
          min-height: 0;
        }
      }

      @media (max-width: 640px) {
        .home-page {
          width: calc(100% - 20px);
        }

        .home-capabilities-heading {
          display: grid;
          align-items: start;
          gap: 14px;
        }

        .home-capabilities-heading::after {
          width: 120px;
          transform: none;
        }

        .feature-plain-list li {
          padding: 18px 18px 18px 54px;
        }

        .feature-plain-list li::before {
          left: 18px;
          top: 22px;
        }

        .feature-plain-list strong {
          font-size: 16px;
        }

        .home-hero {
          padding-top: 42px;
          padding-bottom: 40px;
        }

        .home-lead,
        .home-section > p,
        .community-block p {
          font-size: 16px;
        }

        .home-section {
          padding-top: 72px;
        }

        .home-section + .home-section {
          padding-top: 92px;
        }

        .home-section#outcomes {
          padding-top: 20px;
        }

        .home-references-panel {
          margin-top: 22px;
        }

        .home-reference-tag {
          font-size: 13px;
        }

        .home-reference-title {
          font-size: 24px;
        }

        .home-reference-highlight,
        .home-reference-body {
          font-size: 16px;
        }

        .quick-links {
          gap: 8px 14px;
        }

        .quick-links a {
          font-size: 14px;
        }
      }
    </style>
  </Fragment>

  <main class="home-page">
    <section class="home-hero" id="home">
      <p class="home-kicker" data-i18n="home.hero.kicker">{home.hero.kicker}</p>
      <h1 data-i18n="home.hero.title">{home.hero.title}</h1>
      <p class="home-lead" data-i18n="home.hero.lead">{home.hero.lead}</p>
      <div class="home-actions">
        <a class="home-btn home-btn-primary" href="#capabilities" data-i18n="home.hero.ctaPrimary">{home.hero.ctaPrimary}</a>
        <a class="home-btn" href="#outcomes" data-i18n="home.hero.ctaSecondary">{home.hero.ctaSecondary}</a>
      </div>
      <div class="home-stack" aria-label={home.hero.stackAria} data-i18n-attr-aria-label="home.hero.stackAria">
        <span>PKI</span>
        <span>Device Identity</span>
        <span>Secure Software Updates</span>
        <span>Code Sign</span>
      </div>
    </section>

    <section class="home-mesh-band" aria-hidden="true">
      <div class="home-mesh-shot-line">
        <div class="home-mesh-projectile"></div>
      </div>
      <div class="home-mesh-sweep"></div>
      <p class="home-mesh-numbers">89 24</p>
      <div class="home-mesh-hud">
        <div class="home-mesh-hud-content">
          <p class="home-mesh-label">LAMASSU TRUSTED MESH</p>
          <div class="home-mesh-hud-core">
            <img class="home-mesh-logo" src="/lamassu_logo_white.svg" alt="" />
          </div>
        </div>
      </div>
    </section>

    <section class="home-section" id="overview">
      <h2 data-i18n="home.overview.title">{home.overview.title}</h2>
      <p data-i18n="home.overview.body">{home.overview.body}</p>

      <div class="home-overview-showcase">
        <figure class="home-overview-figure">
          <img
            src="/dashboard.png"
            alt={home.overview.imageAlt}
            loading="lazy"
            data-i18n-attr-alt="home.overview.imageAlt"
          />
        </figure>
        <aside class="home-overview-meta">
          {home.overview.blocks.map((block, index) => (
            <div class="home-overview-block">
              <p class="home-overview-meta-title" data-i18n={`home.overview.blocks.${index}.title`}>{block.title}</p>
              <p data-i18n={`home.overview.blocks.${index}.body1`}>{block.body1}</p>
              {block.body2 && <p data-i18n={`home.overview.blocks.${index}.body2`}>{block.body2}</p>}
            </div>
          ))}
        </aside>
      </div>
    </section>

    <section class="home-section" id="outcomes">
      <div class="home-cta-grid">
        <div class="home-cta-card home-cta-card--blue">
          <p class="home-cta-eyebrow" data-i18n="home.cta.left.eyebrow">{home.cta.left.eyebrow}</p>
          <h2 class="home-cta-heading" data-i18n="home.cta.left.heading">{home.cta.left.heading}</h2>
          <div class="home-cta-btn-wrap">
            <a href="#capabilities" class="home-cta-btn" data-i18n="home.cta.left.btn">{home.cta.left.btn}</a>
          </div>
        </div>
        <div class="home-cta-card home-cta-card--purple">
          <p class="home-cta-eyebrow" data-i18n="home.cta.right.eyebrow">{home.cta.right.eyebrow}</p>
          <h2 class="home-cta-heading" data-i18n="home.cta.right.heading">{home.cta.right.heading}</h2>
          <form class="home-cta-form" onsubmit="return false;">
            <input
              class="home-cta-input"
              type="email"
              placeholder={home.cta.right.inputPlaceholder}
              data-i18n-attr-placeholder="home.cta.right.inputPlaceholder"
            />
            <button class="home-cta-submit" type="submit" data-i18n="home.cta.right.submitLabel">
              {home.cta.right.submitLabel}
            </button>
          </form>
        </div>
      </div>
    </section>

    <section class="home-section" id="features">
      <h2 data-i18n="home.features.title">{home.features.title}</h2>
      <div class="home-features-grid">
        {home.features.items.map((item, index) => (
          <article class={`home-feature-card${index === 0 ? ' home-feature-card--featured' : ''}`}>
            <div class="home-feature-icon" aria-hidden="true">
              {index === 0 && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="11" width="18" height="11" rx="2"/>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                  <circle cx="12" cy="16" r="1" fill="currentColor"/>
                </svg>
              )}
              {index === 1 && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="7" y="7" width="10" height="10" rx="1"/>
                  <path d="M9 4v3M12 4v3M15 4v3M9 17v3M12 17v3M15 17v3M4 9h3M4 12h3M4 15h3M17 9h3M17 12h3M17 15h3"/>
                </svg>
              )}
              {index === 2 && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 3l8 4v5c0 5.25-4 8.75-8 10-4-1.25-8-4.75-8-10V7l8-4z"/>
                  <path d="M12 9v4M12 17h.01"/>
                </svg>
              )}
              {index === 3 && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M7 8l-4 4 4 4M17 8l4 4-4 4"/>
                  <path d="M14 4l-4 16"/>
                </svg>
              )}
              {index === 4 && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="5" cy="12" r="2"/>
                  <circle cx="19" cy="5" r="2"/>
                  <circle cx="19" cy="19" r="2"/>
                  <path d="M7 11.5l10-5M7 12.5l10 5"/>
                </svg>
              )}
            </div>
            <p class="home-feature-tag" data-i18n={`home.features.items.${index}.tag`}>{item.tag}</p>
            <h3 class="home-feature-title" data-i18n={`home.features.items.${index}.title`}>{item.title}</h3>
            <p class="home-feature-body" data-i18n={`home.features.items.${index}.body`}>{item.body}</p>
            <a href="#capabilities" class="home-feature-link" data-i18n={`home.features.items.${index}.link`}>
              {item.link} →
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="home-section" id="capabilities">
      <div class="home-capabilities-shell">
        <div class="home-capabilities-heading">
          <h2 data-i18n="home.capabilities.title">{home.capabilities.title}</h2>
        </div>
        <ul class="feature-plain-list" aria-label={home.capabilities.listAria} data-i18n-attr-aria-label="home.capabilities.listAria">
          {home.capabilities.items.map((item, index) => (
            <li data-i18n-html={`home.capabilities.items.${index}`} set:html={item}></li>
          ))}
        </ul>
      </div>
    </section>

    <section class="home-section" id="stack">
      <h2 data-i18n="home.cases.title">{home.cases.title}</h2>
      <p class="stack-subheadline" data-i18n="home.cases.subtitle">{home.cases.subtitle}</p>

      <div class="stack-rows">
        {home.cases.rows.map((row, index) => (
          <article class="stack-row">
            <p class="stack-title">
              <span class="stack-icon" aria-hidden="true"></span>
              <strong data-i18n={`home.cases.rows.${index}.title`}>{row.title}</strong>
            </p>
            <p data-i18n={`home.cases.rows.${index}.body`}>{row.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="home-section" id="cases">
      <div class="home-references-head">
        <h2 data-i18n="home.references.title">{home.references.title}</h2>
        <p class="home-references-subtitle" data-i18n="home.references.subtitle">{home.references.subtitle}</p>
      </div>

      <div class="home-references-panel">
        <div class="home-references-tags">
          {home.references.cards.map((card, index) => (
            <a class="home-reference-tag" href={`#reference-card-${index}`} data-i18n={`home.references.cards.${index}.sector`}>
              {card.sector}
            </a>
          ))}
        </div>

        <div class="home-references-grid">
          {home.references.cards.map((card, index) => (
            <a class="home-reference-card" id={`reference-card-${index}`} href={referenceLinks[index]}>
              <p class="home-reference-sector" data-i18n={`home.references.cards.${index}.sector`}>{card.sector}</p>
              <h3 class="home-reference-title" data-i18n={`home.references.cards.${index}.title`}>{card.title}</h3>
              <p class="home-reference-highlight" data-i18n={`home.references.cards.${index}.highlight`}>{card.highlight}</p>
              <p class="home-reference-body" data-i18n={`home.references.cards.${index}.body`}>{card.body}</p>
              <span class="home-reference-link" data-i18n="home.references.cta">{home.references.cta}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
</SiteLayout>
