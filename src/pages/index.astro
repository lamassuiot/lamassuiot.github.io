    <!-- ═══ Comparison ══════════════════════════════════════════ -->
    <section class="lp-section" id="compare">
      <div class="lp-wrap">
        <header class="lp-head lp-head--center" data-reveal>
          <p class="lp-label" data-i18n="home.compare.label">{home.compare.label}</p>
