---
import SiteLayout from '../../layouts/SiteLayout.astro';
---

<SiteLayout title="LAMASSU IoT Architecture" lang="en" activeNav="arch">
  <Fragment slot="head">
    <link
        href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=IBM+Plex+Sans:wght@300;400;600&display=swap"
        rel="stylesheet">
    <style is:global>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --bg: #0a0c10;
            --surface: #111318;
            --surface2: #14171f;
            --border: #1e2330;
            --border-bright: #2a3145;
            --text: #c8d0e0;
            --text-dim: #5a6480;
            --text-bright: #eef2ff;
            --accent-blue: #4a9eff;
            --accent-cyan: #00d4c8;
            --accent-pink: #ff4a8d;
            --accent-amber: #ffb830;
            --accent-green: #30e888;
            --accent-purple: #9d72ff;
            --accent-orange: #ff7b3a;
        }

        body {
            background: var(--bg);
            font-family: 'IBM Plex Sans', sans-serif;
            color: var(--text);
            min-height: 100vh;
            padding: 0;
            background-image:
                radial-gradient(ellipse 80% 50% at 50% -20%, rgba(74, 158, 255, 0.05) 0%, transparent 70%),
                linear-gradient(rgba(30, 35, 48, 0.35) 1px, transparent 1px),
                linear-gradient(90deg, rgba(30, 35, 48, 0.35) 1px, transparent 1px);
            background-size: 100% 100%, 40px 40px, 40px 40px;
        }

        /* ── HEADER ── */
        .header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            margin-bottom: 32px;
        }

        .header-left h1 {
            font-family: 'IBM Plex Mono', monospace;
            font-size: 18px;
            font-weight: 600;
            color: var(--text-bright);
            letter-spacing: 0.04em;
            margin-bottom: 6px;
        }

        .header-left h1 span {
            color: var(--accent-cyan);
        }

        .header-sub {
            font-size: 11px;
            color: var(--text-dim);
            font-family: 'IBM Plex Mono', monospace;
            letter-spacing: 0.1em;
        }

        .header-badges {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            justify-content: flex-end;
        }

        .badge {
            font-family: 'IBM Plex Mono', monospace;
            font-size: 8px;
            font-weight: 600;
            letter-spacing: 0.12em;
            padding: 4px 10px;
            border-radius: 4px;
            text-transform: uppercase;
        }

        /* ── LAYOUT ── */
        .arch-scale {
            --arch-ui-scale: 1.1;
            zoom: var(--arch-ui-scale);
        }

        @supports not (zoom: 1) {
            .arch-scale {
                transform: scale(var(--arch-ui-scale));
                transform-origin: top left;
                width: calc(100% / var(--arch-ui-scale));
            }
        }

        @media (max-width: 1320px) {
            .arch-scale {
                --arch-ui-scale: 1.05;
            }
        }

        @media (max-width: 1080px) {
            .arch-scale {
                --arch-ui-scale: 1;
            }
        }

        .diagram-wrap {
            display: flex;
            flex-direction: column;
            gap: 14px;
            padding: 24px 28px 40px;
        }

        .row {
            display: flex;
            gap: 14px;
            align-items: stretch;
        }

        .panel {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 18px;
            position: relative;
            overflow: hidden;
            transition: border-color 0.3s;
            flex-shrink: 0;
        }

        .panel:hover {
            border-color: var(--border-bright);
        }

        .panel-top-bar {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            border-radius: 12px 12px 0 0;
        }

        .panel-label {
            font-family: 'IBM Plex Mono', monospace;
            font-size: 8px;
            font-weight: 600;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            margin-bottom: 14px;
            padding-bottom: 10px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .panel-label .dot {
            width: 5px;
            height: 5px;
            border-radius: 50%;
            flex-shrink: 0;
            animation: pulse 2.5s ease-in-out infinite;
        }

        @keyframes pulse {

            0%,
            100% {
                opacity: 1
            }

            50% {
                opacity: 0.3
            }
        }

        /* ── ARROWS ── */
        .h-arrow {
            display: flex;
            align-items: center;
            width: 52px;
            flex-shrink: 0;
            flex-direction: column;
            justify-content: center;
            gap: 5px;
            padding-top: 22px;
        }

        .fa-line-h {
            width: 100%;
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--border-bright), var(--accent-blue));
            position: relative;
        }

        .fa-line-h::after {
            content: '';
            position: absolute;
            right: -1px;
            top: 50%;
            transform: translateY(-50%);
            border: 5px solid transparent;
            border-left-color: var(--accent-blue);
        }

        .fa-label {
            font-family: 'IBM Plex Mono', monospace;
            font-size: 7px;
            letter-spacing: 0.1em;
            color: var(--text-dim);
            text-transform: uppercase;
            text-align: center;
            white-space: nowrap;
        }

        /* ── CARDS ── */
        .svc-card {
            border-radius: 9px;
            padding: 12px 14px;
            border: 1px solid;
            transition: all 0.25s;
            cursor: pointer;
            margin-bottom: 8px;
            position: relative;
        }

        .svc-card:last-child {
            margin-bottom: 0;
        }

        .svc-card:hover {
            transform: translateY(-2px);
        }

        .svc-card::after {
            content: '↗';
            position: absolute;
            top: 10px;
            right: 10px;
            font-size: 9px;
            opacity: 0;
            transition: opacity 0.2s;
            color: var(--text-dim);
        }

        .svc-card:hover::after {
            opacity: 1;
        }

        .svc-card-header {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 5px;
        }

        .svc-tag {
            font-family: 'IBM Plex Mono', monospace;
            font-size: 7px;
            font-weight: 600;
            letter-spacing: 0.1em;
            padding: 2px 6px;
            border-radius: 3px;
            text-transform: uppercase;
            flex-shrink: 0;
        }

        .svc-title {
            font-size: 12px;
            font-weight: 600;
            color: var(--text-bright);
        }

        .svc-desc {
            font-size: 9px;
            color: var(--text-dim);
            font-family: 'IBM Plex Mono', monospace;
            line-height: 1.6;
        }

        .svc-pills {
            display: flex;
            flex-wrap: wrap;
            gap: 4px;
            margin-top: 7px;
        }

        .pill {
            font-family: 'IBM Plex Mono', monospace;
            font-size: 7px;
            padding: 2px 6px;
            border-radius: 3px;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid var(--border);
            color: var(--text-dim);
        }

        .device-card {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 12px;
            border-radius: 8px;
            border: 1px solid var(--border);
            background: rgba(255, 255, 255, 0.02);
            margin-bottom: 7px;
            transition: all 0.25s;
            cursor: pointer;
            position: relative;
        }

        .device-card:last-child {
            margin-bottom: 0;
        }

        .device-card:hover {
            border-color: var(--accent-blue);
            background: rgba(74, 158, 255, 0.08);
            transform: translateX(2px);
        }

        .device-card::after {
            content: '↗';
            position: absolute;
            top: 50%;
            right: 10px;
            transform: translateY(-50%);
            font-size: 9px;
            opacity: 0;
            transition: opacity 0.2s;
            color: var(--text-dim);
        }

        .device-card:hover::after {
            opacity: 1;
        }

        .device-icon {
            font-size: 18px;
            width: 28px;
            text-align: center;
            flex-shrink: 0;
        }

        .device-name {
            font-size: 11px;
            font-weight: 600;
            color: var(--text-bright);
            line-height: 1.2;
        }

        .device-sub {
            font-size: 8px;
            color: var(--text-dim);
            font-family: 'IBM Plex Mono', monospace;
            margin-top: 2px;
        }

        .engine-item {
            padding: 10px 12px;
            border-radius: 8px;
            border: 1px solid var(--border);
            background: rgba(255, 255, 255, 0.02);
            transition: all 0.25s;
            cursor: pointer;
            position: relative;
        }

        .engine-item:hover {
            border-color: var(--border-bright);
            background: rgba(255, 255, 255, 0.05);
            transform: translateY(-1px);
        }

        .engine-item::after {
            content: '↗';
            position: absolute;
            top: 8px;
            right: 8px;
            font-size: 9px;
            opacity: 0;
            transition: opacity 0.2s;
            color: var(--text-dim);
        }

        .engine-item:hover::after {
            opacity: 1;
        }

        .engine-type {
            font-family: 'IBM Plex Mono', monospace;
            font-size: 7px;
            font-weight: 600;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            margin-bottom: 5px;
        }

        .engine-vals {
            font-size: 9px;
            color: var(--text-dim);
            font-family: 'IBM Plex Mono', monospace;
            line-height: 1.7;
        }

        .engine-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
        }

        .deploy-item {
            padding: 9px 11px;
            border-radius: 7px;
            border: 1px solid var(--border);
            background: rgba(255, 255, 255, 0.02);
            transition: all 0.25s;
            cursor: pointer;
            position: relative;
        }

        .deploy-item:hover {
            border-color: var(--border-bright);
            background: rgba(255, 255, 255, 0.04);
        }

        .deploy-item::after {
            content: '↗';
            position: absolute;
            top: 8px;
            right: 8px;
            font-size: 9px;
            opacity: 0;
            transition: opacity 0.2s;
            color: var(--text-dim);
        }

        .deploy-item:hover::after {
            opacity: 1;
        }

        .deploy-name {
            font-size: 10px;
            font-weight: 600;
            color: var(--text-bright);
            margin-bottom: 3px;
        }

        .deploy-name-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 6px;
            margin-bottom: 3px;
        }

        .deploy-name-row .deploy-name {
            margin-bottom: 0;
        }

        .deploy-badge {
            font-family: 'IBM Plex Mono', monospace;
            font-size: 7px;
            font-weight: 600;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            line-height: 1.2;
            padding: 2px 6px;
            border-radius: 3px;
            border: 1px solid rgba(255, 184, 48, 0.45);
            background: rgba(255, 184, 48, 0.12);
            color: var(--accent-amber);
            white-space: nowrap;
        }

        .deploy-desc {
            font-size: 8px;
            color: var(--text-dim);
            font-family: 'IBM Plex Mono', monospace;
            line-height: 1.5;
        }

        .deploy-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 7px;
        }

        .section-title {
            font-family: 'IBM Plex Mono', monospace;
            font-size: 7px;
            font-weight: 600;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: var(--text-dim);
            margin-bottom: 8px;
        }

        /* ── COLOR VARIANTS ── */
        .c-pink {
            background: rgba(255, 74, 141, 0.07);
            border-color: rgba(255, 74, 141, 0.3);
        }

        .c-pink:hover {
            border-color: var(--accent-pink);
            box-shadow: 0 4px 20px rgba(255, 74, 141, 0.15);
        }

        .c-blue {
            background: rgba(74, 158, 255, 0.07);
            border-color: rgba(74, 158, 255, 0.3);
        }

        .c-blue:hover {
            border-color: var(--accent-blue);
            box-shadow: 0 4px 20px rgba(74, 158, 255, 0.15);
        }

        .c-purple {
            background: rgba(157, 114, 255, 0.07);
            border-color: rgba(157, 114, 255, 0.3);
        }

        .c-purple:hover {
            border-color: var(--accent-purple);
            box-shadow: 0 4px 20px rgba(157, 114, 255, 0.15);
        }

        .c-green {
            background: rgba(48, 232, 136, 0.07);
            border-color: rgba(48, 232, 136, 0.3);
        }

        .c-green:hover {
            border-color: var(--accent-green);
            box-shadow: 0 4px 20px rgba(48, 232, 136, 0.15);
        }

        .c-amber {
            background: rgba(255, 184, 48, 0.07);
            border-color: rgba(255, 184, 48, 0.3);
        }

        .c-amber:hover {
            border-color: var(--accent-amber);
            box-shadow: 0 4px 20px rgba(255, 184, 48, 0.15);
        }

        .c-cyan {
            background: rgba(0, 212, 200, 0.07);
            border-color: rgba(0, 212, 200, 0.3);
        }

        .c-cyan:hover {
            border-color: var(--accent-cyan);
            box-shadow: 0 4px 20px rgba(0, 212, 200, 0.15);
        }

        .c-orange {
            background: rgba(255, 123, 58, 0.07);
            border-color: rgba(255, 123, 58, 0.3);
        }

        .c-orange:hover {
            border-color: var(--accent-orange);
            box-shadow: 0 4px 20px rgba(255, 123, 58, 0.15);
        }

        .tag-pink {
            background: rgba(255, 74, 141, 0.18);
            color: var(--accent-pink);
        }

        .tag-blue {
            background: rgba(74, 158, 255, 0.18);
            color: var(--accent-blue);
        }

        .tag-purple {
            background: rgba(157, 114, 255, 0.18);
            color: var(--accent-purple);
        }

        .tag-green {
            background: rgba(48, 232, 136, 0.18);
            color: var(--accent-green);
        }

        .tag-amber {
            background: rgba(255, 184, 48, 0.18);
            color: var(--accent-amber);
        }

        .tag-cyan {
            background: rgba(0, 212, 200, 0.18);
            color: var(--accent-cyan);
        }

        .tag-orange {
            background: rgba(255, 123, 58, 0.18);
            color: var(--accent-orange);
        }

        /* ── STATUS BAR ── */
        .status-bar {
            margin-top: 28px;
            display: flex;
            gap: 20px;
            align-items: center;
            flex-wrap: wrap;
        }

        .status-item {
            display: flex;
            align-items: center;
            gap: 6px;
            font-family: 'IBM Plex Mono', monospace;
            font-size: 9px;
            color: var(--text-dim);
            letter-spacing: 0.08em;
        }

        .status-dot {
            width: 5px;
            height: 5px;
            border-radius: 50%;
        }

        /* ══════════════════════════════════════════════════
   MODAL SYSTEM
══════════════════════════════════════════════════ */
        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.6);
            backdrop-filter: blur(4px);
            z-index: 1000;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.25s;
        }

        .modal-overlay.active {
            opacity: 1;
            pointer-events: all;
        }

        .modal-panel {
            position: fixed;
            top: 0;
            right: 0;
            bottom: 0;
            width: 460px;
            max-width: 100vw;
            background: var(--surface);
            border-left: 1px solid var(--border);
            z-index: 1001;
            overflow-y: auto;
            transform: translateX(100%);
            transition: transform 0.3s cubic-bezier(0.32, 0, 0.15, 1);
            display: flex;
            flex-direction: column;
        }

        .modal-panel.active {
            transform: translateX(0);
        }

        .modal-header {
            padding: 24px 24px 18px;
            border-bottom: 1px solid var(--border);
            position: sticky;
            top: 0;
            background: var(--surface);
            z-index: 2;
            flex-shrink: 0;
        }

        .modal-accent-bar {
            height: 3px;
            border-radius: 2px;
            margin-bottom: 18px;
        }

        .modal-title-row {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 12px;
        }

        .modal-tag {
            font-family: 'IBM Plex Mono', monospace;
            font-size: 8px;
            font-weight: 600;
            letter-spacing: 0.12em;
            padding: 3px 8px;
            border-radius: 3px;
            text-transform: uppercase;
            margin-bottom: 8px;
            display: inline-block;
        }

        .modal-title {
            font-family: 'IBM Plex Mono', monospace;
            font-size: 16px;
            font-weight: 600;
            color: var(--text-bright);
            line-height: 1.3;
            margin-bottom: 6px;
        }

        .modal-subtitle {
            font-size: 11px;
            color: var(--text-dim);
            line-height: 1.5;
        }

        .modal-close {
            width: 28px;
            height: 28px;
            border-radius: 6px;
            border: 1px solid var(--border);
            background: transparent;
            color: var(--text-dim);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            flex-shrink: 0;
            transition: all 0.2s;
        }

        .modal-close:hover {
            background: var(--border);
            color: var(--text-bright);
        }

        .modal-body {
            padding: 24px;
            flex: 1;
        }

        .modal-section {
            margin-bottom: 24px;
        }

        .modal-section:last-child {
            margin-bottom: 0;
        }

        .modal-section-title {
            font-family: 'IBM Plex Mono', monospace;
            font-size: 8px;
            font-weight: 600;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: var(--text-dim);
            margin-bottom: 12px;
            padding-bottom: 8px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .modal-section-title::before {
            content: '';
            display: block;
            width: 3px;
            height: 12px;
            border-radius: 2px;
            background: currentColor;
            flex-shrink: 0;
        }

        .modal-desc {
            font-size: 12px;
            color: var(--text);
            line-height: 1.7;
            margin-bottom: 12px;
        }

        .modal-kv {
            display: grid;
            grid-template-columns: auto 1fr;
            gap: 6px 16px;
            margin-bottom: 12px;
        }

        .modal-k {
            font-family: 'IBM Plex Mono', monospace;
            font-size: 9px;
            color: var(--text-dim);
            white-space: nowrap;
            padding-top: 1px;
        }

        .modal-v {
            font-family: 'IBM Plex Mono', monospace;
            font-size: 9px;
            color: var(--text-bright);
            line-height: 1.5;
        }

        .modal-pills {
            display: flex;
            flex-wrap: wrap;
            gap: 5px;
            margin-bottom: 12px;
        }

        .modal-pill {
            font-family: 'IBM Plex Mono', monospace;
            font-size: 8px;
            padding: 3px 8px;
            border-radius: 4px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--border);
            color: var(--text);
        }

        .modal-code {
            background: rgba(0, 0, 0, 0.4);
            border: 1px solid var(--border);
            border-radius: 7px;
            padding: 12px 14px;
            font-family: 'IBM Plex Mono', monospace;
            font-size: 9px;
            color: var(--accent-cyan);
            line-height: 1.7;
            margin-bottom: 12px;
            overflow-x: auto;
            white-space: pre;
        }

        .modal-metric-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
            margin-bottom: 12px;
        }

        .modal-metric {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 10px 12px;
        }

        .modal-metric-name {
            font-family: 'IBM Plex Mono', monospace;
            font-size: 8px;
            color: var(--text-dim);
            margin-bottom: 4px;
        }

        .modal-metric-val {
            font-family: 'IBM Plex Mono', monospace;
            font-size: 15px;
            font-weight: 600;
            color: var(--text-bright);
            margin-bottom: 2px;
        }

        .modal-metric-desc {
            font-size: 9px;
            color: var(--text-dim);
            line-height: 1.4;
        }

        .modal-link {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            font-family: 'IBM Plex Mono', monospace;
            font-size: 9px;
            color: var(--accent-blue);
            text-decoration: none;
            border: 1px solid rgba(74, 158, 255, 0.3);
            border-radius: 4px;
            padding: 4px 10px;
            transition: all 0.2s;
            margin-right: 6px;
            margin-bottom: 6px;
        }

        .modal-link:hover {
            background: rgba(74, 158, 255, 0.1);
            border-color: var(--accent-blue);
        }

        .modal-callout {
            border-radius: 8px;
            padding: 12px 14px;
            font-size: 11px;
            line-height: 1.6;
            margin-bottom: 12px;
        }

        .modal-img-wrap {
            border-radius: 8px;
            overflow: hidden;
            border: 1px solid var(--border);
            background: #050709;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 12px;
            margin-bottom: 12px;
        }

        .modal-img-wrap img {
            max-width: 100%;
            max-height: 160px;
            object-fit: contain;
            mix-blend-mode: lighten;
            filter: brightness(1.1);
        }
    </style>
  </Fragment>
    <!-- ══ MODAL OVERLAY ══ -->
    <div class="modal-overlay" id="overlay" onclick="closeModal()"></div>

    <!-- ══ MODAL PANEL ══ -->
    <div class="modal-panel" id="modalPanel">
        <div class="modal-header">
            <div class="modal-accent-bar" id="modalAccent"></div>
            <div class="modal-title-row">
                <div>
                    <div class="modal-tag" id="modalTag"></div>
                    <div class="modal-title" id="modalTitle"></div>
                    <div class="modal-subtitle" id="modalSubtitle"></div>
