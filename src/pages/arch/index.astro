        /* ══════════════════════════════════════════════
           RENDER HELPERS
        ══════════════════════════════════════════════ */
        function renderSection(s) {
            let html = `<div class="modal-section">
    <div class="modal-section-title" style="color:${currentAccent}">${s.title}</div>`;
            if (s.body) html += `<p class="modal-desc">${s.body}</p>`;
            if (s.img) html += `<div class="modal-img-wrap"><img src="${s.img}" alt=""></div>`;
            if (s.code) html += `<div class="modal-code">${escHtml(s.code)}</div>`;
            if (s.kv) {
                html += '<div class="modal-kv">';
                for (const [k, v] of Object.entries(s.kv)) html += `<div class="modal-k">${k}</div><div class="modal-v">${v}</div>`;
                html += '</div>';
            }
            if (s.pills) html += `<div class="modal-pills">${s.pills.map(p => `<span class="modal-pill">${p}</span>`).join('')}</div>`;
            if (s.metrics) {
                html += '<div class="modal-metric-grid">';
                for (const m of s.metrics) html += `<div class="modal-metric"><div class="modal-metric-name">${m.name}</div><div class="modal-metric-val" style="color:${currentAccent}">${m.val}</div><div class="modal-metric-desc">${m.desc}</div></div>`;
                html += '</div>';
            }
            if (s.callout) html += `<div class="modal-callout" style="background:${s.callout.color};border:1px solid ${s.callout.border}">${s.callout.text}</div>`;
            if (s.links) html += s.links.map(l => `<a class="modal-link" href="${l.url}" target="_blank" rel="noopener">↗ ${l.label}</a>`).join('');
            html += '</div>';
            return html;
        }

        function escHtml(s) { return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }

        let currentAccent = '#4a9eff';

        function openModal(id) {
            const d = MODALS[id]; if (!d) return;
            currentAccent = d.accent;
            document.getElementById('modalAccent').style.background = d.accent;
            document.getElementById('modalTag').textContent = d.tag;
            document.getElementById('modalTag').style.background = d.tagBg;
            document.getElementById('modalTag').style.color = d.tagColor || d.accent;
            document.getElementById('modalTitle').textContent = d.title;
            document.getElementById('modalSubtitle').textContent = d.subtitle;
            document.getElementById('modalBody').innerHTML = d.sections.map(renderSection).join('');
            document.getElementById('overlay').classList.add('active');
            document.getElementById('modalPanel').classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        function closeModal() {
            document.getElementById('overlay').classList.remove('active');
            document.getElementById('modalPanel').classList.remove('active');
            document.body.style.overflow = '';
        }

        // Expose handlers for inline onclick attributes in the legacy diagram markup.
        window.openModal = openModal;
        window.closeModal = closeModal;

        document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });
    </script>
