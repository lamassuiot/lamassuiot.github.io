---
import SiteLayout from '../../layouts/SiteLayout.astro';
---

<SiteLayout title="Lamassu PKI Architecture" lang="en" activeNav="arch">
  <main class="architecture-viewer">
    <iframe
      src="/arch/lamassu-k8s-architecture-2d-3d_11/"
      title="Interactive Lamassu Kubernetes architecture diagram"
      loading="eager"
    ></iframe>
  </main>
</SiteLayout>

<style>
  .architecture-viewer {
    width: 100%;
    height: max(560px, calc(100dvh - var(--shell-header-h) - 5px));
  }

  .architecture-viewer iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
