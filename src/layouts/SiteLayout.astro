---
import SiteHeader from '../components/SiteHeader.astro';
import { localeOptions, sharedTranslations } from '../lib/i18n';

interface Props {
  title: string;
  lang?: string;
  activeNav?: 'home' | 'arch' | 'docs' | '';
  pageTranslations?: Record<string, unknown>;
}

const { title, lang = 'es', activeNav = '', pageTranslations = {} } = Astro.props;
const footer = sharedTranslations.es.footer;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#09111f" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f4f6fa" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <slot name="head" />
    <script is:inline>
      (function () {
        var theme = localStorage.getItem('ls-theme');
        if (theme === 'light') {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>
  <body>
    <div class="site-shell-top-stripe"></div>
    <SiteHeader activeNav={activeNav} />
    <slot />

    <footer class="site-footer" aria-label="Site footer">
      <div class="site-footer-inner">
        <div class="site-footer-main">
          <div class="site-footer-grid">
            <section class="site-footer-col" aria-label={footer.documentation} data-i18n-attr-aria-label="footer.documentation">
              <h4 data-i18n="footer.documentation">{footer.documentation}</h4>
              <a class="site-footer-link" href="https://www.lamassu.io/docs/" target="_blank" rel="noopener" data-i18n="footer.sdks">{footer.sdks}</a>
              <a class="site-footer-link" href="https://www.lamassu.io/docs/" target="_blank" rel="noopener" data-i18n="footer.docs">{footer.docs}</a>
            </section>

            <section class="site-footer-col" aria-label={footer.apiDefinition} data-i18n-attr-aria-label="footer.apiDefinition">
              <h4 data-i18n="footer.apiDefinition">{footer.apiDefinition}</h4>
              <a class="site-footer-link" href="https://www.lamassu.io/lamassuiot" target="_blank" rel="noopener" data-i18n="footer.openApi">{footer.openApi}</a>
            </section>

            <section class="site-footer-col" aria-label={footer.resources} data-i18n-attr-aria-label="footer.resources">
              <h4 data-i18n="footer.resources">{footer.resources}</h4>
              <a class="site-footer-link" href="https://www.lamassu.io/blog/" target="_blank" rel="noopener" data-i18n="footer.blog">{footer.blog}</a>
              <a class="site-footer-link" href="https://www.lamassu.io/slack/" target="_blank" rel="noopener" data-i18n="footer.slack">{footer.slack}</a>
            </section>

            <section class="site-footer-col site-footer-social-col" aria-label={footer.socialAria} data-i18n-attr-aria-label="footer.socialAria">
              <div class="site-footer-social">
                <a href="https://github.com/lamassuiot" target="_blank" rel="noopener" aria-label="GitHub">
                  <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                    <path d="M8 0C3.58 0 0 3.67 0 8.2C0 11.82 2.29 14.89 5.47 15.97C5.87 16.05 6.02 15.79 6.02 15.56C6.02 15.35 6.01 14.63 6.01 13.86C4 14.24 3.48 13.36 3.32 12.9C3.23 12.67 2.84 11.95 2.5 11.76C2.22 11.6 1.83 11.2 2.49 11.19C3.11 11.18 3.55 11.78 3.7 12.02C4.41 13.24 5.55 12.9 6.03 12.7C6.1 12.17 6.31 11.81 6.54 11.61C4.76 11.4 2.9 10.7 2.9 7.58C2.9 6.69 3.21 5.97 3.73 5.41C3.65 5.21 3.37 4.39 3.81 3.29C3.81 3.29 4.48 3.07 6.01 4.13C6.65 3.95 7.33 3.86 8.01 3.86C8.69 3.86 9.37 3.95 10.01 4.13C11.54 3.06 12.21 3.29 12.21 3.29C12.65 4.39 12.37 5.21 12.29 5.41C12.81 5.97 13.12 6.68 13.12 7.58C13.12 10.71 11.25 11.4 9.47 11.61C9.76 11.87 10.01 12.37 10.01 13.15C10.01 14.27 10 15.18 10 15.56C10 15.79 10.15 16.06 10.55 15.97C13.72 14.89 16 11.81 16 8.2C16 3.67 12.42 0 8 0Z" />
                  </svg>
                </a>
                <a href="https://www.linkedin.com/company/lamassu-iot/" target="_blank" rel="noopener" aria-label="LinkedIn">
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M6.94 8.5A1.56 1.56 0 1 1 6.94 5.38A1.56 1.56 0 0 1 6.94 8.5ZM8.5 10.06H5.38V20H8.5V10.06ZM13.44 10.06H10.34V20H13.41V14.78C13.41 12.03 17 11.78 17 14.78V20H20.12V13.72C20.12 8.84 14.53 9.02 13.41 11.42L13.44 10.06Z" />
                  </svg>
                </a>
              </div>
            </section>
          </div>
        </div>

        <p class="site-footer-copy" data-i18n="footer.copyright">{footer.copyright}</p>
      </div>
    </footer>
    <script
      id="page-translations"
      type="application/json"
      set:html={JSON.stringify(pageTranslations)}
    ></script>
    <script is:inline>
      (function () {
        var body = document.body;
        var header = document.querySelector('.site-shell-header');
        if (!body || !header) return;

        var overview = document.getElementById('overview');

        function shouldStick() {
          if (window.innerWidth <= 1240) return false;

          if (overview) {
            var headerHeight = header.getBoundingClientRect().height;
            return overview.getBoundingClientRect().top <= headerHeight + 6;
          }

          return window.scrollY > 180;
        }

        function syncStickyHeader() {
          body.classList.toggle('site-shell-header-sticky', shouldStick());
        }

        syncStickyHeader();
        window.addEventListener('scroll', syncStickyHeader, { passive: true });
        window.addEventListener('resize', syncStickyHeader);
      })();
    </script>
    <script is:inline define:vars={{ localeOptions, sharedTranslations, title }}>
      (function () {
        var STORAGE_KEY = 'lamassu-locale';
        var pageTranslationsElement = document.getElementById('page-translations');
        var pageTranslations = {};

        if (pageTranslationsElement && pageTranslationsElement.textContent) {
          try {
            pageTranslations = JSON.parse(pageTranslationsElement.textContent);
          } catch (error) {
            pageTranslations = {};
          }
        }

        function getLocaleConfig(locale) {
          return localeOptions.find(function (option) { return option.code === locale; });
        }

        function getDictionary(locale) {
          return Object.assign({}, sharedTranslations[locale] || {}, pageTranslations[locale] || {});
        }

        function resolveKey(source, key) {
          return key.split('.').reduce(function (acc, part) {
            if (acc == null) return undefined;
            return acc[part];
          }, source);
        }

        function applyAttributes(locale, dictionary) {
          document.querySelectorAll('*').forEach(function (element) {
            Array.prototype.forEach.call(element.attributes, function (attribute) {
              if (!attribute.name.startsWith('data-i18n-attr-')) return;
              var targetAttribute = attribute.name.replace('data-i18n-attr-', '');
              var value = resolveKey(dictionary, attribute.value);
              if (typeof value === 'string') {
                element.setAttribute(targetAttribute, value);
              }
            });
          });
        }

        function applyLocale(locale) {
          var dictionary = getDictionary(locale);
          var localeConfig = getLocaleConfig(locale) || getLocaleConfig('es');

          document.documentElement.lang = localeConfig ? localeConfig.htmlLang : 'es';
          localStorage.setItem(STORAGE_KEY, locale);

          document.querySelectorAll('[data-i18n]').forEach(function (element) {
            var key = element.getAttribute('data-i18n');
            var value = key ? resolveKey(dictionary, key) : undefined;
            if (typeof value === 'string') {
              element.textContent = value;
            }
          });

          document.querySelectorAll('[data-i18n-html]').forEach(function (element) {
            var key = element.getAttribute('data-i18n-html');
            var value = key ? resolveKey(dictionary, key) : undefined;
            if (typeof value === 'string') {
              element.innerHTML = value;
            }
          });

          applyAttributes(locale, dictionary);

          var translatedTitle = resolveKey(dictionary, 'meta.title');
          document.title = typeof translatedTitle === 'string' ? translatedTitle : title;

          document.querySelectorAll('[data-locale-option]').forEach(function (button) {
            var isActive = button.getAttribute('data-locale-option') === locale;
            button.classList.toggle('is-active', isActive);
            button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
          });
        }

        var selectedLocale = localStorage.getItem(STORAGE_KEY);
        var supported = localeOptions.map(function (option) { return option.code; });
        applyLocale(supported.indexOf(selectedLocale) >= 0 ? selectedLocale : 'es');

        document.querySelectorAll('[data-locale-option]').forEach(function (button) {
          button.addEventListener('click', function () {
            var locale = button.getAttribute('data-locale-option');
            if (!locale) return;
            applyLocale(locale);
          });
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    padding: 0;
    width: 100%;
    min-height: 100%;
  }

  :root {
    --shell-bg: #09111f;
    --shell-surface: #10192c;
    --shell-surface-alt: #15233a;
    --shell-border: #243550;
    --shell-text: #edf3ff;
    --shell-muted: #8fa1c3;
    --shell-accent: #7e9cff;
    --shell-accent-soft: rgba(137, 162, 255, 0.16);
    --shell-header-h: 82px;
  }

  [data-theme='light'] {
    --shell-bg: #f4f6fa;
    --shell-surface: #ffffff;
    --shell-surface-alt: #f8f9fc;
    --shell-border: #d9dfeb;
    --shell-text: #0f1728;
    --shell-muted: #55627f;
    --shell-accent: #3f63ff;
    --shell-accent-soft: rgba(63, 99, 255, 0.1);
  }

  body {
    background:
      radial-gradient(circle at 50% -15%, rgba(98, 124, 205, 0.18), transparent 45%),
      radial-gradient(circle at 85% 0%, rgba(47, 74, 136, 0.14), transparent 28%),
      var(--shell-bg);
    color: var(--shell-text);
    font-family: 'Space Grotesk', sans-serif;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    overflow-x: hidden;
  }

  .site-shell-top-stripe {
    height: 5px;
    width: 100%;
    background: linear-gradient(90deg, #2a49f8 0%, #4c7fff 52%, #35b9ff 100%);
  }

  .site-shell-header {
    height: var(--shell-header-h);
    width: min(1360px, calc(100% - 48px));
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .site-shell-brand {
    display: inline-flex;
    align-items: center;
    gap: 0;
    text-decoration: none;
    flex-shrink: 0;
  }

  .site-shell-logo-full {
    height: 30px;
    width: auto;
    display: block;
  }

  .site-shell-logo-full.logo-light {
    display: none;
  }

  [data-theme='light'] .site-shell-logo-full.logo-dark {
    display: none;
  }

  [data-theme='light'] .site-shell-logo-full.logo-light {
    display: block;
  }

  .site-shell-nav {
    display: inline-flex;
    align-items: center;
    gap: 18px;
  }

  .site-shell-nav a {
    color: var(--shell-muted);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    transition: color 0.15s ease;
  }

  .site-shell-nav a:hover,
  .site-shell-nav a.is-active {
    color: var(--shell-text);
  }

  .site-shell-nav a.github-link {
    display: inline-grid;
    place-items: center;
    line-height: 0;
  }

  .site-shell-nav a.github-link svg {
    width: 17px;
    height: 17px;
    display: block;
    fill: currentColor;
  }

  .site-shell-cta-group {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .locale-switcher {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 0 2px;
    border-bottom: 1px solid rgba(143, 172, 246, 0.18);
  }

  [data-theme='light'] .locale-switcher {
    border-bottom-color: rgba(85, 110, 127, 0.18);
  }

  .locale-switcher-btn {
    border: 0;
    background: transparent;
    color: var(--shell-muted);
    border-radius: 0;
    min-width: auto;
    padding: 8px 8px 10px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition:
      color 0.18s ease,
      opacity 0.18s ease;
    position: relative;
    opacity: 0.72;
  }

  .locale-switcher-btn:hover {
    color: var(--shell-text);
    opacity: 1;
  }

  .locale-switcher-btn.is-active {
    color: var(--shell-text);
    opacity: 1;
  }

  .locale-switcher-btn::after {
    content: '';
    position: absolute;
    left: 8px;
    right: 8px;
    bottom: -1px;
    height: 2px;
    border-radius: 999px;
    background: linear-gradient(90deg, #7e9cff 0%, #59d0ff 100%);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.18s ease;
  }

  .locale-switcher-btn.is-active::after {
    transform: scaleX(1);
  }

  .theme-toggle {
    width: 34px;
    height: 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid var(--shell-border);
    border-radius: 8px;
    color: var(--shell-muted);
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease;
    padding: 0;
  }

  .theme-toggle:hover {
    color: var(--shell-text);
    border-color: var(--shell-muted);
  }

  .theme-toggle .icon-moon {
    display: none;
  }

  .theme-toggle .icon-sun {
    display: block;
  }

  [data-theme='light'] .theme-toggle .icon-moon {
    display: block;
  }

  [data-theme='light'] .theme-toggle .icon-sun {
    display: none;
  }

  .theme-toggle svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    display: block;
  }

  .site-shell-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 38px;
    box-sizing: border-box;
    border: 1px solid var(--shell-border);
    background: var(--shell-surface);
    color: var(--shell-text);
    border-radius: 8px;
    text-decoration: none;
    padding: 9px 13px;
    font-size: 14px;
    line-height: 1;
    font-weight: 600;
    transition: border-color 0.15s ease, background-color 0.15s ease;
    white-space: nowrap;
  }

  .site-shell-cta:hover {
    border-color: var(--shell-muted);
  }

  .site-shell-cta-login {
    background: var(--shell-accent);
    color: #0b1122;
    border-color: transparent;
  }

  [data-theme='light'] .site-shell-cta-login {
    color: #ffffff;
  }

  .site-shell-cta-login:hover {
    background: #96b0ff;
    border-color: transparent;
  }

  @keyframes siteShellStickyIn {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes siteShellStickyLinkIn {
    from {
      opacity: 0;
      transform: translateY(-3px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (min-width: 941px) {
    body.site-shell-header-sticky .site-shell-header {
      position: fixed;
      top: 8px;
      left: 50%;
      transform: translateX(-50%);
      width: auto;
      height: auto;
      margin: 0;
      justify-content: center;
      gap: 0;
      z-index: 70;
    }

    body.site-shell-header-sticky .site-shell-brand,
    body.site-shell-header-sticky .site-shell-cta-group {
      display: none;
    }

    body.site-shell-header-sticky .site-shell-nav {
      gap: 16px;
      padding: 11px 18px;
      border: 1px solid rgba(63, 80, 119, 0.72);
      border-radius: 14px;
      background: rgba(9, 15, 28, 0.88);
      box-shadow: 0 12px 30px rgba(2, 6, 16, 0.34);
      backdrop-filter: blur(8px);
      animation: siteShellStickyIn 230ms ease both;
    }

    [data-theme='light'] body.site-shell-header-sticky .site-shell-nav {
      border-color: rgba(197, 207, 227, 0.92);
      background: rgba(255, 255, 255, 0.94);
      box-shadow: 0 10px 26px rgba(13, 26, 51, 0.14);
    }

    body.site-shell-header-sticky .site-shell-nav a {
      opacity: 0;
      transform: translateY(-3px);
      animation: siteShellStickyLinkIn 180ms ease forwards;
    }

    body.site-shell-header-sticky .site-shell-nav a:nth-child(1) { animation-delay: 30ms; }
    body.site-shell-header-sticky .site-shell-nav a:nth-child(2) { animation-delay: 55ms; }
    body.site-shell-header-sticky .site-shell-nav a:nth-child(3) { animation-delay: 80ms; }
    body.site-shell-header-sticky .site-shell-nav a:nth-child(4) { animation-delay: 105ms; }
    body.site-shell-header-sticky .site-shell-nav a:nth-child(5) { animation-delay: 130ms; }
    body.site-shell-header-sticky .site-shell-nav a:nth-child(6) { animation-delay: 155ms; }
    body.site-shell-header-sticky .site-shell-nav a:nth-child(7) { animation-delay: 180ms; }

    @media (prefers-reduced-motion: reduce) {
      body.site-shell-header-sticky .site-shell-nav,
      body.site-shell-header-sticky .site-shell-nav a {
        animation: none;
      }

      body.site-shell-header-sticky .site-shell-nav a {
        opacity: 1;
        transform: none;
      }
    }
  }

  .site-footer {
    margin-top: 84px;
    border-top: 1px solid rgba(143, 172, 246, 0.14);
    background:
      radial-gradient(circle at 18% 22%, rgba(34, 74, 164, 0.14), transparent 48%),
      radial-gradient(circle at 86% 12%, rgba(68, 115, 255, 0.1), transparent 45%),
      #060914;
  }

  .site-footer-inner {
    width: min(1480px, calc(100% - 56px));
    margin: 0 auto;
    padding: 46px 0 40px;
  }

  .site-footer-main {
    display: block;
  }

  .site-footer-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(140px, 180px)) auto;
    justify-content: center;
    gap: 24px 24px;
    width: fit-content;
    margin: 0 auto;
    align-items: start;
  }

  .site-footer-col {
    display: grid;
    align-content: start;
    gap: 8px;
  }

  .site-footer-col h4 {
    margin: 0 0 6px;
    color: #e2e6ef;
    font-size: 16px;
    font-weight: 700;
  }

  .site-footer-link {
    color: #a4adbe;
    text-decoration: none;
    font-size: 16px;
    line-height: 1.5;
    transition: color 0.2s;
  }

  .site-footer-link:hover {
    color: #ffffff;
  }

  .site-footer-social {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
    padding-top: 2px;
  }

  .site-footer-social-col {
    justify-self: center;
    display: flex;
    justify-content: center;
  }

  .site-footer-social a {
    width: 22px;
    height: 22px;
    display: inline-grid;
    place-items: center;
    color: #a4adbe;
    text-decoration: none;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .site-footer-social a:hover {
    color: #ffffff;
    transform: translateY(-1px);
  }

  .site-footer-social svg {
    width: 18px;
    height: 18px;
    display: block;
    fill: currentColor;
  }

  .site-footer-copy {
    margin: 52px 0 0;
    color: #8d95a6;
    font-size: 16px;
  }

  @media (max-width: 1100px) {
    .site-shell-header,
    .site-footer-inner {
      width: min(1480px, calc(100% - 32px));
    }

    .site-shell-logo-full {
      height: 27px;
    }

    .site-shell-nav {
      gap: 14px;
    }

    .locale-switcher-btn {
      padding: 8px 7px 9px;
    }
  }

  /* Hamburger button */
  .site-shell-menu-btn {
    display: none;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    background: transparent;
    border: 1px solid var(--shell-border);
    border-radius: 8px;
    color: var(--shell-muted);
    cursor: pointer;
    flex-shrink: 0;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .site-shell-menu-btn:hover {
    color: var(--shell-text);
    border-color: var(--shell-muted);
  }

  .site-shell-menu-btn svg {
    width: 18px;
    height: 18px;
    display: block;
  }

  .site-shell-menu-btn .menu-icon-close {
    display: none;
  }

  .site-shell-menu-btn[aria-expanded='true'] .menu-icon-open {
    display: none;
  }

  .site-shell-menu-btn[aria-expanded='true'] .menu-icon-close {
    display: block;
  }

  .site-shell-menu-btn[aria-expanded='true'] {
    color: var(--shell-text);
    border-color: var(--shell-muted);
  }

  /* Mobile nav panel */
  .site-shell-mobile-nav {
    display: none;
    position: fixed;
    top: calc(var(--shell-header-h) + 5px); /* 5px = top stripe */
    left: 0;
    right: 0;
    z-index: 60;
    background: var(--shell-surface);
    border-bottom: 1px solid var(--shell-border);
    box-shadow: 0 16px 40px rgba(2, 6, 18, 0.38);
    padding: 20px calc((100% - min(1360px, calc(100% - 48px))) / 2 + 24px);
    animation: mobileNavIn 180ms ease both;
  }

  @keyframes mobileNavIn {
    from { opacity: 0; transform: translateY(-8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .site-shell-mobile-nav.is-open {
    display: block;
  }

  .mobile-nav-links {
    display: flex;
    flex-direction: column;
    gap: 2px;
    border-bottom: 1px solid var(--shell-border);
    padding-bottom: 16px;
    margin-bottom: 16px;
