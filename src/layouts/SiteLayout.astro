---
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
  title: string;
  lang?: string;
  activeNav?: 'home' | 'arch' | 'docs' | '';
}

const { title, lang = 'en', activeNav = '' } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <slot name="head" />
    <script is:inline>
      (function () {
        var theme = localStorage.getItem('ls-theme');
        if (theme === 'light') {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>
  <body>
    <div class="site-shell-top-stripe"></div>
    <SiteHeader activeNav={activeNav} />
    <slot />

    <footer class="site-footer" aria-label="Site footer">
      <div class="site-footer-inner">
        <div class="site-footer-main">
          <div class="site-footer-grid">
            <section class="site-footer-col" aria-label="Enlaces rápidos y documentación">
              <h4>Enlaces rápidos / Docs</h4>
              <a class="site-footer-link" href="https://www.lamassu.io/docs/" target="_blank" rel="noopener">Guía de inicio rápido →</a>
              <a class="site-footer-link" href="/arch/">Arquitectura del sistema →</a>
              <a class="site-footer-link" href="https://www.lamassu.io/docs/" target="_blank" rel="noopener">Referencia de API →</a>
              <a class="site-footer-link" href="https://www.lamassu.io/docs/" target="_blank" rel="noopener">Gestión de CAs →</a>
              <a class="site-footer-link" href="https://www.lamassu.io/docs/" target="_blank" rel="noopener">Enrollment EST →</a>
              <a class="site-footer-link" href="https://www.lamassu.io/docs/" target="_blank" rel="noopener">SDK de Go →</a>
            </section>

            <section class="site-footer-col" aria-label="Comunidad y soporte">
              <h4>Comunidad y soporte</h4>
              <p class="site-footer-note">
                Documentación, soporte técnico y colaboración abierta para desplegar Lamassu IoT en producción.
              </p>
              <a class="site-footer-link" href="https://www.lamassu.io/docs/" target="_blank" rel="noopener">Documentación: https://www.lamassu.io/docs/</a>
              <a class="site-footer-link" href="https://github.com/lamassuiot/lamassuiot/issues" target="_blank" rel="noopener">GitHub Issues: https://github.com/lamassuiot/lamassuiot/issues</a>
              <a class="site-footer-link" href="https://github.com/lamassuiot/lamassuiot/discussions" target="_blank" rel="noopener">GitHub Discussions: https://github.com/lamassuiot/lamassuiot/discussions</a>
            </section>
          </div>
        </div>

        <p class="site-footer-copy">
          Licensed under Mozilla Public License 2.0
          <a class="site-footer-copy-link" href="https://github.com/lamassuiot/lamassuiot" target="_blank" rel="noopener">
            GitHub link: https://github.com/lamassuiot/lamassuiot
          </a>
        </p>
      </div>
    </footer>
    <script is:inline>
      (function () {
        var body = document.body;
        var header = document.querySelector('.site-shell-header');
        if (!body || !header) return;

        var overview = document.getElementById('overview');

        function shouldStick() {
          if (window.innerWidth <= 940) return false;

          if (overview) {
            var headerHeight = header.getBoundingClientRect().height;
            return overview.getBoundingClientRect().top <= headerHeight + 6;
          }

          return window.scrollY > 180;
        }

        function syncStickyHeader() {
          body.classList.toggle('site-shell-header-sticky', shouldStick());
        }

        syncStickyHeader();
        window.addEventListener('scroll', syncStickyHeader, { passive: true });
        window.addEventListener('resize', syncStickyHeader);
      })();
    </script>
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    padding: 0;
    width: 100%;
    min-height: 100%;
  }

  :root {
    --shell-bg: #09111f;
    --shell-surface: #10192c;
    --shell-surface-alt: #15233a;
    --shell-border: #243550;
    --shell-text: #edf3ff;
    --shell-muted: #8fa1c3;
    --shell-accent: #7e9cff;
    --shell-accent-soft: rgba(137, 162, 255, 0.16);
    --shell-header-h: 82px;
  }

  [data-theme='light'] {
    --shell-bg: #f4f6fa;
    --shell-surface: #ffffff;
    --shell-surface-alt: #f8f9fc;
    --shell-border: #d9dfeb;
    --shell-text: #0f1728;
    --shell-muted: #55627f;
    --shell-accent: #3f63ff;
    --shell-accent-soft: rgba(63, 99, 255, 0.1);
  }

  body {
    background:
      radial-gradient(circle at 50% -15%, rgba(98, 124, 205, 0.18), transparent 45%),
      radial-gradient(circle at 85% 0%, rgba(47, 74, 136, 0.14), transparent 28%),
      var(--shell-bg);
    color: var(--shell-text);
    font-family: 'Space Grotesk', sans-serif;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    overflow-x: hidden;
  }

  .site-shell-top-stripe {
    height: 5px;
    width: 100%;
    background: linear-gradient(90deg, #2a49f8 0%, #4c7fff 52%, #35b9ff 100%);
  }

  .site-shell-header {
    height: var(--shell-header-h);
    width: min(1360px, calc(100% - 48px));
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .site-shell-brand {
    display: inline-flex;
    align-items: center;
    gap: 0;
    text-decoration: none;
    flex-shrink: 0;
  }

  .site-shell-logo-full {
    height: 30px;
    width: auto;
    display: block;
  }

  .site-shell-logo-full.logo-light {
    display: none;
  }

  [data-theme='light'] .site-shell-logo-full.logo-dark {
    display: none;
  }

  [data-theme='light'] .site-shell-logo-full.logo-light {
    display: block;
  }

  .site-shell-nav {
    display: inline-flex;
    align-items: center;
    gap: 18px;
  }

  .site-shell-nav a {
    color: var(--shell-muted);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    transition: color 0.15s ease;
  }

  .site-shell-nav a:hover,
  .site-shell-nav a.is-active {
    color: var(--shell-text);
  }

  .site-shell-nav a.github-link {
    display: inline-grid;
    place-items: center;
    line-height: 0;
  }

  .site-shell-nav a.github-link svg {
    width: 17px;
    height: 17px;
    display: block;
    fill: currentColor;
  }

  .site-shell-cta-group {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .theme-toggle {
    width: 34px;
    height: 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid var(--shell-border);
    border-radius: 8px;
    color: var(--shell-muted);
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease;
    padding: 0;
  }

  .theme-toggle:hover {
    color: var(--shell-text);
    border-color: var(--shell-muted);
  }

  .theme-toggle .icon-moon {
    display: none;
  }

  .theme-toggle .icon-sun {
    display: block;
  }

  [data-theme='light'] .theme-toggle .icon-moon {
    display: block;
  }

  [data-theme='light'] .theme-toggle .icon-sun {
    display: none;
  }

  .theme-toggle svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    display: block;
  }

  .site-shell-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 38px;
    box-sizing: border-box;
    border: 1px solid var(--shell-border);
    background: var(--shell-surface);
    color: var(--shell-text);
    border-radius: 8px;
    text-decoration: none;
    padding: 9px 13px;
    font-size: 14px;
    line-height: 1;
    font-weight: 600;
    transition: border-color 0.15s ease, background-color 0.15s ease;
    white-space: nowrap;
  }

  .site-shell-cta:hover {
    border-color: var(--shell-muted);
  }

  .site-shell-cta-login {
    background: var(--shell-accent);
    color: #0b1122;
    border-color: transparent;
  }

  .site-shell-cta-login:hover {
    background: #96b0ff;
    border-color: transparent;
  }

  @keyframes siteShellStickyIn {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes siteShellStickyLinkIn {
    from {
      opacity: 0;
      transform: translateY(-3px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (min-width: 941px) {
    body.site-shell-header-sticky .site-shell-header {
      position: fixed;
      top: 8px;
      left: 50%;
      transform: translateX(-50%);
      width: auto;
      height: auto;
      margin: 0;
      justify-content: center;
      gap: 0;
      z-index: 70;
    }

    body.site-shell-header-sticky .site-shell-brand,
    body.site-shell-header-sticky .site-shell-cta-group {
      display: none;
    }

    body.site-shell-header-sticky .site-shell-nav {
      gap: 16px;
      padding: 11px 18px;
      border: 1px solid rgba(63, 80, 119, 0.72);
      border-radius: 14px;
      background: rgba(9, 15, 28, 0.88);
      box-shadow: 0 12px 30px rgba(2, 6, 16, 0.34);
      backdrop-filter: blur(8px);
      animation: siteShellStickyIn 230ms ease both;
    }

    [data-theme='light'] body.site-shell-header-sticky .site-shell-nav {
      border-color: rgba(197, 207, 227, 0.92);
      background: rgba(255, 255, 255, 0.94);
      box-shadow: 0 10px 26px rgba(13, 26, 51, 0.14);
    }

    body.site-shell-header-sticky .site-shell-nav a {
      opacity: 0;
      transform: translateY(-3px);
      animation: siteShellStickyLinkIn 180ms ease forwards;
    }

    body.site-shell-header-sticky .site-shell-nav a:nth-child(1) { animation-delay: 30ms; }
    body.site-shell-header-sticky .site-shell-nav a:nth-child(2) { animation-delay: 55ms; }
    body.site-shell-header-sticky .site-shell-nav a:nth-child(3) { animation-delay: 80ms; }
    body.site-shell-header-sticky .site-shell-nav a:nth-child(4) { animation-delay: 105ms; }
    body.site-shell-header-sticky .site-shell-nav a:nth-child(5) { animation-delay: 130ms; }
    body.site-shell-header-sticky .site-shell-nav a:nth-child(6) { animation-delay: 155ms; }
    body.site-shell-header-sticky .site-shell-nav a:nth-child(7) { animation-delay: 180ms; }

    @media (prefers-reduced-motion: reduce) {
      body.site-shell-header-sticky .site-shell-nav,
      body.site-shell-header-sticky .site-shell-nav a {
        animation: none;
      }

      body.site-shell-header-sticky .site-shell-nav a {
        opacity: 1;
        transform: none;
      }
    }
  }

  .site-footer {
    margin-top: 84px;
    border-top: 1px solid rgba(143, 172, 246, 0.14);
    background:
      radial-gradient(circle at 18% 22%, rgba(34, 74, 164, 0.14), transparent 48%),
      radial-gradient(circle at 86% 12%, rgba(68, 115, 255, 0.1), transparent 45%),
      #060914;
  }

  .site-footer-inner {
    width: min(1480px, calc(100% - 56px));
    margin: 0 auto;
    padding: 54px 0 48px;
  }

  .site-footer-main {
    display: grid;
    grid-template-columns: 1fr;
    gap: 34px;
    align-items: start;
  }

  .site-footer-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 54px;
    width: min(920px, 100%);
  }

  .site-footer-col {
    display: grid;
    align-content: start;
    gap: 10px;
  }

  .site-footer-col h4 {
    margin: 0 0 6px;
    color: #e2e6ef;
    font-size: 16px;
    font-weight: 700;
  }

  .site-footer-note {
    margin: 0;
    color: #a4adbe;
    font-size: 16px;
    line-height: 1.6;
    max-width: 56ch;
  }

  .site-footer-link {
    color: #a4adbe;
    text-decoration: none;
    font-size: 16px;
    line-height: 1.5;
    transition: color 0.2s;
  }

  .site-footer-link:hover {
    color: #ffffff;
  }

  .site-footer-copy {
    margin: 78px 0 0;
    color: #8d95a6;
    font-size: 16px;
  }

  .site-footer-copy-link {
    color: inherit;
    text-decoration: none;
    margin-left: 14px;
    transition: color 0.2s ease;
  }

  .site-footer-copy-link:hover {
    color: #ffffff;
  }

  @media (max-width: 1100px) {
    .site-shell-header,
    .site-footer-inner {
      width: min(1480px, calc(100% - 32px));
    }

    .site-shell-logo-full {
      height: 27px;
    }

    .site-shell-nav {
      gap: 14px;
    }
  }

  @media (max-width: 940px) {
    .site-shell-header {
      height: 72px;
    }

    .site-shell-nav {
      display: none;
    }

    .site-footer-inner {
      padding-top: 40px;
    }

    .site-footer-grid {
      width: 100%;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 26px;
    }

    .site-footer-copy {
      margin-top: 42px;
    }
  }

  @media (max-width: 640px) {
    .site-shell-header {
      width: calc(100% - 20px);
      gap: 8px;
    }

    .site-shell-logo-full {
      height: 21px;
    }

    .site-shell-cta-group {
      gap: 6px;
    }

    .site-shell-cta {
      min-height: 34px;
      padding: 8px 10px;
      font-size: 12px;
    }

    .site-footer {
      margin-top: 56px;
    }

    .site-footer-inner {
      width: calc(100% - 22px);
      padding-top: 30px;
      padding-bottom: 34px;
    }

    .site-footer-copy {
      margin-top: 34px;
      font-size: 14px;
    }

    .site-footer-link {
      font-size: 14px;
    }

    .site-footer-note {
      font-size: 14px;
    }

    .site-footer-grid {
      grid-template-columns: 1fr;
      gap: 22px;
    }

    .site-footer-copy-link {
      display: block;
      margin-top: 8px;
      margin-left: 0;
    }
  }
</style>
