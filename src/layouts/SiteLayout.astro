---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { localeOptions, sharedTranslations } from '../lib/i18n';

interface Props {
  title: string;
  lang?: string;
  activeNav?: 'home' | 'arch' | 'docs' | '';
  pageTranslations?: Record<string, unknown>;
}

const { title, lang = 'es', activeNav = '', pageTranslations = {} } = Astro.props;
---

<!doctype html>
<html lang={lang} id="page-top">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#17130f" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#faf5ef" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <slot name="head" />
    <script is:inline>
      (function () {
        var theme = localStorage.getItem('ls-theme');
        if (theme === 'light') {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>
  <body>
    <div class="site-shell-top-stripe"></div>
    <SiteHeader activeNav={activeNav} />
    <slot />

    <SiteFooter />
    <script
      id="page-translations"
      type="application/json"
      set:html={JSON.stringify(pageTranslations)}
    ></script>
    <script is:inline>
      (function () {
        var body = document.body;
        var header = document.querySelector('.site-shell-header');
        if (!body || !header) return;

        var overview = document.getElementById('overview');

        function shouldStick() {
          if (window.innerWidth <= 1240) return false;

          if (overview) {
            var headerHeight = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--shell-header-h')) || header.getBoundingClientRect().height;
            return overview.getBoundingClientRect().top <= headerHeight + 6;
          }

          return window.scrollY > 180;
        }

        function syncStickyHeader() {
          body.classList.toggle('site-shell-header-sticky', shouldStick());
        }

        syncStickyHeader();
        window.addEventListener('scroll', syncStickyHeader, { passive: true });
        window.addEventListener('resize', syncStickyHeader);
      })();
    </script>
    <script is:inline define:vars={{ localeOptions, sharedTranslations, title }}>
      (function () {
        var STORAGE_KEY = 'lamassu-locale';
        var pageTranslationsElement = document.getElementById('page-translations');
        var pageTranslations = {};

        if (pageTranslationsElement && pageTranslationsElement.textContent) {
          try {
            pageTranslations = JSON.parse(pageTranslationsElement.textContent);
          } catch (error) {
            pageTranslations = {};
          }
        }

        function getLocaleConfig(locale) {
          return localeOptions.find(function (option) { return option.code === locale; });
        }

        function getDictionary(locale) {
          return Object.assign({}, sharedTranslations[locale] || {}, pageTranslations[locale] || {});
        }

        function resolveKey(source, key) {
          return key.split('.').reduce(function (acc, part) {
            if (acc == null) return undefined;
            return acc[part];
          }, source);
        }

        function applyAttributes(locale, dictionary) {
          document.querySelectorAll('*').forEach(function (element) {
            Array.prototype.forEach.call(element.attributes, function (attribute) {
              if (!attribute.name.startsWith('data-i18n-attr-')) return;
              var targetAttribute = attribute.name.replace('data-i18n-attr-', '');
              var value = resolveKey(dictionary, attribute.value);
              if (typeof value === 'string') {
                element.setAttribute(targetAttribute, value);
              }
            });
          });
        }

        function applyLocale(locale) {
          var dictionary = getDictionary(locale);
          var localeConfig = getLocaleConfig(locale) || getLocaleConfig('es');

          document.documentElement.lang = localeConfig ? localeConfig.htmlLang : 'es';
          localStorage.setItem(STORAGE_KEY, locale);

          document.querySelectorAll('[data-i18n]').forEach(function (element) {
            var key = element.getAttribute('data-i18n');
            var value = key ? resolveKey(dictionary, key) : undefined;
            if (typeof value === 'string') {
              element.textContent = value;
            }
          });

          document.querySelectorAll('[data-i18n-html]').forEach(function (element) {
            var key = element.getAttribute('data-i18n-html');
            var value = key ? resolveKey(dictionary, key) : undefined;
            if (typeof value === 'string') {
              element.innerHTML = value;
            }
          });

          applyAttributes(locale, dictionary);

          var translatedTitle = resolveKey(dictionary, 'meta.title');
          document.title = typeof translatedTitle === 'string' ? translatedTitle : title;

          document.querySelectorAll('[data-locale-option]').forEach(function (button) {
            var isActive = button.getAttribute('data-locale-option') === locale;
            button.classList.toggle('is-active', isActive);
            button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
          });
        }

        var selectedLocale = localStorage.getItem(STORAGE_KEY);
        var supported = localeOptions.map(function (option) { return option.code; });
        applyLocale(supported.indexOf(selectedLocale) >= 0 ? selectedLocale : 'es');

        document.querySelectorAll('[data-locale-option]').forEach(function (button) {
          button.addEventListener('click', function () {
            var locale = button.getAttribute('data-locale-option');
            if (!locale) return;
            applyLocale(locale);
          });
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    padding: 0;
    width: 100%;
    min-height: 100%;
  }

  :root {
    --shell-bg: #17130f;
    --shell-surface: #211a15;
    --shell-surface-alt: #2b211a;
    --shell-border: #49372b;
    --shell-text: #fff5ec;
    --shell-muted: #b39884;
    --shell-accent: #ff9b4a;
    --shell-accent-soft: rgba(255, 155, 74, 0.16);
    --shell-header-h: 82px;
  }

  [data-theme='light'] {
    --shell-bg: #faf5ef;
    --shell-surface: #ffffff;
    --shell-surface-alt: #fffaf5;
    --shell-border: #e8d8c8;
    --shell-text: #2b1b12;
    --shell-muted: #796554;
    --shell-accent: #b94d08;
    --shell-accent-soft: rgba(185, 77, 8, 0.1);
  }

  body {
    background:
      radial-gradient(circle at 50% -15%, rgba(198, 106, 40, 0.14), transparent 45%),
      radial-gradient(circle at 85% 0%, rgba(126, 65, 31, 0.1), transparent 28%),
      var(--shell-bg);
    color: var(--shell-text);
    font-family: 'Space Grotesk', sans-serif;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    overflow-x: hidden;
  }

  .site-shell-top-stripe {
    height: 5px;
    width: 100%;
    background: linear-gradient(90deg, #a94206 0%, #e76b16 52%, #ffad5b 100%);
  }

  .site-shell-header {
    height: var(--shell-header-h);
    width: min(1360px, calc(100% - 48px));
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .site-shell-brand {
    display: inline-flex;
    align-items: center;
    gap: 0;
    text-decoration: none;
    flex-shrink: 0;
  }

  .site-shell-header-spacer {
    display: none;
  }

  .site-shell-logo-full {
    height: 30px;
    width: auto;
    display: block;
  }

  .site-shell-logo-full.logo-light {
    display: none;
  }

  [data-theme='light'] .site-shell-logo-full.logo-dark {
    display: none;
  }

  [data-theme='light'] .site-shell-logo-full.logo-light {
    display: block;
  }

  .site-shell-nav {
    display: inline-flex;
    align-items: center;
    gap: 18px;
  }

  .site-shell-nav a {
    color: var(--shell-muted);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    transition: color 0.15s ease;
  }

  .site-shell-nav a:hover,
  .site-shell-nav a.is-active {
    color: var(--shell-text);
  }

  .site-shell-nav a.github-link {
    display: inline-grid;
    place-items: center;
    line-height: 0;
  }

  .site-shell-nav a.github-link svg {
    width: 17px;
    height: 17px;
    display: block;
    fill: currentColor;
  }

  .site-shell-cta-group {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .locale-switcher {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 0 2px;
    border-bottom: 1px solid rgba(192, 132, 86, 0.18);
  }

  [data-theme='light'] .locale-switcher {
    border-bottom-color: rgba(107, 76, 57, 0.18);
  }

  .locale-switcher-btn {
    border: 0;
    background: transparent;
    color: var(--shell-muted);
    border-radius: 0;
    min-width: auto;
    padding: 8px 8px 10px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition:
      color 0.18s ease,
      opacity 0.18s ease;
    position: relative;
    opacity: 0.72;
  }

  .locale-switcher-btn:hover {
    color: var(--shell-text);
    opacity: 1;
  }

  .locale-switcher-btn.is-active {
    color: var(--shell-text);
    opacity: 1;
  }

  .locale-switcher-btn::after {
    content: '';
    position: absolute;
    left: 8px;
    right: 8px;
    bottom: -1px;
    height: 2px;
    border-radius: 999px;
    background: linear-gradient(90deg, #e76b16 0%, #ffad5b 100%);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.18s ease;
  }

  .locale-switcher-btn.is-active::after {
    transform: scaleX(1);
  }

  .theme-toggle {
    width: 34px;
    height: 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid var(--shell-border);
    border-radius: 8px;
    color: var(--shell-muted);
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease;
    padding: 0;
  }

  .theme-toggle:hover {
    color: var(--shell-text);
    border-color: var(--shell-muted);
  }

  .theme-toggle .icon-moon {
    display: none;
  }

  .theme-toggle .icon-sun {
    display: block;
  }

  [data-theme='light'] .theme-toggle .icon-moon {
    display: block;
  }

  [data-theme='light'] .theme-toggle .icon-sun {
    display: none;
  }

  .theme-toggle svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    display: block;
  }

  .site-shell-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 38px;
    box-sizing: border-box;
    border: 1px solid var(--shell-border);
    background: var(--shell-surface);
    color: var(--shell-text);
    border-radius: 8px;
    text-decoration: none;
    padding: 9px 13px;
    font-size: 14px;
    line-height: 1;
    font-weight: 600;
    transition: border-color 0.15s ease, background-color 0.15s ease;
    white-space: nowrap;
  }

  .site-shell-cta:hover {
    border-color: var(--shell-muted);
  }

  .site-shell-cta-login {
    background: var(--shell-accent);
    color: #281406;
    border-color: transparent;
  }

  [data-theme='light'] .site-shell-cta-login {
    color: #ffffff;
  }

  .site-shell-cta-login:hover {
    background: #ffb36e;
    border-color: transparent;
  }

  [data-theme='light'] .site-shell-cta-login:hover {
    background: #9e3900;
  }

  @keyframes siteShellStickyIn {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes siteShellStickyLinkIn {
    from {
      opacity: 0;
      transform: translateY(-3px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (min-width: 1241px) {
    body.site-shell-header-sticky .site-shell-header {
      position: fixed;
      top: 8px;
      left: 50%;
      transform: translateX(-50%);
      width: max-content;
      max-width: calc(100% - 32px);
      height: 40px;
      box-sizing: border-box;
      margin: 0;
      padding: 4px 13px;
      justify-content: center;
      gap: 17px;
      z-index: 70;
      border: 1px solid rgba(106, 73, 51, 0.72);
      border-radius: 12px;
      background: rgba(32, 23, 18, 0.88);
      box-shadow: 0 12px 30px rgba(17, 11, 8, 0.34);
      backdrop-filter: blur(8px);
    }

    body.site-shell-header-sticky .site-shell-logo-full {
      height: 21px;
    }

    body.site-shell-header-sticky .site-shell-nav {
      gap: 14px;
      flex-shrink: 0;
    }

    body.site-shell-header-sticky .site-shell-cta-group {
      gap: 7px;
    }

    body.site-shell-header-sticky .locale-switcher {
      gap: 0;
      padding: 0;
    }

    body.site-shell-header-sticky .locale-switcher-btn {
      padding: 5px;
      font-size: 10.5px;
      line-height: 18px;
    }

    body.site-shell-header-sticky .locale-switcher-btn::after {
      left: 5px;
      right: 5px;
    }

    body.site-shell-header-sticky .theme-toggle {
      width: 30px;
      height: 30px;
      box-sizing: border-box;
      border-radius: 6px;
    }

    body.site-shell-header-sticky .theme-toggle svg {
      width: 15px;
      height: 15px;
    }

    body.site-shell-header-sticky .site-shell-cta {
      min-height: 30px;
      padding: 5px 10px;
      border-radius: 6px;
      font-size: 12.5px;
      line-height: 18px;
    }

    body.site-shell-header-sticky .site-shell-header-spacer {
      display: block;
      height: var(--shell-header-h);
    }

    [data-theme='light'] body.site-shell-header-sticky .site-shell-header {
      border-color: rgba(224, 207, 190, 0.92);
      background: rgba(255, 255, 255, 0.94);
      box-shadow: 0 10px 26px rgba(61, 39, 26, 0.14);
    }

    body.site-shell-header-sticky .site-shell-nav a {
      font-size: 13.5px;
      line-height: 19px;
      white-space: nowrap;
      opacity: 0;
      transform: translateY(-3px);
      animation: siteShellStickyLinkIn 180ms ease forwards;
    }

    body.site-shell-header-sticky .site-shell-nav a.github-link svg {
      width: 17px;
      height: 17px;
    }

    body.site-shell-header-sticky .site-shell-nav a:nth-child(1) { animation-delay: 30ms; }
    body.site-shell-header-sticky .site-shell-nav a:nth-child(2) { animation-delay: 55ms; }
    body.site-shell-header-sticky .site-shell-nav a:nth-child(3) { animation-delay: 80ms; }
    body.site-shell-header-sticky .site-shell-nav a:nth-child(4) { animation-delay: 105ms; }
    body.site-shell-header-sticky .site-shell-nav a:nth-child(5) { animation-delay: 130ms; }
    body.site-shell-header-sticky .site-shell-nav a:nth-child(6) { animation-delay: 155ms; }
    body.site-shell-header-sticky .site-shell-nav a:nth-child(7) { animation-delay: 180ms; }
    body.site-shell-header-sticky .site-shell-nav a:nth-child(8) { animation-delay: 205ms; }

    @media (prefers-reduced-motion: reduce) {
      body.site-shell-header-sticky .site-shell-nav,
      body.site-shell-header-sticky .site-shell-nav a {
        animation: none;
      }

      body.site-shell-header-sticky .site-shell-nav a {
        opacity: 1;
        transform: none;
      }
    }
  }

  @media (max-width: 1100px) {
    .site-shell-header {
      width: min(1480px, calc(100% - 32px));
    }

    .site-shell-logo-full {
      height: 27px;
    }

    .site-shell-nav {
      gap: 14px;
    }

    .locale-switcher-btn {
      padding: 8px 7px 9px;
    }
  }

  /* Hamburger button */
  .site-shell-menu-btn {
    display: none;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    background: transparent;
    border: 1px solid var(--shell-border);
    border-radius: 8px;
    color: var(--shell-muted);
    cursor: pointer;
    flex-shrink: 0;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .site-shell-menu-btn:hover {
    color: var(--shell-text);
    border-color: var(--shell-muted);
  }

  .site-shell-menu-btn svg {
    width: 18px;
    height: 18px;
    display: block;
  }

  .site-shell-menu-btn .menu-icon-close {
    display: none;
  }

  .site-shell-menu-btn[aria-expanded='true'] .menu-icon-open {
    display: none;
  }

  .site-shell-menu-btn[aria-expanded='true'] .menu-icon-close {
    display: block;
  }

  .site-shell-menu-btn[aria-expanded='true'] {
    color: var(--shell-text);
    border-color: var(--shell-muted);
  }

  /* Mobile nav panel */
  .site-shell-mobile-nav {
    display: none;
    position: fixed;
    top: calc(var(--shell-header-h) + 5px); /* 5px = top stripe */
    left: 0;
    right: 0;
    z-index: 60;
    background: var(--shell-surface);
    border-bottom: 1px solid var(--shell-border);
    box-shadow: 0 16px 40px rgba(17, 11, 8, 0.38);
    padding: 20px calc((100% - min(1360px, calc(100% - 48px))) / 2 + 24px);
    animation: mobileNavIn 180ms ease both;
  }

  @keyframes mobileNavIn {
    from { opacity: 0; transform: translateY(-8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .site-shell-mobile-nav.is-open {
    display: block;
  }

  .mobile-nav-links {
    display: flex;
    flex-direction: column;
    gap: 2px;
    border-bottom: 1px solid var(--shell-border);
    padding-bottom: 16px;
    margin-bottom: 16px;
  }

  .mobile-nav-links a {
    color: var(--shell-muted);
    text-decoration: none;
    font-size: 16px;
    font-weight: 600;
    padding: 10px 0;
    border-bottom: 1px solid transparent;
    transition: color 0.15s ease;
  }

  .mobile-nav-links a:hover {
    color: var(--shell-text);
  }

  .mobile-nav-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    padding-bottom: 4px;
  }

  .mobile-nav-cta-talk,
  .mobile-nav-cta-login {
    flex: 1;
    min-width: 120px;
    justify-content: center;
  }

  /* Prevent body scroll when menu is open */
  body.mobile-nav-open {
    overflow: hidden;
  }

  /* Below 1240px the full nav no longer fits next to the controls: collapse it into the menu
     and keep a frosted header bar pinned to the top instead of the floating desktop pill. */
  @media (max-width: 1240px) {
    .site-shell-header {
      position: sticky;
      top: 0;
      z-index: 65;
      isolation: isolate;
    }

    .site-shell-header::before {
      content: '';
      position: absolute;
      inset: 0 calc(50% - 50vw);
      z-index: -1;
      background: color-mix(in srgb, var(--shell-bg) 86%, transparent);
      border-bottom: 1px solid color-mix(in srgb, var(--shell-border) 70%, transparent);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }

    .site-shell-nav {
      display: none;
    }

    .site-shell-menu-btn {
      display: inline-flex;
    }
  }

  @media (max-width: 940px) {
    .site-shell-header {
      height: 72px;
    }

    .site-shell-mobile-nav {
      top: calc(72px + 5px);
      padding-left: calc((100% - min(1360px, calc(100% - 28px))) / 2 + 14px);
      padding-right: calc((100% - min(1360px, calc(100% - 28px))) / 2 + 14px);
    }




  }

  @media (max-width: 640px) {
    .site-shell-header {
      width: calc(100% - 20px);
      gap: 6px;
    }

    .site-shell-logo-full {
      height: 22px;
    }

    .site-shell-cta-group {
      gap: 5px;
    }

    /* Hide "Habla con expertos" — visible in the mobile menu instead */
    .site-shell-cta-talk {
      display: none;
    }

    /* "Log in" is also in the mobile menu; hiding it here keeps the bar within 390px */
    .site-shell-header .site-shell-cta-login {
      display: none;
    }

    .locale-switcher {
      gap: 0;
      padding: 0 1px;
    }

    .locale-switcher-btn {
      font-size: 10px;
      padding: 7px 6px 9px;
    }

    .site-shell-cta {
      min-height: 34px;
      padding: 8px 10px;
      font-size: 13px;
    }

    .site-shell-mobile-nav {
      top: calc(72px + 5px);
      padding: 16px 10px;
    }






  }
</style>
