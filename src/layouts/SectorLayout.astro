---
import SiteLayout from './SiteLayout.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<SiteLayout title={title} lang="es" activeNav="home">
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      body {
        background:
          radial-gradient(circle at 50% -14%, rgba(201, 117, 57, 0.2), transparent 46%),
          radial-gradient(circle at 84% 0%, rgba(137, 73, 38, 0.12), transparent 30%),
          #17130f;
        color: #f1e2d4;
        font-family: 'Manrope', sans-serif;
      }

      [data-theme='light'] body {
        background: #faf5ef;
        color: #2b1b12;
      }
    </style>
  </Fragment>
  <slot />
</SiteLayout>
